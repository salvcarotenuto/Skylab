@page
@model SkyLab.Web.Pages.Magazzino.ArticoloModel
@{ViewData["Title"]=Model.IsNew?"Nuovo articolo":"Scheda articolo";var supplierLookup=new SkyLab.Web.Models.PartyLookupModel("F",Model.Fornitori.Select(x=>new SkyLab.Web.Models.PartyLookupItem(x.Code,x.Name,x.City,x.Province)).ToList());}
<link rel="stylesheet" href="~/css/article-photos.css" asp-append-version="true" />
<section class="module-page form-module-page data-form-skin article-form-page @(Model.IsReadOnly?"is-readonly":"")" data-article-readonly="@(Model.IsReadOnly?"true":"false")">
 <header class="module-header customer-form-header"><div class="module-title-identity"><a class="skylab-header-brand" asp-page="/Magazzino/Articoli/Index"><img src="~/images/skylab-logo.png" alt="SkyLab" /></a><div><p class="eyebrow">Magazzino · Anagrafica articoli</p><h1>@(Model.IsNew?"Nuovo articolo":Model.Articolo.Description)</h1><p>@(Model.IsNew?"Inserimento di una nuova anagrafica":$"Codice {Model.Articolo.Code}")</p></div></div><div class="customer-form-toolbar">@if(!Model.IsReadOnly){<button class="btn btn-primary" type="submit" form="article-save-all-form">Salva</button>}@if(Model.IsModal&&Model.ClienteId>0){<a class="btn customer-menu-button" asp-page="/Clienti/Operativo" asp-route-id="@Model.ClienteId">Esci</a>}else{<a class="btn customer-menu-button" asp-page="/Magazzino/Articoli/Index">Esci</a>}</div></header>
 <nav class="article-tabs" aria-label="Sezioni articolo"><a class="@(Model.ActiveTab=="anagrafica"?"active":"")" asp-page="/Magazzino/Articolo" asp-route-codice="@(Model.IsNew?null:Model.Articolo.Code)" asp-route-azione="@Model.Azione" asp-route-clienteId="@(Model.ClienteId>0?Model.ClienteId:null)">Anagrafica</a>@if(Model.IsNew){<span class="disabled" title="Salvare prima l'articolo">Barcode</span><span class="disabled">Listini</span><span class="disabled">Immagini</span>}else{<a class="@(Model.ActiveTab=="barcode"?"active":"")" asp-page="/Magazzino/Articolo" asp-route-codice="@Model.Articolo.Code" asp-route-tab="barcode" asp-route-azione="@Model.Azione" asp-route-clienteId="@(Model.ClienteId>0?Model.ClienteId:null)">Barcode</a><a class="@(Model.ActiveTab=="listini"?"active":"")" asp-page="/Magazzino/Articolo" asp-route-codice="@Model.Articolo.Code" asp-route-tab="listini" asp-route-azione="@Model.Azione" asp-route-clienteId="@(Model.ClienteId>0?Model.ClienteId:null)">Listini</a><a class="@(Model.ActiveTab=="immagini"?"active":"")" asp-page="/Magazzino/Articolo" asp-route-codice="@Model.Articolo.Code" asp-route-tab="immagini" asp-route-azione="@Model.Azione" asp-route-clienteId="@(Model.ClienteId>0?Model.ClienteId:null)">Immagini</a>}</nav>
 <form id="article-save-all-form" method="post" asp-page-handler="SaveAll"><input type="hidden" name="tab" value="@Model.ActiveTab"/></form>
 <form id="article-form" method="post" class="article-form-panel entity-form @(Model.ActiveTab=="anagrafica"?"":"article-tab-hidden")" autocomplete="off" data-form-type="other" data-enter-navigation>
  <input asp-for="IsNew" type="hidden"/><input asp-for="Azione" type="hidden"/><div asp-validation-summary="All" class="validation-summary text-danger"></div>
  <fieldset class="form-frame compact-frame article-form-frame"><legend>Identificazione</legend><div class="article-fields-grid">
   <div class="field article-code-field"><label asp-for="Articolo.Code">Codice</label><input asp-for="Articolo.Code" readonly="@(!Model.IsNew)" class="text-uppercase" data-article-code/><span asp-validation-for="Articolo.Code"></span></div>
   <div class="field article-description-field"><label asp-for="Articolo.Description">Descrizione</label><input asp-for="Articolo.Description" data-article-description/><span asp-validation-for="Articolo.Description"></span></div>
   <div class="field"><label asp-for="Articolo.CategoryCode">Categoria</label><select asp-for="Articolo.CategoryCode"><option value="0"></option>@foreach(var x in Model.Categorie){<option value="@x.Id">@x.Label</option>}</select></div>
   <div class="field"><label asp-for="Articolo.GroupCode">Gruppo</label><select asp-for="Articolo.GroupCode"><option value="0"></option>@foreach(var x in Model.Gruppi){<option value="@x.Id">@x.Label</option>}</select></div>
   <div class="field"><label asp-for="Articolo.BrandCode">Marca</label><select asp-for="Articolo.BrandCode"><option value="0"></option>@foreach(var x in Model.Marche){<option value="@x.Id">@x.Label</option>}</select></div>
   <div class="field"><label asp-for="Articolo.PurchaseUnit">U. mis. acquisti</label><select asp-for="Articolo.PurchaseUnit"><option value=""></option>@foreach(var x in Model.UnitaMisura){<option value="@x.Code">@x.Code · @x.Label</option>}</select></div><div class="field"><label asp-for="Articolo.WorkUnit">U. mis. lavorazione</label><select asp-for="Articolo.WorkUnit"><option value=""></option>@foreach(var x in Model.UnitaMisura){<option value="@x.Code">@x.Code · @x.Label</option>}</select></div><div class="field"><label asp-for="Articolo.SalesUnit">U. mis. vendite</label><select asp-for="Articolo.SalesUnit"><option value=""></option>@foreach(var x in Model.UnitaMisura){<option value="@x.Code">@x.Code · @x.Label</option>}</select></div>
   <div class="field article-number-field"><label asp-for="Articolo.Weight">Peso confezione</label><input asp-for="Articolo.Weight" inputmode="decimal"/></div><div class="field article-number-field"><label asp-for="Articolo.Pieces">Pezzi confezione</label><input asp-for="Articolo.Pieces" type="text" min="0" max="32767" step="1" data-updown/></div><div class="field article-number-field"><label asp-for="Articolo.DurationDays">Durata ciclo gg.</label><input asp-for="Articolo.DurationDays" type="text" min="0" max="32767" step="1" data-updown/></div>
   <div class="field article-number-field"><label asp-for="Articolo.DailyConsumption">Consumo giornaliero</label><input asp-for="Articolo.DailyConsumption" inputmode="decimal"/></div><div class="field article-number-field"><label asp-for="Articolo.Cost">Costo standard</label><input asp-for="Articolo.Cost" asp-format="{0:N3}" inputmode="decimal" data-decimal-field data-decimal-digits="3" data-decimal-integer-digits="9" data-decimal-zero="fixed"/></div><div class="field article-number-field"><label asp-for="Articolo.Price">Prezzo standard</label><input asp-for="Articolo.Price" asp-format="{0:N3}" inputmode="decimal" data-decimal-field data-decimal-digits="3" data-decimal-integer-digits="9" data-decimal-zero="fixed"/></div>
   <div class="field article-number-field"><label asp-for="Articolo.Stock">Giacenza</label><input asp-for="Articolo.Stock" inputmode="decimal"/></div><div class="field article-number-field"><label asp-for="Articolo.MinimumStock">Scorta minima</label><input asp-for="Articolo.MinimumStock" inputmode="decimal"/></div><div class="field article-number-field"><label asp-for="Articolo.MaximumStock">Scorta massima</label><input asp-for="Articolo.MaximumStock" inputmode="decimal"/></div>
   <div class="field"><label asp-for="Articolo.Location">Ubicazione</label><input asp-for="Articolo.Location"/></div><div class="field"><label asp-for="Articolo.VatCode">Codice IVA</label><select asp-for="Articolo.VatCode"><option value=""></option>@foreach(var x in Model.CodiciIva){<option value="@x.Code">@x.Code · @x.Label</option>}</select></div>
   <div class="article-supplier-row"><div class="article-supplier-party"><label for="article-supplier-code">Fornitore</label><input id="article-supplier-code" name="Articolo.SupplierCode" value="@(Model.Articolo.SupplierCode is > 0?Model.Articolo.SupplierCode.Value.ToString("00000"):"")" type="text" inputmode="numeric" maxlength="5" autocomplete="off" data-article-supplier-code/><input value="@Model.NomeFornitore" readonly tabindex="-1" aria-label="Nome fornitore" data-article-supplier-name/><button class="lookup-button" type="button" title="Seleziona fornitore" aria-label="Seleziona fornitore" data-party-lookup-open="F" data-party-lookup-target="article"></button></div><div class="article-supplier-article"><label for="Articolo_SupplierArticleCode">Articolo</label><input asp-for="Articolo.SupplierArticleCode"/></div></div>
   <div class="field article-notes-field"><label asp-for="Articolo.Notes">Note</label><textarea asp-for="Articolo.Notes"></textarea></div>
  </div></fieldset>
 </form>
 @if(Model.ActiveTab=="barcode"){
 <section class="article-child-panel article-barcode-panel" data-barcode-panel data-article-code="@Model.Articolo.Code" data-article-supplier="@Model.Articolo.SupplierCode" data-article-supplier-name="@Model.NomeFornitore">
  <div class="article-child-toolbar"><button class="btn btn-primary" type="button" data-barcode-new>Nuovo</button><button class="btn customer-menu-button" type="button" data-barcode-edit disabled>Modifica</button><button class="btn customer-menu-button" type="button" data-barcode-delete disabled>Elimina</button><span class="article-child-count">@Model.Barcodes.Count barcode</span></div>
  <div class="article-barcode-grid-frame"><table class="article-barcode-grid"><thead><tr><th>Barcode</th><th>Tipo</th><th>Fornitore</th><th>Stato</th></tr></thead><tbody>@foreach(var b in Model.Barcodes){var typeLabel=b.IsValidEan?"EAN-13":b.Type==0?"Code 128":"Non riconosciuto";var status=b.IsLegacy?"Legacy non conforme":"Valido";<tr tabindex="0" data-barcode-row data-id="@b.Id" data-value="@b.Value" data-supplier-code="@(b.SupplierCode?.ToString()??"")" data-supplier-name="@b.SupplierName"><td class="article-barcode-value">@b.Value</td><td>@typeLabel</td><td>@(b.SupplierCode.HasValue?$"{b.SupplierCode:00000} · {b.SupplierName}":"")</td><td><span class="barcode-status @(b.IsLegacy?"legacy":"valid")">@status</span></td></tr>}</tbody></table>@if(Model.Barcodes.Count==0){<div class="article-child-empty">Nessun barcode associato all'articolo.</div>}</div>
  <form method="post" asp-page-handler="SaveBarcode" class="article-barcode-editor" data-barcode-editor hidden><input type="hidden" name="codice" value="@Model.Articolo.Code"/><input type="hidden" name="barcodeId" value="0" data-barcode-id/><div class="field article-barcode-input-field"><label for="barcode-value">Barcode</label><input id="barcode-value" name="barcodeValue" maxlength="30" autocomplete="off" data-barcode-value/></div><div class="field article-barcode-type-field"><label for="barcode-decoded-type">Tipo</label><input id="barcode-decoded-type" readonly tabindex="-1" data-barcode-decoded-type/></div><div class="article-barcode-supplier-fields"><label for="barcode-supplier-code">Fornitore</label><input id="barcode-supplier-code" name="barcodeSupplierCode" type="text" inputmode="numeric" maxlength="5" autocomplete="off" data-barcode-supplier-code/><input readonly tabindex="-1" aria-label="Nome fornitore barcode" data-barcode-supplier-name/><button class="lookup-button" type="button" title="Seleziona fornitore" aria-label="Seleziona fornitore" data-party-lookup-open="F" data-party-lookup-target="barcode"></button></div><div class="article-barcode-editor-actions"><button class="btn btn-primary" type="submit">Salva</button><button class="btn customer-menu-button" type="button" data-barcode-cancel>Annulla</button></div></form>
  <form method="post" asp-page-handler="DeleteBarcode" data-barcode-delete-form hidden><input type="hidden" name="codice" value="@Model.Articolo.Code"/><input type="hidden" name="barcodeId" data-barcode-delete-id/></form>
 </section>}
 @if(!Model.IsNew){
 <section class="article-child-panel article-price-list-panel @(Model.ActiveTab=="listini"?"":"article-tab-hidden")" data-price-list-panel data-standard-cost="@Model.Articolo.Cost.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-vat-rate="@Model.VatRate.ToString(System.Globalization.CultureInfo.InvariantCulture)">
  <div class="article-price-list-summary"><div><span>Costo standard</span><strong>@Model.Articolo.Cost.ToString("N3")</strong></div><div><span>Codice IVA</span><strong>@(string.IsNullOrWhiteSpace(Model.Articolo.VatCode)?"Nessuno":$"{Model.Articolo.VatCode} · {Model.VatRate:N2}%")</strong></div><div><span>Prezzo standard</span><strong>@Model.Articolo.Price.ToString("N3")</strong></div></div>
  <form id="price-list-form" method="post" asp-page-handler="SavePriceLists" autocomplete="off"><input type="hidden" name="codice" value="@Model.Articolo.Code"/><div class="article-price-list-frame"><table class="article-price-list-table"><thead><tr><th>N.ro</th><th>Ricarico %</th><th>Prezzo calcolato</th><th>Imponibile</th><th>Prezzo ivato</th></tr></thead><tbody>@for(var i=0;i<Model.PriceLists.Count;i++){var row=Model.PriceLists[i];var calculated=decimal.Round(Model.Articolo.Cost*(1+row.Markup/100),3,MidpointRounding.AwayFromZero);var taxable=Model.VatRate==0?row.VatPrice:decimal.Round(row.VatPrice/(1+Model.VatRate/100),3,MidpointRounding.AwayFromZero);<tr data-price-list-row><td>@row.ListNumber</td><td><input name="PriceLists[@i].Markup" value="@(row.Markup==0?"":row.Markup.ToString("N2"))" inputmode="decimal" data-decimal-field data-decimal-digits="2" data-decimal-integer-digits="3" data-list-markup/></td><td><input value="@(calculated==0?"":calculated.ToString("N3"))" readonly tabindex="-1" data-list-calculated/></td><td><input value="@(taxable==0?"":taxable.ToString("N3"))" readonly tabindex="-1" data-list-taxable/></td><td><input name="PriceLists[@i].VatPrice" value="@(row.VatPrice==0?"":row.VatPrice.ToString("N3"))" inputmode="decimal" data-decimal-field data-decimal-digits="3" data-decimal-integer-digits="9" data-list-vat-price/></td></tr>}</tbody></table></div><p class="article-price-list-help">Inserire il prezzo finale IVA compresa. L’imponibile viene ricostruito automaticamente in base al Codice IVA dell’articolo.</p></form>
 </section>}
 @if(Model.ActiveTab=="immagini"){
 <section class="article-child-panel article-photo-panel">
  <header class="article-photo-head"><h2>Immagini dell'articolo (@Model.Photos.Count)</h2><button class="btn btn-primary" type="button" data-article-photo-add>Aggiungi immagine</button></header>
  <div class="article-photo-body"><div class="article-photo-preview" data-article-photo-preview>@if(Model.Photos.Count>0){<img src="@Model.Photos[0].Url" alt="@Model.Photos[0].Description"/>}else{<span>Nessuna immagine</span>}</div><div class="article-photo-list-frame"><table class="article-photo-table"><thead><tr><th>Nome file</th><th>Data</th><th>Ora</th><th>Descrizione</th><th></th></tr></thead><tbody>@for(var i=0;i<Model.Photos.Count;i++){var photo=Model.Photos[i];<tr class="@(i==0?"selected":"")" tabindex="0" data-article-photo-row data-photo-url="@photo.Url" data-photo-description="@photo.Description"><td title="@photo.FileName">@photo.FileName</td><td>@(photo.TakenOn?.ToString("dd/MM/yyyy")??"")</td><td>@(photo.TakenOn?.ToString("HH:mm")??"")</td><td>@photo.Description</td><td><button class="article-photo-delete" type="button" data-article-photo-delete data-photo-file="@photo.FileName">Elimina</button></td></tr>}</tbody></table>@if(Model.Photos.Count==0){<div class="article-child-empty">Nessuna immagine associata all'articolo.</div>}</div></div>
  <form method="post" asp-page-handler="DeletePhoto" data-article-photo-delete-form hidden><input type="hidden" name="codice" value="@Model.Articolo.Code"/><input type="hidden" name="fileName" data-article-photo-delete-file/></form>
 </section>
 <dialog class="work-photo-dialog" data-article-photo-dialog><form method="post" enctype="multipart/form-data" asp-page-handler="AddPhoto"><input name="codice" type="hidden" value="@Model.Articolo.Code"/><div class="work-photo-dialog-title">Aggiungi immagine</div><div class="work-photo-dialog-fields"><label><span>File</span><input name="foto" type="file" accept="image/jpeg,image/png,image/webp" required/></label><label><span>Descrizione</span><input name="descrizione" maxlength="255"/></label></div><div class="work-photo-dialog-actions"><button class="btn btn-primary" type="submit">Carica</button><button class="btn customer-menu-button" type="button" data-article-photo-cancel>Annulla</button></div></form></dialog>}
</section>
<partial name="_PartyLookup" model="supplierLookup" />
@if(!string.IsNullOrWhiteSpace(Model.BarcodeError??Model.ListError??Model.PhotoError)){<div class="messagebox-overlay messagebox-error active" data-skylab-messagebox aria-hidden="false"><div class="messagebox" role="alertdialog" aria-modal="true"><div class="messagebox-title">SkyLab - attenzione</div><div class="messagebox-body"><div class="messagebox-message">@(Model.BarcodeError??Model.ListError??Model.PhotoError)</div></div><div class="messagebox-actions"><button class="btn btn-primary messagebox-ok" type="button" onclick="this.closest('.messagebox-overlay').classList.remove('active')">OK</button></div></div></div>}
@section Scripts{<partial name="_ValidationScriptsPartial"/><script src="~/js/decimal-fields.js" asp-append-version="true"></script><script src="~/js/form-enter-navigation.js" asp-append-version="true"></script><script src="~/js/article-supplier-lookup.js" asp-append-version="true"></script><script src="~/js/article-barcodes.js" asp-append-version="true"></script><script src="~/js/article-price-lists.js" asp-append-version="true"></script><script src="~/js/article-photos.js" asp-append-version="true"></script><script src="~/js/article-save-all.js" asp-append-version="true"></script><script src="~/js/article-readonly.js" asp-append-version="true"></script>@if(!Model.IsReadOnly&&Model.ActiveTab=="anagrafica"&&Model.IsNew){<script>document.addEventListener("DOMContentLoaded",()=>document.querySelector("[data-article-code]")?.focus());</script>}else if(!Model.IsReadOnly&&Model.ActiveTab=="anagrafica"){<script>document.addEventListener("DOMContentLoaded",()=>document.querySelector("[data-article-description]")?.focus());</script>}}
