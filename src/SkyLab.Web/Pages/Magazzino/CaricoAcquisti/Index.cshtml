@page
@model SkyLab.Web.Pages.Magazzino.CaricoAcquisti.IndexModel
@using System.Globalization
@{
    ViewData["Title"] = "Carico per acquisti";
    ViewData["HideFooter"] = true;
    var culture = CultureInfo.GetCultureInfo("it-IT");
}
<link rel="stylesheet" href="~/css/purchase-load-list.css" asp-append-version="true" />

<section class="purchase-load-list-page" data-purchase-load-list>
    <header class="purchase-load-titlebar">
        <div class="purchase-load-heading">
            <img src="~/images/skylab-logo.png" alt="SkyLab" />
            <div><h1>Lista carico di magazzino</h1><p>SkyLab · Magazzino acquisti</p></div>
        </div>
        <div class="purchase-load-title-actions">
            <div class="purchase-load-count"><strong data-purchase-load-count>@Model.Documents.Count</strong> record</div>
            <a class="purchase-load-button primary" asp-page="Edit" asp-route-azione="2">Nuovo</a>
            <button type="button" class="purchase-load-button" data-purchase-load-action="edit">Modifica</button>
            <button type="button" class="purchase-load-button" data-purchase-load-action="delete">Cancella</button>
            <button type="button" class="purchase-load-button" data-purchase-load-action="print">Stampa</button>
            <button type="button" class="purchase-load-button invoice" data-purchase-load-action="invoice">Vedi fatt. el.</button>
            <a class="purchase-load-button" asp-page="/Index" data-purchase-load-exit>Esci</a>
        </div>
    </header>

    <form class="purchase-load-filters" onsubmit="return false;">
        <div class="purchase-load-filter first"><label for="load-year">Anno</label><select id="load-year" data-purchase-load-filter="year"><option value=""></option>@foreach (var year in Model.Documents.Select(item => item.Year).Distinct().OrderByDescending(year => year)) { <option value="@year" selected="@(year == Model.CurrentYear ? "selected" : null)">@year</option> }</select></div>
        <div class="purchase-load-filter"><label for="load-month">Mese</label><select id="load-month" data-purchase-load-filter="month"><option value="">Tutti</option>@for (var month = 1; month <= 12; month++) { <option value="@month">@culture.DateTimeFormat.GetMonthName(month)</option> }</select></div>
        <div class="purchase-load-filter supplier"><label for="load-supplier">Fornitore</label><select id="load-supplier" data-purchase-load-filter="supplier"><option value="">Tutti</option>@foreach (var supplier in Model.Documents.GroupBy(item => new { item.SupplierCode, item.SupplierName }).Select(group => group.Key).OrderBy(item => item.SupplierName)) { <option value="@supplier.SupplierCode">@supplier.SupplierName</option> }</select></div>
        <div class="purchase-load-filter"><label for="load-store">Un. locale</label><select id="load-store"><option>Tutti</option><option>Sede principale</option></select></div>
        <div class="purchase-load-filter article"><label for="load-article">Articolo</label><input id="load-article" placeholder="Codice" autocomplete="off" data-purchase-load-filter="article" /><input id="load-article-description" aria-label="Descrizione articolo" readonly tabindex="-1" /><button type="button" class="lookup-button purchase-load-search" title="Seleziona articolo" aria-label="Seleziona articolo" data-skylab-zoom="articoli" data-skylab-zoom-target-code="#load-article" data-skylab-zoom-target-description="#load-article-description"></button></div>
    </form>

    <div class="purchase-load-grids">
        <div class="purchase-load-grid-frame documents" tabindex="0">
            <table class="purchase-load-grid">
                <thead><tr><th data-sort-key="year" data-sort-type="number" aria-sort="none">Anno</th><th data-sort-key="batch" data-sort-type="number" aria-sort="none">Partita</th><th data-sort-key="number" aria-sort="none">Numero</th><th data-sort-key="date" data-sort-type="number" aria-sort="none">Data</th><th data-sort-key="supplierCode" data-sort-type="number" aria-sort="none">Fornitore</th><th data-sort-key="supplierName" aria-sort="none">Nome</th><th class="number" data-sort-key="goods" data-sort-type="number" aria-sort="none">Merce</th><th class="number" data-sort-key="vat" data-sort-type="number" aria-sort="none">IVA</th><th class="number" data-sort-key="total" data-sort-type="number" aria-sort="none">Totale</th><th data-sort-key="electronicInvoice" aria-sort="none">Fatt. elettronica</th></tr></thead>
                <tbody>
                @foreach (var item in Model.Documents)
                {
                    <tr data-purchase-load-row data-id="@item.Id" data-year="@item.Year" data-month="@item.Date?.Month" data-supplier="@($"{item.SupplierCode:00000} {item.SupplierName}")" data-article="@item.ArticleSearch" data-sort-year="@item.Year" data-sort-batch="@item.Batch" data-sort-number="@item.Number" data-sort-date="@(item.Date?.ToString("yyyyMMdd") ?? string.Empty)" data-sort-supplier-code="@item.SupplierCode" data-sort-supplier-name="@item.SupplierName" data-sort-goods="@item.Goods.ToString(CultureInfo.InvariantCulture)" data-sort-vat="@item.Vat.ToString(CultureInfo.InvariantCulture)" data-sort-total="@item.Total.ToString(CultureInfo.InvariantCulture)" data-sort-electronic-invoice="@item.ElectronicInvoice">
                        <td>@item.Year</td><td>@item.Batch.ToString("000000")</td><td>@item.Number</td><td>@(item.Date?.ToString("dd/MM/yyyy") ?? "")</td><td>@item.SupplierCode.ToString("00000")</td><td>@item.SupplierName</td><td class="number">@item.Goods.ToString("N2", culture)</td><td class="number">@item.Vat.ToString("N2", culture)</td><td class="number strong">@item.Total.ToString("N2", culture)</td><td>@item.ElectronicInvoice</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="purchase-load-grid-frame details">
            <table class="purchase-load-grid">
                <thead><tr><th>Articolo</th><th>Descrizione</th><th>U.m.</th><th class="number">Quantità</th><th class="number">Prezzo</th><th class="number">Sconto</th><th class="number">Importo</th><th class="number">Aliq. IVA</th></tr></thead>
                <tbody>@foreach (var line in Model.Details) { <tr data-purchase-load-detail data-document-id="@line.DocumentId"><td>@line.Article</td><td>@line.Description</td><td>@line.Unit</td><td class="number">@line.Quantity.ToString("N3", culture)</td><td class="number">@line.Price.ToString("N3", culture)</td><td class="number">@line.Discount.ToString("N2", culture)</td><td class="number">@line.Amount.ToString("N2", culture)</td><td class="number">@line.VatRate.ToString("N2", culture)%</td></tr> }</tbody>
            </table>
        </div>
    </div>
</section>

@section Scripts { <script src="~/js/purchase-load-preview.js" asp-append-version="true"></script> }
