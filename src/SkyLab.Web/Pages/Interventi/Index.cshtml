@page
@model SkyLab.Web.Pages.Interventi.IndexModel
@using SkyLab.Web.Models
@{
    ViewData["Title"] = "Agenda lavori";
    ViewData["HideFooter"] = true;
    string StatusLabel(InterventionStatus status) => status switch
    {
        InterventionStatus.Planned => "Pianificato",
        InterventionStatus.InProgress => "In corso",
        InterventionStatus.Completed => "Completato",
        _ => status.ToString()
    };
}
<link rel="stylesheet" href="~/css/agenda-period.css" asp-append-version="true" />
<section class="list-page agenda-list-page" data-agenda-list-page data-menu-url="/">
    <header class="list-titlebar">
        <a class="list-title-identity" asp-page="/Index"><strong>Agenda lavori</strong><small>Pianificazione e consultazione degli interventi</small></a>
        <div class="list-title-actions agenda-title-actions">
            <span class="list-records-box"><strong data-agenda-count>@Model.Items.Count</strong><span>record</span></span>
            <span class="agenda-selected-box"><strong data-agenda-selected-count>0</strong><span>selezionate</span></span>
            <button class="list-title-button agenda-print-button" type="button" data-agenda-print="sheets" disabled>Stampa schede</button>
            <button class="list-title-button agenda-print-button" type="button" data-agenda-print="summary" disabled>Stampa riepilogo</button>
            <button class="list-title-button agenda-dispatch-button" type="button" data-agenda-dispatch disabled>Conferma scarico</button>
            <a class="btn customer-menu-button" asp-page="/Index">Esci</a>
        </div>
    </header>
    <section class="list-panel">
        <div class="list-toolbar agenda-list-toolbar">
            <div class="list-filter-field agenda-period-field"><label for="agenda-period">Periodo</label><div class="agenda-period-control"><select id="agenda-period" data-agenda-period><option value="today">Oggi</option><option value="week">Settimana</option><option value="15days">15 giorni</option><option value="month">Mese</option><option value="custom">Periodo personalizzato…</option></select><input class="agenda-period-summary" type="text" value="@DateTime.Today.ToString("dd/MM/yyyy")" aria-label="Date del periodo" readonly tabindex="-1" data-agenda-period-summary /></div></div>
            <div class="list-filter-field agenda-search-field"><label for="agenda-search">Cerca</label><div class="list-search-control"><input id="agenda-search" type="text" placeholder="Cliente, sede, intervento o operatore" autocomplete="off" autofocus data-agenda-search/><button class="list-search-clear" type="button" aria-label="Pulisci filtro" data-agenda-search-clear hidden>×</button></div></div>
            <div class="list-filter-field"><label for="agenda-status">Stato</label><select id="agenda-status" data-agenda-status><option value="">Tutti</option>@foreach(var status in Enum.GetValues<InterventionStatus>()){<option value="@status">@StatusLabel(status)</option>}</select></div>
            <div class="list-filter-field"><label for="agenda-operator">Operatore</label><select id="agenda-operator" data-agenda-operator-filter><option value="">Tutti</option><option value="0">Da assegnare</option>@foreach(var item in Model.Operators){<option value="@item.Id">@item.Description</option>}</select></div>
        </div>
        <div class="list-grid-frame agenda-grid-frame" tabindex="0" data-agenda-grid>
            <table class="list-grid agenda-grid">
                <thead><tr><th class="agenda-check-column agenda-check-heading" title="Stampa"><span>Stampa</span><input type="checkbox" aria-label="Seleziona tutte le schede visibili per la stampa" data-agenda-check-all /></th><th class="agenda-check-column" title="Scarico">Scarico</th><th>Date scheda / lavoro</th><th>Cliente / sede</th><th>Intervento</th><th>Operatore</th><th>Stato</th><th></th></tr></thead>
                <tbody>@foreach(var item in Model.Items){var received=item.SheetFlow=="Da confermare";<tr class="@(item.DispatchedToWork?"agenda-row-dispatched":"")" tabindex="-1" data-agenda-row data-work-id="@item.Id" data-operator="@item.Plant" data-operator-id="@item.AssignedOperatorId" data-dispatched="@item.DispatchedToWork.ToString().ToLowerInvariant()" data-date="@item.ScheduledAt.ToString("yyyy-MM-dd")" data-status="@item.Status" data-flow="@item.SheetFlow" data-filter-text="@($"{item.Customer} {item.Site} {item.Kind} {item.Plant} {item.WorkStatus} {item.SheetFlow}")" data-open-url="@Url.Page("/Lavori/Scheda",new{id=item.Id,azione=103})@(received?"#consuntivo":"")"><td class="agenda-check-column"><input type="checkbox" aria-label="Seleziona scheda per la stampa" data-agenda-check /></td><td class="agenda-check-column"><input type="checkbox" aria-label="Scarica scheda alla lavorazione" data-agenda-dispatch-check checked="@item.DispatchedToWork" disabled="@(item.DispatchedToWork||item.Status!=InterventionStatus.Planned)" /></td><td class="agenda-date-stack"><span><b>Scheda</b> @(item.DraftedAt?.ToString("dd/MM/yyyy")??"—")</span><span><b>Lavoro</b> @item.ScheduledAt.ToString("dd/MM/yyyy") · @item.ScheduledAt.ToString("HH:mm")</span></td><td class="agenda-party-stack"><strong>@item.Customer</strong><span title="@item.Site">@item.Site</span></td><td class="agenda-kind-stack"><span title="@item.Kind">@item.Kind</span></td><td data-agenda-operator-name>@item.Plant</td><td class="agenda-state-stack"><span class="agenda-status agenda-status-@item.Status.ToString().ToLowerInvariant()" data-agenda-work-status>@item.WorkStatus</span><span class="agenda-flow @(received?"is-received":item.SheetFlow=="Confermato"?"is-acquired":item.SheetFlow=="Errore"?"is-error":"")" data-agenda-flow>@item.SheetFlow</span></td><td><button class="agenda-open" type="button" data-agenda-open>Apri</button></td></tr>}</tbody>
            </table>
            <div class="list-empty" data-agenda-empty hidden>Nessun lavoro corrisponde ai filtri impostati.</div>
        </div>
    </section>
</section>

<form method="post" data-agenda-command-form>@Html.AntiForgeryToken()</form>

<dialog class="agenda-period-dialog" data-agenda-period-dialog>
    <div class="agenda-period-title">Periodo personalizzato</div>
    <div class="agenda-period-fields">
        <label><span>Dal</span><span class="micronote-date-control" data-date-control><input type="hidden" value="@DateTime.Today.ToString("yyyy-MM-dd")" data-filter-date-hidden data-agenda-custom-from/><input class="micronote-date-input" type="text" inputmode="numeric" maxlength="10" autocomplete="off" value="@DateTime.Today.ToString("dd/MM/yyyy")" placeholder="gg/mm/aaaa" data-filter-date-display/><button class="micronote-date-button" type="button" tabindex="-1" aria-label="Seleziona data iniziale" data-date-picker-button></button></span></label>
        <label><span>Al</span><span class="micronote-date-control" data-date-control><input type="hidden" value="@DateTime.Today.AddMonths(1).ToString("yyyy-MM-dd")" data-filter-date-hidden data-agenda-custom-to/><input class="micronote-date-input" type="text" inputmode="numeric" maxlength="10" autocomplete="off" value="@DateTime.Today.AddMonths(1).ToString("dd/MM/yyyy")" placeholder="gg/mm/aaaa" data-filter-date-display/><button class="micronote-date-button" type="button" tabindex="-1" aria-label="Seleziona data finale" data-date-picker-button></button></span></label>
        <p data-agenda-period-error hidden>La data finale deve essere uguale o successiva alla data iniziale.</p>
    </div>
    <div class="agenda-period-actions"><button class="btn btn-primary" type="button" data-agenda-period-apply>Conferma</button><button class="btn customer-menu-button" type="button" data-agenda-period-cancel>Annulla</button></div>
</dialog>

<dialog class="agenda-print-dialog agenda-operator-dialog" data-agenda-operator-dialog>
    <div class="agenda-print-title">Operatore per lo scarico</div>
    <div class="agenda-print-body">
        <label><span>Operatore</span><select data-agenda-operator-select><option value="">Seleziona…</option>@foreach(var item in Model.Operators){<option value="@item.Id">@item.Description</option>}</select></label>
        <p class="agenda-print-error" data-agenda-operator-error hidden>Selezionare un operatore.</p>
    </div>
    <div class="agenda-print-actions"><button class="btn btn-primary" type="button" data-agenda-operator-confirm>Conferma</button><button class="btn customer-menu-button" type="button" data-agenda-operator-cancel>Annulla</button></div>
</dialog>

<dialog class="agenda-print-dialog" data-agenda-dispatch-dialog>
    <div class="agenda-print-title">Conferma scarico</div>
    <div class="agenda-print-body"><p data-agenda-dispatch-message></p><p>Le schede diventeranno disponibili alla lavorazione mobile.</p><p class="agenda-print-error" data-agenda-dispatch-error hidden></p></div>
    <div class="agenda-print-actions"><button class="btn btn-primary" type="button" data-agenda-dispatch-confirm>Conferma</button><button class="btn customer-menu-button" type="button" data-agenda-dispatch-cancel>Annulla</button></div>
</dialog>

<dialog class="agenda-print-dialog" data-agenda-unassigned-dialog>
    <div class="agenda-print-title">Schede senza operatore</div>
    <div class="agenda-print-body agenda-unassigned-body">
        <p data-agenda-unassigned-message></p>
        <p>In anteprima saranno indicate automaticamente come <strong>Da assegnare</strong>.</p>
    </div>
    <div class="agenda-print-actions"><button class="btn btn-primary" type="button" data-agenda-unassigned-confirm>Continua</button><button class="btn customer-menu-button" type="button" data-agenda-unassigned-cancel>Annulla</button></div>
</dialog>

@section Scripts{<script src="~/js/agenda-list.js" asp-append-version="true"></script>}
