@page "{id:int}"
@model SkyLab.Web.Pages.Interventi.DetailModel
@{ ViewData["Title"]=$"Intervento {Model.Item.Id}"; }
<a asp-page="Index" class="text-decoration-none">← Agenda</a>
<div class="panel mt-3 mb-3"><span class="status">@Model.Item.Status</span><h1 class="h3 mt-2">@Model.Item.Customer</h1><p class="mb-1">@Model.Item.Site</p><p class="text-secondary mb-0">@Model.Item.Plant · @Model.Item.Kind</p></div>
<div class="panel mb-3"><h2 class="h5">Materiali utilizzati</h2><p class="text-secondary">Scansiona il codice oppure inseriscilo manualmente.</p>
 <form method="post" asp-page-handler="Material" class="row g-2"><div class="col-12"><label asp-for="Barcode" class="form-label">Codice a barre</label><div class="input-group"><input asp-for="Barcode" class="form-control form-control-lg" inputmode="numeric" required/><button class="btn btn-outline-primary" type="button" id="scan">Scansiona</button></div></div><div class="col-4"><label asp-for="Quantity" class="form-label">Quantità</label><input asp-for="Quantity" class="form-control" min="0.01" step="0.01"/></div><div class="col-8 d-flex align-items-end"><button class="btn btn-primary w-100">Aggiungi materiale</button></div></form>
 @if(Model.Item.Materials.Count>0){<div class="d-grid gap-2 mt-3">@foreach(var m in Model.Item.Materials){<div class="material-row d-flex justify-content-between"><span><strong>@m.Description</strong><br/><small>@m.Barcode</small></span><strong>× @m.Quantity</strong></div>}</div>}
</div>
<form method="post" asp-page-handler="Complete" class="panel"><h2 class="h5">Chiusura intervento</h2><label asp-for="Notes" class="form-label">Note del tecnico</label><textarea asp-for="Notes" class="form-control mb-3" rows="3"></textarea><button class="btn btn-success btn-lg w-100">Chiudi e genera scarico</button><small class="d-block text-secondary mt-2">Nella baseline lo scarico è registrato in memoria; il collegamento al database sarà introdotto nel modulo dati.</small></form>
@section Scripts {<script>document.querySelector('#scan').addEventListener('click',async()=>{if(!('BarcodeDetector' in window)){alert('Scansione non disponibile su questo browser: inserisci il codice.');return;}try{const s=await navigator.mediaDevices.getUserMedia({video:{facingMode:'environment'}});const v=document.createElement('video');v.srcObject=s;await v.play();const d=new BarcodeDetector({formats:['ean_13','ean_8','code_128','qr_code']});const codes=await d.detect(v);s.getTracks().forEach(t=>t.stop());if(codes[0])document.querySelector('#Barcode').value=codes[0].rawValue;else alert('Codice non rilevato.');}catch{alert('Impossibile accedere alla fotocamera.');}});</script>}
