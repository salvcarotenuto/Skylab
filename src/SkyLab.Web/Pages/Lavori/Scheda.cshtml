<style>.work-history-frame{background:#fff;border:1px solid var(--data-border);padding:10px}.work-history-head{align-items:center;border-bottom:1px solid #c6d2df;display:flex;justify-content:space-between;padding:0 2px 9px}.work-history-head h2{font-size:14px;margin:0}.work-history-head span{color:#536984;font-size:12px}.work-history-list{display:grid}.work-history-event{border-bottom:1px solid #d7e0e9;display:grid;gap:12px;grid-template-columns:105px minmax(0,1fr);padding:12px 6px}.work-history-event:last-child{border-bottom:0}.work-history-date{border-right:3px solid var(--BlueButton);display:grid;align-content:start;padding-right:12px;text-align:right}.work-history-date strong{font-size:13px}.work-history-date span{color:#607089;font-size:12px}.work-history-content header{align-items:center;display:flex;gap:10px}.work-history-content header strong{color:#17365f;font-size:13px;text-transform:capitalize}.work-history-content header span{color:#607089;font-size:12px}.work-history-values{display:flex;flex-wrap:wrap;gap:6px 16px;margin-top:7px}.work-history-values span{background:#edf3fa;border:1px solid #c3d0df;border-radius:5px;font-size:12px;padding:5px 8px}.work-history-values b{font-weight:600;margin-right:5px}.work-history-values i{font-style:normal;margin:0 5px}.work-history-values .skipped{background:#fff1df;border-color:#d6a15b}.work-history-values .realigned{background:#e5f4eb;border-color:#7cb28d}.work-history-content p{color:#536984;font-size:12px;margin:7px 0 0}</style>

<section class="module-page customer-form-page data-form-skin work-edit-page">
 <header class="module-header customer-form-header">
  <div class="module-title-identity"><a class="skylab-header-brand" asp-page="Schede"><img src="~/images/skylab-logo.png" alt="SkyLab" /></a><div><p class="eyebrow">Lavorazione · Scheda</p><h1>Scheda @Model.Lavoro.Code.ToString("000000")/@Model.Lavoro.Year</h1><p>@Model.Lavoro.Customer</p></div></div>
  <div class="customer-form-toolbar">@if(Model.ConsuntivoMobile is not null){<span class="mobile-report-label" title="Ricevuto il @Model.ConsuntivoMobile.Inbox.ReceivedOn.ToString("dd/MM/yyyy HH:mm") da @Model.ConsuntivoMobile.Inbox.Username">Consuntivo da confermare</span><button class="btn btn-primary" type="submit" form="work-form" formaction="?handler=ConfirmMobileReport&amp;id=@Model.Lavoro.Id&amp;inboxId=@Model.ConsuntivoMobile.Inbox.Id">Conferma consuntivo</button>}else if(!Model.SchedaImmutabile){<button class="btn btn-primary" type="submit" form="work-form">Salva</button>}@if(Model.Azione==103){<a class="btn customer-menu-button" asp-page="/Interventi/Index">Esci</a>}else{<a class="btn customer-menu-button" asp-page="Schede">Esci</a>}</div>
 </header>
 <nav class="work-section-tabs" aria-label="Sezioni scheda lavoro" data-work-tabs>
  <button class="work-section-tab is-active" type="button" data-work-tab="pianificazione">Pianificazione</button>
  <button class="work-section-tab" type="button" data-work-tab="previsto">Preventivo</button>
  <button class="work-section-tab" type="button" data-work-tab="consuntivo">Consuntivo</button>
  <button class="work-section-tab" type="button" data-work-tab="documentazione">Documentazione</button>
  <button class="work-section-tab" type="button" data-work-tab="storico">Storico</button>
 </nav>
 <form id="work-form" method="post" class="entity-form customer-entity-form" autocomplete="off" data-form-type="other" data-enter-navigation>
   <input asp-for="Azione" type="hidden"/><input asp-for="Lavoro.Id" type="hidden"/><input asp-for="Lavoro.Year" type="hidden"/><input asp-for="Lavoro.Code" type="hidden"/><input asp-for="Lavoro.CustomerId" type="hidden"/><input asp-for="Lavoro.Customer" type="hidden"/>
  <fieldset class="form-frame compact-frame work-tab-panel" data-work-tab-panel="pianificazione"><div class="work-form-grid">
   <div class="field work-code"><label>Numero scheda</label><input value="@Model.Lavoro.Code.ToString("000000")/@Model.Lavoro.Year" readonly tabindex="-1"/></div>
    <div class="field work-drafted-date"><label>Data scheda</label><span class="micronote-date-control" data-date-control><input name="Lavoro.DraftedOn" type="hidden" value="@(Model.Lavoro.DraftedOn?.ToString("yyyy-MM-dd") ?? "")" data-filter-date-hidden/><input id="Lavoro_DraftedOn" class="micronote-date-input" type="text" inputmode="numeric" maxlength="10" autocomplete="off" value="@(Model.Lavoro.DraftedOn?.ToString("dd/MM/yyyy") ?? "")" placeholder="gg/mm/aaaa" data-filter-date-display/><button class="micronote-date-button" type="button" tabindex="-1" aria-label="Seleziona data scheda" data-date-picker-button></button></span></div>
   <div class="work-client-line"><label>Cliente</label><input class="work-client-code" value="@Model.Lavoro.CustomerId.ToString("00000")" aria-label="Codice cliente" readonly tabindex="-1"/><input value="@Model.Lavoro.Customer" aria-label="Denominazione cliente" readonly tabindex="-1"/></div>
    <div class="field work-site"><label>Sede lavoro</label><select asp-for="Lavoro.SiteId">@foreach(var x in Model.Sedi){<option value="@x.Id">@x.Description</option>}</select></div>
    <div class="field work-planned-date" style="margin-top:15px"><label>Data intervento</label><span class="micronote-date-control" data-date-control><input name="Lavoro.PlannedOn" type="hidden" value="@(Model.Lavoro.PlannedOn?.ToString("yyyy-MM-dd") ?? "")" data-filter-date-hidden/><input id="Lavoro_PlannedOn" class="micronote-date-input" type="text" inputmode="numeric" maxlength="10" autocomplete="off" value="@(Model.Lavoro.PlannedOn?.ToString("dd/MM/yyyy") ?? "")" placeholder="gg/mm/aaaa" data-filter-date-display/><button class="micronote-date-button" type="button" tabindex="-1" aria-label="Seleziona data intervento" data-date-picker-button></button></span></div>
    <div class="field work-planned-time" style="margin-top:15px"><label>Ora intervento</label><input asp-for="Lavoro.PlannedAt" type="time"/></div>
   <div class="field"><label>Ultimo intervento</label><span class="micronote-date-control" data-date-control><input name="Lavoro.LastServiceOn" type="hidden" value="@(Model.Lavoro.LastServiceOn?.ToString("yyyy-MM-dd") ?? "")" data-filter-date-hidden/><input id="Lavoro_LastServiceOn" class="micronote-date-input" type="text" inputmode="numeric" maxlength="10" autocomplete="off" value="@(Model.Lavoro.LastServiceOn?.ToString("dd/MM/yyyy") ?? "")" placeholder="gg/mm/aaaa" data-filter-date-display/><button class="micronote-date-button" type="button" tabindex="-1" aria-label="Seleziona ultimo intervento" data-date-picker-button></button></span></div>
   <div class="field work-operator-field"><label>Operatore assegnato</label><select asp-for="Lavoro.AssignedOperator"><option value="0">Da assegnare</option>@foreach(var x in Model.Operatori){<option value="@x.Id">@x.Description</option>}</select></div>
   <div class="field work-status-field"><label>Stato</label><select asp-for="Lavoro.StatusId">@foreach(var x in Model.Stati){<option value="@x.Id">@x.Description</option>}</select></div>
   <div class="field span-all work-summary" style="margin-top:15px"><label>Sintesi lavoro</label><input asp-for="Lavoro.Summary"/></div>
   <div class="field span-all work-text"><label>Istruzioni operative</label><textarea asp-for="Lavoro.Instructions" rows="3"></textarea></div>
   <div class="field amount"><label>Manodopera prevista</label><input class="planned-derived-amount" value="@Model.Lavoro.PlannedLabour.ToString("N2")" readonly tabindex="-1"/></div>
   <div class="field amount"><label>Materiali previsti</label><input class="planned-derived-amount" value="@Model.Lavoro.PlannedMaterials.ToString("N2")" readonly tabindex="-1"/></div>
   <div class="field amount"><label>Totale preventivo</label><input class="planned-derived-amount" value="@((Model.Lavoro.PlannedLabour+Model.Lavoro.PlannedMaterials).ToString("N2"))" readonly tabindex="-1"/></div>
   <div class="field amount"><label>Preventivo netto</label><input value="@Model.Lavoro.PlannedNet.ToString("N2")" inputmode="decimal" readonly="@Model.PreventivoBloccato" data-decimal-field data-decimal-digits="2" data-decimal-integer-digits="10" data-decimal-zero="fixed" data-planned-net-mirror/></div>
   </div></fieldset>
   <fieldset class="form-frame compact-frame work-tab-panel" data-work-tab-panel="previsto" hidden>
    @{ var prestazioni=Model.RighePreventivo.Where(x=>x.Type=="P").ToList(); var materiali=Model.RighePreventivo.Where(x=>x.Type=="A").ToList(); var incerti=Model.RighePreventivo.Where(x=>x.Type=="?").ToList(); }
    <section class="work-budget-summary-frame"><h2 class="work-budget-summary-title">Riepilogo preventivo</h2><div class="work-form-grid work-budget-summary">
     <div class="field amount"><label>Manodopera prevista</label><input class="planned-derived-amount" asp-for="Lavoro.PlannedLabour" readonly tabindex="-1"/></div>
     <div class="field amount"><label>Materiali previsti</label><input class="planned-derived-amount" asp-for="Lavoro.PlannedMaterials" readonly tabindex="-1"/></div>
     <div class="field amount"><label>Totale preventivo</label><input class="planned-derived-amount" value="@((Model.Lavoro.PlannedLabour+Model.Lavoro.PlannedMaterials).ToString("N2"))" readonly tabindex="-1"/></div>
     <div class="field amount"><label>Preventivo netto</label><input asp-for="Lavoro.PlannedNet" readonly="@Model.PreventivoBloccato" data-decimal-field data-decimal-digits="2" data-decimal-integer-digits="10" data-decimal-zero="fixed" data-planned-net-source/></div>
    </div></section>
    <div class="work-budget-sections">
    <section class="work-detail-box"><header class="work-detail-head"><h2>Interventi richiesti</h2><div class="work-detail-head-actions"><span>@prestazioni.Count righe</span>@if(!Model.PreventivoBloccato){<button class="work-detail-add" type="button" data-work-lookup-open="P">Aggiungi prestazione</button>}</div></header>
     @if(prestazioni.Count==0){<div class="work-detail-empty">Nessuna prestazione registrata.</div>}else{<table class="work-detail-table"><thead><tr><th class="work-detail-code">Codice</th><th>Descrizione</th><th class="work-detail-number">Quantità</th><th class="work-detail-number">Prezzo</th><th class="work-detail-number">Totale</th>@if(!Model.PreventivoBloccato){<th class="work-detail-actions">Comandi</th>}</tr></thead><tbody>@foreach(var r in prestazioni){<tr><td>@r.Reference</td><td>@r.Description</td><td class="work-detail-number">@r.Quantity.ToString("N3")</td><td class="work-detail-number">@r.UnitPrice.ToString("N2")</td><td class="work-detail-number">@r.Amount.ToString("N2")</td>@if(!Model.PreventivoBloccato){<td class="work-detail-actions"><button type="button" class="work-detail-action" data-detail-edit data-row="@r.Row" data-reference="@r.Reference" data-description="@r.Description" data-quantity="@r.Quantity.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-price="@r.UnitPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)">Modifica</button> <button type="button" class="work-detail-action delete" data-detail-delete data-row="@r.Row" data-description="@r.Description">Elimina</button></td>}</tr>}</tbody></table>}
    </section>
    <section class="work-detail-box"><header class="work-detail-head"><h2>Materiali preventivati</h2><div class="work-detail-head-actions"><span>@materiali.Count righe</span>@if(!Model.PreventivoBloccato){<button class="work-detail-add" type="button" data-work-lookup-open="A">Aggiungi articolo</button>}</div></header>
     @if(materiali.Count==0){<div class="work-detail-empty">Nessun materiale registrato.</div>}else{<table class="work-detail-table"><thead><tr><th class="work-detail-code">Articolo</th><th>Descrizione</th><th class="work-detail-number">Quantità</th><th class="work-detail-number">Prezzo</th><th class="work-detail-number">Totale</th>@if(!Model.PreventivoBloccato){<th class="work-detail-actions">Comandi</th>}</tr></thead><tbody>@foreach(var r in materiali){<tr><td>@r.Reference</td><td>@r.Description</td><td class="work-detail-number">@r.Quantity.ToString("N3")</td><td class="work-detail-number">@r.UnitPrice.ToString("N2")</td><td class="work-detail-number">@r.Amount.ToString("N2")</td>@if(!Model.PreventivoBloccato){<td class="work-detail-actions"><button type="button" class="work-detail-action" data-detail-edit data-row="@r.Row" data-reference="@r.Reference" data-description="@r.Description" data-quantity="@r.Quantity.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-price="@r.UnitPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)">Modifica</button> <button type="button" class="work-detail-action delete" data-detail-delete data-row="@r.Row" data-description="@r.Description">Elimina</button></td>}</tr>}</tbody></table>}
    </section>
   </div>
   @if(incerti.Count>0){<p class="work-detail-warning">@incerti.Count righe legacy richiedono ancora la classificazione tra articolo e prestazione.</p>}
  </fieldset>
  <fieldset class="form-frame compact-frame work-tab-panel @(Model.ConsuntivoDaConfermare?"mobile-report-pending":"")" data-work-tab-panel="consuntivo" hidden>
   <fieldset class="mobile-report-values" disabled="@Model.SchedaImmutabile">
   <div class="work-consuntivo-data-frame"><div class="work-form-grid">
   <div class="field"><label>Data lavoro</label><span class="micronote-date-control" data-date-control><input name="Lavoro.CompletedOn" type="hidden" value="@(Model.Lavoro.CompletedOn?.ToString("yyyy-MM-dd") ?? "")" data-filter-date-hidden/><input id="Lavoro_CompletedOn" class="micronote-date-input" type="text" inputmode="numeric" maxlength="10" autocomplete="off" value="@(Model.Lavoro.CompletedOn?.ToString("dd/MM/yyyy") ?? "")" placeholder="gg/mm/aaaa" data-filter-date-display disabled="@Model.ConsuntivoDaConfermare"/><button class="micronote-date-button" type="button" tabindex="-1" aria-label="Seleziona data lavoro" data-date-picker-button disabled="@Model.ConsuntivoDaConfermare"></button></span></div>
   <div class="field"><label>Ora inizio</label><input asp-for="Lavoro.CompletedAt" type="time" disabled="@Model.ConsuntivoDaConfermare"/></div>
   <div class="field"><label>Operatore esecutore</label><select asp-for="Lavoro.ExecutingOperator"><option value="">Da definire</option>@foreach(var x in Model.Operatori){<option value="@x.Id">@x.Description</option>}</select></div>
   <div class="field work-man-hours"><label>Ore uomo</label><input asp-for="Lavoro.ManHours" data-decimal-field data-decimal-digits="2" data-decimal-integer-digits="6" disabled="@Model.ConsuntivoDaConfermare"/></div>
   <div class="field work-outcome"><label>Esito</label><select asp-for="Lavoro.OutcomeId" disabled="@Model.ConsuntivoDaConfermare"><option value=""></option>@foreach(var x in Model.Esiti){<option value="@x.Id">@x.Description</option>}</select></div>
   <div class="field span-all work-text"><label>Attività svolte</label><textarea asp-for="Lavoro.WorkPerformed" rows="3" disabled="@Model.ConsuntivoDaConfermare"></textarea></div>
   <div class="field amount"><label>Manodopera</label><input asp-for="Lavoro.ActualLabour" readonly tabindex="-1" data-work-actual-labour/></div>
   <div class="field amount"><label>Materiali</label><input asp-for="Lavoro.ActualMaterials" readonly tabindex="-1" data-work-actual-materials/></div>
   <div class="field amount"><label>Totale lavoro</label><input value="@((Model.Lavoro.ActualLabour+Model.Lavoro.ActualMaterials).ToString("N2"))" readonly tabindex="-1" data-work-actual-total/></div>
   <div class="field amount work-requested-amount"><label>Importo richiesto</label><input asp-for="Lavoro.RequestedAmount" data-decimal-field data-decimal-digits="2" data-decimal-integer-digits="10" data-decimal-zero="fixed"/></div>
   <div class="field amount work-collected-amount"><label>Importo incassato</label><input asp-for="Lavoro.CollectedAmount" data-decimal-field data-decimal-digits="2" data-decimal-integer-digits="10" data-decimal-zero="fixed"/></div>
   <div class="field"><label>Fattura</label><input value="@(Model.Lavoro.InvoiceId is null ? "Da emettere" : $"N. {Model.Lavoro.InvoiceId}")" readonly tabindex="-1"/></div>
   <div class="field span-all"><label>Note consuntive</label><input asp-for="Lavoro.Notes" disabled="@Model.ConsuntivoDaConfermare"/></div>
   </div></div>
   @{ var prestazioniEffettive=Model.RigheConsuntivo.Where(x=>x.Type=="P").ToList(); var materialiEffettivi=Model.RigheConsuntivo.Where(x=>x.Type=="A").ToList(); var incertiEffettivi=Model.RigheConsuntivo.Where(x=>x.Type=="?").ToList(); }
   <div class="work-actual-lines-frame">
   <div class="work-budget-sections work-actual-sections">
    <section class="work-detail-box"><header class="work-detail-head"><h2>Prestazioni eseguite</h2><div class="work-detail-head-actions"><span>@prestazioniEffettive.Count righe</span><button class="work-detail-add" type="button" data-work-lookup-open="P" data-work-detail-scope="C">Aggiungi prestazione</button></div></header>
     @if(prestazioniEffettive.Count==0){<div class="work-detail-empty">Nessuna prestazione consuntivata.</div>}else{<table class="work-detail-table"><thead><tr><th class="work-detail-code">Codice</th><th>Descrizione</th><th class="work-detail-number">Quantità</th><th class="work-detail-number">Prezzo</th><th class="work-detail-number">Totale</th><th class="work-detail-actions">Comandi</th></tr></thead><tbody>@foreach(var r in prestazioniEffettive){<tr><td>@r.Reference</td><td>@r.Description</td><td class="work-detail-number">@r.Quantity.ToString("N3")</td><td class="work-detail-number">@r.UnitPrice.ToString("N2")</td><td class="work-detail-number">@r.Amount.ToString("N2")</td><td class="work-detail-actions"><button type="button" class="work-detail-action" data-detail-edit data-detail-scope="C" data-row="@r.Row" data-reference="@r.Reference" data-description="@r.Description" data-quantity="@r.Quantity.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-price="@r.UnitPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)">Modifica</button> <button type="button" class="work-detail-action delete" data-detail-delete data-detail-scope="C" data-row="@r.Row" data-description="@r.Description">Elimina</button></td></tr>}</tbody></table>}
    </section>
    <section class="work-detail-box"><header class="work-detail-head"><h2>Materiali utilizzati</h2><div class="work-detail-head-actions"><span>@materialiEffettivi.Count righe</span><button class="work-detail-add" type="button" data-work-lookup-open="A" data-work-detail-scope="C">Aggiungi articolo</button></div></header>
     @if(materialiEffettivi.Count==0){<div class="work-detail-empty">Nessun materiale consuntivato.</div>}else{<table class="work-detail-table"><thead><tr><th class="work-detail-code">Articolo</th><th>Descrizione</th><th class="work-detail-number">Quantità</th><th class="work-detail-number">Prezzo</th><th class="work-detail-number">Totale</th><th class="work-detail-actions">Comandi</th></tr></thead><tbody>@foreach(var r in materialiEffettivi){<tr><td>@r.Reference</td><td>@r.Description</td><td class="work-detail-number">@r.Quantity.ToString("N3")</td><td class="work-detail-number">@r.UnitPrice.ToString("N2")</td><td class="work-detail-number">@r.Amount.ToString("N2")</td><td class="work-detail-actions"><button type="button" class="work-detail-action" data-detail-edit data-detail-scope="C" data-row="@r.Row" data-reference="@r.Reference" data-description="@r.Description" data-quantity="@r.Quantity.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-price="@r.UnitPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)">Modifica</button> <button type="button" class="work-detail-action delete" data-detail-delete data-detail-scope="C" data-row="@r.Row" data-description="@r.Description">Elimina</button></td></tr>}</tbody></table>}
    </section>
   </div>
   @if(incertiEffettivi.Count>0){<p class="work-detail-warning">@incertiEffettivi.Count righe consuntive legacy richiedono ancora la classificazione.</p>}
   </div></fieldset>
  </fieldset>
  <fieldset class="form-frame compact-frame work-tab-panel" data-work-tab-panel="documentazione" hidden><div class="work-doc-layout">
   <section class="work-photo-frame"><header class="work-photo-head"><h2>Fotografie del lavoro (@Model.Fotografie.Count)</h2><button class="work-detail-add" type="button" data-photo-add-open>Aggiungi foto</button></header><div class="work-photo-body">
    <div class="work-photo-preview" data-photo-preview>@if(Model.Fotografie.Count>0){<img src="@Model.Fotografie[0].Url" alt="@Model.Fotografie[0].Description"/>}else{<span class="work-photo-empty">Nessuna fotografia</span>}</div>
    <div class="work-photo-list-frame"><table class="work-photo-table"><thead><tr><th>Progr.</th><th>Nome file</th><th>Data / ora</th><th>Descrizione</th><th></th></tr></thead><tbody>@for(var i=0;i<Model.Fotografie.Count;i++){var f=Model.Fotografie[i];<tr class="@(i==0?"selected":"")" tabindex="0" data-photo-row data-photo-url="@f.Url" data-photo-description="@f.Description"><td>@f.Number</td><td class="work-photo-file" title="@f.FileName">@f.FileName</td><td>@(f.TakenOn?.ToString("dd/MM/yy HH:mm")??"")</td><td>@f.Description</td><td><button class="work-detail-action delete" type="button" data-photo-delete data-photo-number="@f.Number" data-photo-name="@f.FileName">Elimina</button></td></tr>}</tbody></table></div>
   </div></section>
   <section class="work-attachments-frame"><header class="work-photo-head"><h2>Altri documenti (@Model.Documenti.Count)</h2><button class="work-detail-add" type="button" data-document-add-open>Aggiungi documento</button></header>
    @if(Model.Documenti.Count==0){<div class="work-attachments-empty">Nessun documento allegato.</div>}else{<table class="work-document-table"><thead><tr><th>N.</th><th>Nome documento</th><th>Data / ora</th><th>Descrizione</th><th></th></tr></thead><tbody>@foreach(var d in Model.Documenti){<tr><td>@d.Number</td><td><a href="@d.Url" target="_blank" rel="noopener">@d.OriginalName</a></td><td>@d.UploadedOn.ToString("dd/MM/yyyy HH:mm")</td><td>@d.Description</td><td><button class="work-detail-action delete" type="button" data-document-delete data-document-number="@d.Number" data-document-name="@d.OriginalName">Elimina</button></td></tr>}</tbody></table>}
   </section>
  </div></fieldset>
  <fieldset class="form-frame compact-frame work-tab-panel" data-work-tab-panel="storico" hidden><section class="work-history-frame"><header class="work-history-head"><h2>Cronologia della scheda</h2><span>@Model.Storico.Count eventi</span></header>
   @if(Model.Storico.Count==0){<div class="work-section-empty"><div><strong>Nessun evento registrato</strong>La cronologia sarà alimentata dalle prossime variazioni della scheda.</div></div>}else{<div class="work-history-list">@foreach(var e in Model.Storico){<article class="work-history-event"><div class="work-history-date"><strong>@e.EventOn.ToString("dd/MM/yyyy")</strong><span>@e.EventOn.ToString("HH:mm")</span></div><div class="work-history-content"><header><strong>@e.EventType.Replace('_',' ')</strong>@if(!string.IsNullOrWhiteSpace(e.User)){<span>@e.User</span>}</header><div class="work-history-values">
    @if(!string.IsNullOrWhiteSpace(e.PreviousStatus)||!string.IsNullOrWhiteSpace(e.NewStatus)){<span><b>Stato</b> @e.PreviousStatus@if(!string.IsNullOrWhiteSpace(e.PreviousStatus)&&!string.IsNullOrWhiteSpace(e.NewStatus)){<i>→</i>}@e.NewStatus</span>}
    @if(!string.IsNullOrWhiteSpace(e.PreviousOutcome)||!string.IsNullOrWhiteSpace(e.NewOutcome)){<span><b>Esito</b> @e.PreviousOutcome@if(!string.IsNullOrWhiteSpace(e.PreviousOutcome)&&!string.IsNullOrWhiteSpace(e.NewOutcome)){<i>→</i>}@e.NewOutcome</span>}
    @if(e.PreviousPlannedOn is not null||e.NewPlannedOn is not null){<span><b>Pianificazione</b> @(e.PreviousPlannedOn?.ToString("dd/MM/yyyy")??"") @if(e.PreviousPlannedOn is not null&&e.NewPlannedOn is not null){<i>→</i>} @(e.NewPlannedOn?.ToString("dd/MM/yyyy")??"")</span>}
    @if(e.CompletedOn is not null){<span><b>Data lavoro</b> @e.CompletedOn.Value.ToString("dd/MM/yyyy")</span>}
    @if(e.SkippedOn is not null){<span class="skipped"><b>Data saltata</b> @e.SkippedOn.Value.ToString("dd/MM/yyyy")</span>}
    @if(e.RealignedOn is not null){<span class="realigned"><b>Data riallineata</b> @e.RealignedOn.Value.ToString("dd/MM/yyyy")</span>}
    @if(e.PreviousDueOn is not null||e.NewDueOn is not null){<span><b>Scadenza</b> @(e.PreviousDueOn?.ToString("dd/MM/yyyy")??"") @if(e.PreviousDueOn is not null&&e.NewDueOn is not null){<i>→</i>} @(e.NewDueOn?.ToString("dd/MM/yyyy")??"")</span>}
   </div>@if(!string.IsNullOrWhiteSpace(e.Notes)){<p>@e.Notes</p>}</div></article>}</div>}
  </section></fieldset>
 </form>
</section>

<div class="stock-load-article-lookup" hidden data-work-reference-lookup>
 <div class="stock-load-article-lookup-dialog" role="dialog" aria-modal="true" aria-labelledby="work-reference-title">
  <div class="stock-load-article-lookup-title" id="work-reference-title" data-work-reference-title>Lista articoli</div>
  <div class="stock-load-article-lookup-frame" tabindex="0" data-work-reference-frame>
   <table class="stock-load-article-lookup-table work-reference-lookup-table"><thead><tr><th><button type="button" data-work-reference-sort="reference">Codice</button></th><th><button type="button" data-work-reference-sort="description">Descrizione</button></th><th><button type="button" data-work-reference-sort="category">Categoria</button></th><th><button type="button" data-work-reference-sort="price">Prezzo</button></th></tr></thead><tbody>
   @foreach(var item in Model.Riferimenti){<tr hidden data-work-reference-row data-type="@item.Type" data-reference="@item.Reference" data-description="@item.Description" data-category="@item.Category" data-price="@item.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)"><td>@item.Reference</td><td>@item.Description</td><td>@item.Category</td><td>@item.Price.ToString("N2")</td></tr>}
   </tbody></table>
  </div>
  <div class="stock-load-article-lookup-tools machine-article-lookup-tools"><label>Cerca</label><input type="search" autocomplete="off" data-work-reference-search/><label>Record</label><input readonly tabindex="-1" data-work-reference-count/><button class="btn btn-primary" type="button" data-work-reference-ok>Conferma</button><button class="btn customer-menu-button" type="button" data-work-reference-cancel>Annulla</button></div>
 </div>
</div>
<form method="post" asp-page-handler="AddDetail" hidden data-work-reference-form><input name="id" value="@Model.Lavoro.Id"/><input name="tipo" data-work-reference-type/><input name="riferimento" data-work-reference-value/><input name="ambito" value="P" data-work-reference-scope/></form>
<dialog class="work-detail-edit-dialog" data-detail-dialog><form method="post" asp-page-handler="UpdateDetail" data-detail-update-form><input name="id" type="hidden" value="@Model.Lavoro.Id"/><input name="ambito" type="hidden" value="P" data-detail-scope-input/><input name="riga" type="hidden" data-detail-row/><div class="work-detail-edit-title">Modifica riga</div><div class="work-detail-edit-body"><div class="work-detail-edit-item"><label>Codice</label><div class="work-detail-edit-reference" data-detail-reference></div><div class="work-detail-edit-description" data-detail-description></div></div><div class="work-detail-edit-fields"><label><span>Quantità</span><input name="quantita" inputmode="decimal" data-detail-quantity data-decimal-field data-decimal-digits="3" data-decimal-integer-digits="9"/></label><label><span>Prezzo</span><input name="prezzo" inputmode="decimal" data-detail-price data-decimal-field data-decimal-digits="2" data-decimal-integer-digits="10"/></label></div></div><div class="work-detail-edit-buttons"><button class="btn btn-primary" type="submit">Salva</button><button class="btn customer-menu-button" type="button" data-detail-cancel>Annulla</button></div></form></dialog>
<form method="post" asp-page-handler="DeleteDetail" hidden data-detail-delete-form><input name="id" value="@Model.Lavoro.Id"/><input name="ambito" value="P" data-detail-delete-scope/><input name="riga" data-detail-delete-row/></form>
<dialog class="work-photo-dialog" data-photo-dialog><form method="post" enctype="multipart/form-data" asp-page-handler="AddPhoto"><input name="id" type="hidden" value="@Model.Lavoro.Id"/><div class="work-photo-dialog-title">Aggiungi fotografia</div><div class="work-photo-dialog-fields"><label><span>File</span><input name="foto" type="file" accept="image/jpeg,image/png,image/webp" required/></label><label><span>Descrizione</span><input name="descrizione" maxlength="255"/></label></div><div class="work-photo-dialog-actions"><button class="btn btn-primary" type="submit">Carica</button><button class="btn customer-menu-button" type="button" data-photo-dialog-cancel>Annulla</button></div></form></dialog>
<form method="post" asp-page-handler="DeletePhoto" hidden data-photo-delete-form><input name="id" value="@Model.Lavoro.Id"/><input name="numero" data-photo-delete-number/></form>
<dialog class="work-photo-dialog" data-document-dialog><form method="post" enctype="multipart/form-data" asp-page-handler="AddDocument"><input name="id" type="hidden" value="@Model.Lavoro.Id"/><div class="work-photo-dialog-title">Aggiungi documento</div><div class="work-photo-dialog-fields"><label><span>File</span><input name="documento" type="file" accept=".pdf,.doc,.docx,.xls,.xlsx,.txt" required/></label><label><span>Descrizione</span><input name="descrizione" maxlength="255"/></label></div><div class="work-photo-dialog-actions"><button class="btn btn-primary" type="submit">Carica</button><button class="btn customer-menu-button" type="button" data-document-dialog-cancel>Annulla</button></div></form></dialog>
<form method="post" asp-page-handler="DeleteDocument" hidden data-document-delete-form><input name="id" value="@Model.Lavoro.Id"/><input name="numero" data-document-delete-number/></form>

@section Scripts { <script src="~/js/decimal-fields.js" asp-append-version="true"></script><script src="~/js/work-sections.js" asp-append-version="true"></script><script src="~/js/work-reference-lookup.js" asp-append-version="true"></script><script src="~/js/work-detail-rows.js" asp-append-version="true"></script><script src="~/js/work-totals.js" asp-append-version="true"></script><script src="~/js/work-photos.js" asp-append-version="true"></script><script src="~/js/form-enter-navigation.js" asp-append-version="true"></script> }
