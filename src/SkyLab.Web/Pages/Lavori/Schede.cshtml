@page
@model SkyLab.Web.Pages.Lavori.SchedeModel
@{ ViewData["Title"] = "Schede lavori"; ViewData["HideFooter"] = true; }

<section class="work-list-page" data-work-list-page>
    <header class="planning-heading customer-form-header work-list-heading">
        <div class="module-title-identity">
            <div class="skylab-header-brand" aria-hidden="true"><img src="~/images/skylab-logo.png" alt="" /></div>
            <div><p class="eyebrow">Lavorazione · Schede</p><h1>Schede lavori</h1><p>Pianificazione, esecuzione e consuntivo degli interventi.</p></div>
        </div>
        <div class="work-heading-actions">
            <span class="work-count"><strong data-work-count>@Model.Items.Count</strong> schede</span>
            <button class="btn btn-primary work-new-button" type="button" disabled title="Disponibile con la scheda lavoro">Nuova scheda</button>
            <a class="btn btn-outline-primary customer-menu-button" asp-page="/Index">← Menu principale</a>
        </div>
    </header>

    <form method="get" class="work-filters" data-work-filter-form>
        <input type="search" class="form-control work-search" placeholder="Cerca cliente, scheda o descrizione" autocomplete="off" autofocus data-work-search />
        <label><span class="work-filter-label">Ordina per</span>
            <select asp-for="OrdinaPer" class="form-select" data-work-order>
                <option value="scheda">Data scheda</option>
                <option value="lavoro">Data lavoro</option>
            </select>
        </label>
        <label><span class="work-filter-label">Dal</span><span class="micronote-date-control" data-date-control><input name="Da" type="hidden" value="@Model.Da?.ToString("yyyy-MM-dd")" data-filter-date-hidden data-work-date/><input class="micronote-date-input" type="text" inputmode="numeric" maxlength="10" autocomplete="off" value="@Model.Da?.ToString("dd/MM/yyyy")" placeholder="gg/mm/aaaa" data-filter-date-display/><button class="micronote-date-button" type="button" tabindex="-1" aria-label="Seleziona data iniziale" data-date-picker-button></button></span></label>
        <label><span class="work-filter-label">Al</span><span class="micronote-date-control" data-date-control><input name="Al" type="hidden" value="@Model.Al?.ToString("yyyy-MM-dd")" data-filter-date-hidden data-work-date/><input class="micronote-date-input" type="text" inputmode="numeric" maxlength="10" autocomplete="off" value="@Model.Al?.ToString("dd/MM/yyyy")" placeholder="gg/mm/aaaa" data-filter-date-display/><button class="micronote-date-button" type="button" tabindex="-1" aria-label="Seleziona data finale" data-date-picker-button></button></span></label>
        <label><span class="work-filter-label">Stato</span>
            <select asp-for="Stato" class="form-select">
                <option value="0">Tutti</option>
                @foreach (var item in Model.Stati) { <option value="@item.Id">@item.Description</option> }
            </select>
        </label>
        <label><span class="work-filter-label">Operatore</span>
            <select asp-for="Operatore" class="form-select">
                <option value="0">Tutti</option>
                @foreach (var item in Model.Operatori) { <option value="@item.Id">@item.Description</option> }
            </select>
        </label>
        <label><span class="work-filter-label">Esito</span>
            <select asp-for="Esito" class="form-select">
                <option value="0">Tutti</option>
                @foreach (var item in Model.Esiti) { <option value="@item.Id">@item.Description</option> }
            </select>
        </label>
    </form>

    <div class="work-list-frame">
        <div class="work-list" data-work-list>
            @foreach (var item in Model.Items)
            {
                <article class="work-row" data-work-row data-filter="@item.Code @item.Year @item.Customer @item.Site @item.Summary @item.AssignedOperator @item.Status @item.Outcome">
                    <div class="work-number"><span>Scheda</span><strong>@item.Code.ToString("000000")/@item.Year</strong><small>Redatta @item.DraftedOn?.ToString("dd/MM/yyyy")</small></div>
                    <div class="work-date"><span>Intervento</span><strong>@item.PlannedOn?.ToString("dd/MM/yyyy")</strong><small>@(item.PlannedAt is null ? "" : $"ore {item.PlannedAt:hh\\:mm}")</small></div>
                    <div class="work-customer"><span>Cliente</span><strong>@item.Customer</strong><small>@item.Summary</small></div>
                    <div class="work-site"><span>Sede lavoro</span><strong>@item.Site</strong></div>
                    <div><span>Operatore</span><strong>@(string.IsNullOrWhiteSpace(item.AssignedOperator) ? "—" : item.AssignedOperator)</strong></div>
                    <div><span>Stato / esito</span><strong class="work-status status-@item.StatusId">@item.Status</strong><small>@(string.IsNullOrWhiteSpace(item.Outcome) ? "Esito da definire" : item.Outcome)</small></div>
                    <div class="work-amount"><span>Preventivo</span><strong>@item.PlannedAmount.ToString("N2")</strong><small>@(item.InvoiceId is null ? "Da fatturare" : $"Fattura #{item.InvoiceId}")</small></div>
                    <a class="btn customer-menu-button work-open" asp-page="Scheda" asp-route-id="@item.Id">Apri</a>
                </article>
            }
        </div>
        <div class="empty-panel work-empty" data-work-empty hidden><h2>Nessuna scheda trovata</h2><p>Modificare la ricerca o i filtri.</p></div>
    </div>
</section>

@section Scripts {
    <script src="~/js/work-list.js" asp-append-version="true"></script>
    <script>
        (() => {
            const search = document.querySelector('[data-work-search]');
            if (!search) return;
            search.focus({ preventScroll: true });
            if (search.dataset.liveFilterBound === 'true') return;
            search.dataset.liveFilterBound = 'true';
            const normalize = value => (value || '').toLocaleLowerCase('it-IT').normalize('NFD').replace(/[\u0300-\u036f]/g, '');
            search.addEventListener('input', () => {
                const term = normalize(search.value.trim());
                const rows = [...document.querySelectorAll('[data-work-row]')];
                let visible = 0;
                rows.forEach(row => {
                    const show = !term || normalize(row.dataset.filter).includes(term);
                    row.hidden = !show;
                    if (show) visible += 1;
                });
                const count = document.querySelector('[data-work-count]');
                const empty = document.querySelector('[data-work-empty]');
                if (count) count.textContent = visible;
                if (empty) empty.hidden = visible !== 0;
            });
        })();
    </script>
}
