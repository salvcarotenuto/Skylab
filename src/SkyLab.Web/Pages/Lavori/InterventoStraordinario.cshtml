@page
@model SkyLab.Web.Pages.Lavori.InterventoStraordinarioModel
@{
    ViewData["Title"] = "Intervento straordinario";
    ViewData["HideFooter"] = true;
}

<style>
    .extra-work-page {
        margin-left: 50%;
        padding-top: 10px;
        transform: translateX(-50%);
        user-select: none;
        width: min(1380px, calc(100vw - 32px));
    }

    .extra-work-heading {
        box-sizing: border-box;
        height: 96px;
        padding: 10px 18px;
    }

    .extra-work-heading h1 {
        font-size: 1.65rem;
        line-height: 1.05;
    }

    .extra-work-heading p {
        margin: 2px 0 0;
    }

    .extra-work-heading .btn {
        align-items: center;
        display: inline-flex;
        height: 40px;
        justify-content: center;
        width: 160px;
    }

    .extra-work-actions { display: flex; gap: 8px; }
    .extra-work-form { background: #fff; border: 1px solid #9baabd; border-radius: 10px; margin-top: 10px; padding: 14px; }
    .extra-work-form h2 { background: #6aa4dc; font-size: 16px; font-weight: 500; height: 38px; line-height: 38px; margin: 0 0 14px; padding: 0 16px; }
    .extra-work-fields { background: #e7e7f7; border: 1px solid #7e8491; display: grid; gap: 8px; padding: 16px; }
    .extra-work-fields label { display: grid; gap: 5px; grid-template-columns: 175px minmax(0,1fr); }
    .extra-work-fields label > span:first-child { align-items: center; background: #b8cbe0; border: 1px solid #8a8f98; border-radius: 6px; display: flex; padding: 0 8px; }
    .extra-work-fields input,.extra-work-fields select,.extra-work-fields textarea { border: 1px solid #8a8f98; border-radius: 6px; box-sizing: border-box; min-height: 32px; }
    .extra-work-fields input:focus,.extra-work-fields select:focus,.extra-work-fields textarea:focus { border-color: #6f7f92; box-shadow: 0 0 0 1px #6f7f9226; outline: none; }
    .extra-work-fields textarea { min-height: 64px; resize: vertical; }
    .extra-work-client { display: grid; gap: 6px; grid-template-columns: 115px minmax(0,1fr) 34px; }
    .extra-work-readonly { background:#edf2f8; color:#000; cursor:default; pointer-events:none; user-select:none; }
    #extra-customer-id { text-align:center; }
    .extra-work-client button { align-items: center; background: #eef2fb; border: 1px solid var(--BlueButton); border-radius: 6px; color: #334d8c; display: flex; justify-content: center; }
    .extra-work-compact { width: 160px; }
    .extra-work-compact .micronote-date-input, input.extra-work-compact { text-align:center; }
    input.extra-work-compact { padding-left:0; padding-right:30px; }
    input.extra-work-compact::-webkit-datetime-edit { text-align:center; width:100%; }
    .extra-work-fields .micronote-date-control.extra-work-compact { display:block; position:relative; width:160px!important; }
    .extra-work-fields .micronote-date-control.extra-work-compact .micronote-date-input { border-radius:6px; height:32px; padding:0 30px 0 0; text-align:center!important; text-indent:0; width:160px; }
    .extra-work-fields .micronote-date-control.extra-work-compact .micronote-date-input::placeholder { text-align:center; }
    .extra-work-fields .micronote-date-control.extra-work-compact .micronote-date-button { bottom:1px; height:auto; min-height:0; right:1px; top:1px; width:28px; }
    .extra-work-editable-select { display:grid; grid-template-columns:minmax(0,1fr) 34px; }
    .extra-work-editable-select input { border-radius:6px 0 0 6px; min-width:0; }
    .extra-work-editable-select button { background:#eef2fb; border:1px solid #8a8f98; border-left:0; border-radius:0 6px 6px 0; color:#263a55; position:relative; }
    .extra-work-editable-select button::before { border-bottom:1.5px solid currentColor; border-right:1.5px solid currentColor; content:""; height:7px; left:50%; position:absolute; top:46%; transform:translate(-50%,-50%) rotate(45deg); width:7px; }
    .extra-work-editable-select button:hover { background:var(--BlueButton); color:#fff; }
    .customer-lookup-dialog { background:#e7edf5; border:1px solid #7d8794; box-shadow:0 18px 42px #14202d3d; display:grid; gap:8px; grid-template-rows:38px 34px minmax(0,1fr) 40px; height:min(620px,calc(100vh - 80px)); padding:10px; width:min(900px,calc(100vw - 80px)); }
    .customer-lookup-dialog:not([open]) { display:none; }
    .customer-lookup-dialog::backdrop { background:#0f172a3d; }
    .customer-lookup-title { align-items:center; background:#6aa4dc; display:flex; justify-content:space-between; padding:0 10px; }
    .customer-lookup-title h2 { font-size:16px; font-weight:500; margin:0; }
    .customer-lookup-toolbar { align-items:center; display:grid; gap:6px; grid-template-columns:82px minmax(0,1fr); }
    .customer-lookup-toolbar label { align-items:center; background:#b8cbe0; border:1px solid #8a8f98; display:flex; font-size:12px; height:30px; padding:0 8px; }
    .customer-lookup-toolbar input { border:1px solid #8a8f98; border-radius:5px; height:30px; padding:0 8px; }
    .customer-lookup-grid { background:#fff; border:1px solid #8a8f98; overflow:auto; outline:none; }
    .customer-lookup-grid table { border-collapse:collapse; font-size:13px; width:100%; }
    .customer-lookup-grid thead { position:sticky; top:0; z-index:1; }
    .customer-lookup-grid th { background:#b8cbe0; padding:0; text-align:left; }
    .customer-lookup-grid th button { background:transparent; border:0; font-weight:600; height:32px; padding:0 9px; text-align:left; width:100%; }
    .customer-lookup-grid td { border-bottom:1px solid #d7e0ea; padding:7px 9px; }
    .customer-lookup-grid th:first-child,.customer-lookup-grid td:first-child { width:100px; }
    .customer-lookup-grid th:last-child,.customer-lookup-grid td:last-child { width:210px; }
    .customer-lookup-grid tbody tr.selected { background:#d9e8fb; box-shadow:inset 3px 0 var(--BlueButton); }
    .customer-lookup-actions { display:flex; gap:8px; justify-content:flex-end; }
    .customer-lookup-actions .btn { height:34px; width:120px; }

    .extra-work-intro {
        background: #ffffffd9;
        border: 1px solid #c8d6e6;
        border-radius: 10px;
        margin-top: 10px;
        padding: 24px;
    }

    .extra-work-intro h2 {
        font-size: 1.05rem;
        margin: 0 0 6px;
    }

    .extra-work-intro p {
        color: #53657c;
        margin: 0;
    }
</style>

<section class="extra-work-page">
    <header class="planning-heading customer-form-header extra-work-heading">
        <div class="module-title-identity">
            <div class="skylab-header-brand" aria-hidden="true"><img src="~/images/skylab-logo.png" alt="" /></div>
            <div>
                <p class="eyebrow">Lavorazione · Pianificazione</p>
                <h1>Intervento straordinario</h1>
                <p>Richieste fuori pianificazione da prenotare e trasformare in schede lavoro.</p>
            </div>
        </div>
        <div class="extra-work-actions">
            <button class="btn btn-primary" type="submit" form="extra-work-form">Salva</button>
            <a class="btn customer-menu-button" asp-page="/Index">Esci</a>
        </div>
    </header>

    <form id="extra-work-form" class="extra-work-form" method="post" novalidate>
        <h2>Nuovo intervento straordinario</h2>
        <div class="extra-work-fields">
            <label><span>Cliente</span><span class="extra-work-client"><input id="extra-customer-value" name="clienteId" type="hidden"/><input id="extra-customer-id" aria-label="Codice cliente" inputmode="numeric" maxlength="5" autocomplete="off"/><input id="extra-customer-name" class="extra-work-readonly" aria-label="Nome cliente" readonly tabindex="-1"/><button type="button" aria-label="Cerca cliente" data-customer-lookup-open>⌕</button></span></label>
            <label><span>Sede</span><select id="extra-site-id" name="sedeId" disabled><option value=""></option></select></label>
            <label><span>Macchina</span><select id="extra-machine-id" name="macchinaId" disabled><option value=""></option></select></label>
            <label><span>Intervento richiesto</span><span class="extra-work-editable-select"><input name="descrizione" list="extra-work-descriptions" maxlength="255" required data-extra-description/><button type="button" aria-label="Mostra prestazioni" data-extra-description-open></button></span><datalist id="extra-work-descriptions">@foreach(var item in Model.Prestazioni){<option value="@item.Description"></option>}</datalist></label>
            <label><span>Data concordata</span><span class="micronote-date-control extra-work-compact" data-date-control><input name="dataIntervento" type="hidden" data-filter-date-hidden/><input class="micronote-date-input" type="text" inputmode="numeric" maxlength="10" autocomplete="off" placeholder="gg/mm/aaaa" required data-filter-date-display/><button class="micronote-date-button" type="button" tabindex="-1" aria-label="Seleziona data concordata" data-date-picker-button></button></span></label>
            <label><span>Ora concordata</span><input class="extra-work-compact" name="oraIntervento" type="time"/></label>
            <label><span>Note</span><textarea name="note" maxlength="500"></textarea></label>
        </div>
    </form>
</section>

<partial name="_CustomerLookup" model="Model.Clienti" />

@section Scripts {
<script>
document.addEventListener("DOMContentLoaded",()=>{
 const esc=value=>String(value??"").replace(/[&<>\"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'\"':"&quot;","'":"&#39;"}[c]));
 const loadCustomerData=async customerId=>{const site=document.querySelector("#extra-site-id"),machine=document.querySelector("#extra-machine-id");site.disabled=true;machine.disabled=true;site.innerHTML='<option value=""></option>';machine.innerHTML='<option value=""></option>';try{const response=await fetch(`?handler=CustomerData&customerId=${encodeURIComponent(customerId)}`);if(!response.ok)throw new Error();const data=await response.json();site.innerHTML=data.sites.map(x=>`<option value="${x.id}">${esc(x.label)}</option>`).join("");machine.innerHTML='<option value=""></option>'+data.machines.map(x=>`<option value="${x.id}" data-site="${x.siteId}">${esc(x.label)}</option>`).join("");site.disabled=false;machine.disabled=false}catch{site.innerHTML='<option value="0"></option>';machine.innerHTML='<option value=""></option>';site.disabled=false;machine.disabled=false}};
 document.querySelector("[data-customer-lookup]").addEventListener("skylab:customer-selected",event=>{const customer=event.detail;document.querySelector("#extra-customer-value").value=customer.code;document.querySelector("#extra-customer-id").value=String(customer.code).padStart(5,"0");document.querySelector("#extra-customer-name").value=customer.name;loadCustomerData(customer.code)});
 document.querySelector("#extra-machine-id").addEventListener("change",event=>{const selectedOption=event.target.selectedOptions[0];if(selectedOption?.dataset.site!==undefined)document.querySelector("#extra-site-id").value=selectedOption.dataset.site});
 const description=document.querySelector("[data-extra-description]");document.querySelector("[data-extra-description-open]").addEventListener("click",()=>{description.focus();if(typeof description.showPicker==="function")description.showPicker()});
 const showError=(message,focusTarget)=>window.SkyLabMessageBox.show({title:"SkyLab - attenzione",message,variant:"error",okText:"OK",onConfirm:()=>focusTarget.focus()});
 document.querySelector("#extra-work-form").addEventListener("submit",event=>{const customer=document.querySelector("#extra-customer-value"),date=document.querySelector("input[name='dataIntervento']");let message="",focusTarget=null;if(!customer.value){message="Selezionare il cliente.";focusTarget=document.querySelector("[data-customer-lookup-open]")}else if(!description.value.trim()){message="Inserire l’intervento richiesto.";focusTarget=description}else if(!date.value){message="Inserire la data concordata.";focusTarget=document.querySelector("[data-filter-date-display]")}if(message){event.preventDefault();showError(message,focusTarget)}});
});
</script>
<script>
document.addEventListener("DOMContentLoaded",()=>{
 const customers=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Clienti.Select(x=>new{code=x.Code,name=x.Name})));
 const code=document.querySelector("#extra-customer-id"),value=document.querySelector("#extra-customer-value"),name=document.querySelector("#extra-customer-name"),site=document.querySelector("#extra-site-id"),machine=document.querySelector("#extra-machine-id");
 const esc=text=>String(text??"").replace(/[&<>\"']/g,char=>({"&":"&amp;","<":"&lt;",">":"&gt;",'\"':"&quot;","'":"&#39;"}[char]));
 const error=()=>window.SkyLabMessageBox.show({title:"SkyLab - attenzione",message:"Il codice cliente inserito non è presente in anagrafica.",variant:"error",okText:"OK",onConfirm:()=>{code.focus();code.select()}});
 code.addEventListener("input",()=>code.value=code.value.replace(/\D/g,""));
 code.addEventListener("keydown",event=>{if(event.key==="Enter"){event.preventDefault();code.blur()}});
 code.addEventListener("change",async()=>{const typed=code.value.trim();if(!typed){value.value="";name.value="";site.innerHTML='<option value=""></option>';machine.innerHTML='<option value=""></option>';site.disabled=true;machine.disabled=true;return}const row=customers.find(x=>Number(x.code)===Number(typed));if(!row){value.value="";name.value="";site.innerHTML='<option value=""></option>';machine.innerHTML='<option value=""></option>';site.disabled=true;machine.disabled=true;error();return}code.value=String(row.code).padStart(5,"0");value.value=row.code;name.value=row.name;site.disabled=true;machine.disabled=true;try{const response=await fetch(`?handler=CustomerData&customerId=${encodeURIComponent(row.code)}`),data=await response.json();site.innerHTML=data.sites.map(x=>`<option value="${x.id}">${esc(x.label)}</option>`).join("");machine.innerHTML='<option value=""></option>'+data.machines.map(x=>`<option value="${x.id}" data-site="${x.siteId}">${esc(x.label)}</option>`).join("");site.disabled=false;machine.disabled=false}catch{site.innerHTML='<option value=""></option>';machine.innerHTML='<option value=""></option>';site.disabled=false;machine.disabled=false}});
});
</script>
}
