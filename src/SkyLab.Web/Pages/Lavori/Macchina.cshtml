@page
@model SkyLab.Web.Pages.Lavori.MacchinaModel
@{ViewData["Title"]=Model.Macchina.Id==0?"Nuova installazione":"Scheda macchina";}
<nav class="module-nav mb-3"><a class="module-home" asp-page="MacchineInstallate">← Macchine installate</a><span>Fascicolo operativo · Macchina</span></nav><header class="planning-heading"><div><p class="eyebrow">Impianto del cliente</p><h1>@(Model.Macchina.Id==0?"Nuova installazione":"Scheda macchina #"+Model.Macchina.Id)</h1><p>Identificazione, sede, installazione e ciclo manutentivo.</p></div></header>@if(TempData["Message"] is string msg){<div class="alert alert-success">@msg</div>}
<form method="post" class="edit-form"><input asp-for="Macchina.Id" type="hidden"/><section><h2>Collocazione</h2><div class="form-grid"><label class="span-2">Cliente<select asp-for="Macchina.CustomerId" class="form-select"><option value="0">Seleziona cliente</option>@foreach(var c in Model.Clienti){<option value="@c.Id">@c.Label</option>}</select></label><label class="span-2">Sede d’installazione<select asp-for="Macchina.SiteId" class="form-select"><option value="">Indirizzo principale</option>@foreach(var s in Model.Sedi){<option value="@s.Id">@s.Label</option>}</select></label></div><p class="form-hint">Per una nuova macchina, seleziona il cliente e salva; al successivo accesso saranno disponibili le sue sedi aggiuntive.</p></section><section><h2>Macchina o impianto</h2><div class="form-grid"><label>Codice articolo<input asp-for="Macchina.ArticleCode" class="form-control"/></label><label>Categoria<select asp-for="Macchina.CategoryId" class="form-select"><option value="">Nessuna</option>@foreach(var c in Model.Categorie){<option value="@c.Code">@c.Description</option>}</select></label><label>Data installazione<input asp-for="Macchina.InstalledOn" type="date" class="form-control"/></label><label>Valore<input asp-for="Macchina.Value" type="number" step="0.01" class="form-control"/></label></div></section><section><h2>Manutenzione programmata</h2><div class="form-grid"><label>Durata ciclo in giorni<input asp-for="Macchina.DurationDays" type="number" class="form-control"/></label><label>Prossimo intervento<input asp-for="Macchina.NextServiceOn" type="date" class="form-control"/></label></div></section><section><h2>Fascicolo tecnico</h2><div class="future-features"><span>Fotografie</span><span>Storico interventi</span><span>Note tecniche</span><span>Nuovo intervento</span></div><p class="form-hint">Queste sezioni saranno collegate stabilmente a MacchineCli.ID nei prossimi incrementi.</p></section><div class="form-actions"><a class="btn btn-light" asp-page="MacchineInstallate">Annulla</a><button class="btn btn-primary">Salva macchina</button></div></form>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
