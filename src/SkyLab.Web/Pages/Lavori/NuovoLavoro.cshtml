<section class="new-work-page"><header class="planning-heading customer-form-header new-work-heading"><div class="module-title-identity"><div class="skylab-header-brand" aria-hidden="true"><img src="~/images/skylab-logo.png" alt=""/></div><div><p class="eyebrow">Lavorazione · Pianificazione</p><h1>Nuovo lavoro</h1><p>Nuove installazioni e attività non originate da impianti esistenti.</p></div></div><div class="new-work-actions"><button class="btn btn-primary" type="submit" form="new-work-form">Salva</button><a class="btn customer-menu-button" asp-page="/Index">Esci</a></div></header>
<form method="post" id="new-work-form" class="new-work-form" novalidate><h2>Nuova richiesta di lavoro</h2><div class="new-work-fields">
<label class="new-work-row"><span>Cliente</span><span class="new-work-pick"><input type="hidden" name="clienteId" data-client-id/><input inputmode="numeric" maxlength="5" autocomplete="off" data-client-code/><input class="readonly-field" readonly tabindex="-1" data-client-name/><button class="pick-button" type="button" data-customer-lookup-open title="Cerca cliente">⌕</button><button class="pick-button" type="button" data-open-new-client title="Nuovo cliente">+</button></span></label>
<label class="new-work-row"><span>Sede</span><select name="sedeId" data-sites><option value=""></option></select></label>
<label class="new-work-row"><span>Impianto / articolo</span><span class="new-work-pick article"><input maxlength="30" autocomplete="off" name="articolo" data-article-code/><input class="readonly-field" readonly tabindex="-1" data-article-description/><button class="pick-button" type="button" data-open-articles title="Seleziona dal catalogo">+</button></span></label>
<label class="new-work-row"><span>Lavoro richiesto</span><span class="new-work-editable-select"><input name="descrizione" list="new-work-descriptions" maxlength="255" data-new-work-description/><button type="button" aria-label="Mostra prestazioni" data-new-work-description-open></button></span><datalist id="new-work-descriptions">@foreach(var item in Model.Prestazioni){<option value="@item.Description"></option>}</datalist></label><label class="new-work-row"><span>Data concordata</span><span class="micronote-date-control new-work-compact" data-date-control><input name="dataIntervento" type="hidden" data-filter-date-hidden/><input class="micronote-date-input" type="text" inputmode="numeric" maxlength="10" autocomplete="off" placeholder="gg/mm/aaaa" data-filter-date-display/><button class="micronote-date-button" type="button" tabindex="-1" aria-label="Seleziona data concordata" data-date-picker-button></button></span></label><label class="new-work-row"><span>Ora concordata</span><input class="new-work-compact" name="oraIntervento" type="time"/></label><label class="new-work-row"><span>Note</span><textarea name="note" maxlength="500"></textarea></label>
</div></form></section>
<dialog class="lookup-box" data-client-dialog><h2>Seleziona cliente</h2><input class="lookup-search" type="search" placeholder="Cerca per codice, nome o città" data-client-search/><div class="lookup-grid" data-client-grid><div class="lookup-head"><button type="button" data-client-sort="code">Codice</button><button type="button" data-client-sort="name">Cliente</button><button type="button" data-client-sort="city">Città</button></div>@foreach(var c in Model.Clienti){<button class="lookup-row customer" type="button" data-client-row data-code="@c.Code" data-name="@c.Name" data-city="@c.City"><strong>@c.Code.ToString("00000")</strong><span>@c.Name</span><span>@c.City</span></button>}</div><div class="lookup-actions"><button class="btn btn-primary" type="button" data-confirm-client>Conferma</button><button class="btn customer-menu-button" type="button" data-close-client>Annulla</button></div></dialog>
<partial name="_CustomerLookup" model="Model.Clienti" />
<dialog class="lookup-box" data-article-dialog><h2>Seleziona articolo di catalogo</h2><input class="lookup-search" type="search" placeholder="Cerca per codice, descrizione o categoria" data-article-search/><div class="lookup-grid">@foreach(var a in Model.Articoli){<button class="lookup-row article" type="button" data-article-row data-code="@a.Code" data-description="@a.Description"><strong>@a.Code</strong><span>@a.Description</span><span>@a.Category</span><span>@a.Price.ToString("N2")</span></button>}</div><div class="lookup-actions"><button class="btn customer-menu-button" type="button" data-close-article>Esci</button></div></dialog>
<dialog class="customer-card-dialog" data-new-client-dialog><input type="hidden" data-new-client-name/><button type="button" hidden data-save-new-client></button><button type="button" hidden data-close-new-client></button><iframe src="/Clienti/Edit?modal=true" title="Nuovo cliente" data-customer-card-frame></iframe></dialog>
@section Scripts{<script>document.addEventListener("DOMContentLoaded",()=>{const q=s=>document.querySelector(s),clients=q("[data-client-dialog]"),articles=q("[data-article-dialog]"),newClient=q("[data-new-client-dialog]"),id=q("[data-client-id]"),code=q("[data-client-code]"),name=q("[data-client-name]"),sites=q("[data-sites]");const esc=v=>String(v??"").replace(/[&<>\"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'\"':"&quot;","'":"&#39;"}[c]));async function selectClient(clientId,clientName){id.value=clientId;code.value=String(clientId).padStart(5,"0");name.value=clientName;sites.innerHTML='<option value="">Caricamento…</option>';const r=await fetch(`?handler=CustomerData&customerId=${clientId}`),x=await r.json();sites.innerHTML=x.found?x.sites.map(s=>`<option value="${s.id||""}">${esc(s.label)}</option>`).join(""):'<option value="">Sede non disponibile</option>'}q("[data-close-client]").onclick=()=>clients.close();q("[data-open-articles]").onclick=()=>{articles.showModal();q("[data-article-search]").focus()};q("[data-close-article]").onclick=()=>articles.close();q("[data-open-new-client]").onclick=()=>{newClient.showModal();q("[data-new-client-name]").focus()};q("[data-close-new-client]").onclick=()=>newClient.close();document.querySelectorAll("[data-client-row]").forEach(r=>r.onclick=()=>{selectClient(r.dataset.code,r.dataset.name);clients.close()});document.querySelectorAll("[data-article-row]").forEach(r=>r.onclick=()=>{q("[data-article-code]").value=r.dataset.code;q("[data-article-description]").value=r.dataset.description;articles.close()});function filter(input,rows){input.oninput=()=>{const term=input.value.toLocaleLowerCase("it");rows.forEach(r=>r.hidden=!r.textContent.toLocaleLowerCase("it").includes(term))}}filter(q("[data-client-search]"),[...document.querySelectorAll("[data-client-row]")]);filter(q("[data-article-search]"),[...document.querySelectorAll("[data-article-row]")]);q("[data-save-new-client]").onclick=async()=>{const n=q("[data-new-client-name]").value.trim();if(!n){alert("Inserire il nome del cliente.");return}const token=q('#new-work-form input[name="__RequestVerificationToken"]').value,body=new URLSearchParams({name:n,__RequestVerificationToken:token}),r=await fetch("?handler=CreateCustomer",{method:"POST",headers:{"Content-Type":"application/x-www-form-urlencoded"},body}),x=await r.json();if(!x.ok){alert(x.message);return}await selectClient(x.code,x.name);newClient.close()}});</script>}
<script>document.addEventListener("DOMContentLoaded",()=>{const sites=document.querySelector("[data-sites]");document.querySelector("[data-customer-lookup]").addEventListener("skylab:customer-selected",async event=>{const customer=event.detail;document.querySelector("[data-client-id]").value=customer.code;document.querySelector("[data-client-code]").value=String(customer.code).padStart(5,"0");document.querySelector("[data-client-name]").value=customer.name;sites.replaceChildren(new Option("Caricamento…",""));try{const response=await fetch(`?handler=CustomerData&customerId=${encodeURIComponent(customer.code)}`),data=await response.json();sites.replaceChildren(...data.sites.map(site=>new Option(site.label,site.id||"")))}catch{sites.replaceChildren(new Option("",""))}})});</script>
<script>document.addEventListener("DOMContentLoaded",()=>{const grid=document.querySelector("[data-client-grid]"),head=[...grid.querySelectorAll("[data-client-sort]")];let key="name",direction=1;const sort=button=>{const next=button.dataset.clientSort;direction=key===next?-direction:1;key=next;head.forEach(x=>x.removeAttribute("data-direction"));button.dataset.direction=direction===1?"asc":"desc";const rows=[...grid.querySelectorAll("[data-client-row]")];rows.sort((a,b)=>{if(key==="code")return (Number(a.dataset.code)-Number(b.dataset.code))*direction;return String(a.dataset[key]||"").localeCompare(String(b.dataset[key]||""),"it",{numeric:true,sensitivity:"base"})*direction});rows.forEach(row=>grid.append(row))};head.forEach(button=>button.addEventListener("click",()=>sort(button)))});</script>
<script>document.addEventListener("DOMContentLoaded",()=>{const dialog=document.querySelector("[data-client-dialog]"),grid=dialog.querySelector("[data-client-grid]"),search=dialog.querySelector("[data-client-search]");let selected=0;const rows=()=>[...grid.querySelectorAll("[data-client-row]:not([hidden])")],select=index=>{const list=rows();if(!list.length)return;selected=Math.max(0,Math.min(index,list.length-1));grid.querySelectorAll("[data-client-row]").forEach(row=>row.classList.remove("selected"));list[selected].classList.add("selected");list[selected].scrollIntoView({block:"nearest"})};const move=event=>{if(event.key==="ArrowDown"){event.preventDefault();select(selected+1)}else if(event.key==="ArrowUp"){event.preventDefault();select(selected-1)}else if(event.key==="Home"){event.preventDefault();select(0)}else if(event.key==="End"){event.preventDefault();select(rows().length-1)}else if(event.key==="Enter"&&rows()[selected]){event.preventDefault();rows()[selected].click()}else if(event.key==="Escape"){event.preventDefault();dialog.close()}};search.addEventListener("keydown",move);grid.addEventListener("keydown",move);grid.querySelectorAll("[data-client-row]").forEach(row=>row.addEventListener("click",()=>{selected=rows().indexOf(row);select(selected)}));search.addEventListener("input",()=>setTimeout(()=>select(0),0));document.querySelector("[data-open-clients]").addEventListener("click",()=>setTimeout(()=>select(0),0))});</script>
<script>document.addEventListener("DOMContentLoaded",()=>{const dialog=document.querySelector("[data-client-dialog]"),rows=[...dialog.querySelectorAll("[data-client-row]")],sites=document.querySelector("[data-sites]");rows.forEach(row=>row.onclick=null);dialog.querySelector("[data-confirm-client]").addEventListener("click",async()=>{const row=dialog.querySelector("[data-client-row].selected");if(!row)return;document.querySelector("[data-client-id]").value=row.dataset.code;document.querySelector("[data-client-code]").value=String(row.dataset.code).padStart(5,"0");document.querySelector("[data-client-name]").value=row.dataset.name;dialog.close();sites.replaceChildren(new Option("Caricamento…",""));try{const response=await fetch(`?handler=CustomerData&customerId=${encodeURIComponent(row.dataset.code)}`),data=await response.json();sites.replaceChildren(...data.sites.map(site=>new Option(site.label,site.id||"")))}catch{sites.replaceChildren(new Option("",""))}});rows.forEach(row=>row.addEventListener("dblclick",()=>dialog.querySelector("[data-confirm-client]").click()))});</script>
<script>window.addEventListener("message",async event=>{if(event.origin!==location.origin||event.data?.type!=="skylab-customer-saved")return;const data=event.data,dialog=document.querySelector("[data-new-client-dialog]"),sites=document.querySelector("[data-sites]");document.querySelector("[data-client-id]").value=data.code;document.querySelector("[data-client-code]").value=String(data.code).padStart(5,"0");document.querySelector("[data-client-name]").value=data.name;dialog.close();dialog.querySelector("iframe").src="/Clienti/Edit?modal=true";sites.replaceChildren(new Option("Caricamento…",""));try{const response=await fetch(`?handler=CustomerData&customerId=${encodeURIComponent(data.code)}`),result=await response.json();sites.replaceChildren(...result.sites.map(site=>new Option(site.label,site.id||"")))}catch{sites.replaceChildren(new Option("",""))}});</script>
