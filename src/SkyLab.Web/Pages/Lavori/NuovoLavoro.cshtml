<script>document.addEventListener("DOMContentLoaded",()=>{const customers=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Clienti.Select(x=>new{code=x.Code,name=x.Name}))),articles=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Articoli.Select(x=>new{code=x.Code,description=x.Description}))),clientCode=document.querySelector("[data-client-code]"),clientId=document.querySelector("[data-client-id]"),clientName=document.querySelector("[data-client-name]"),articleCode=document.querySelector("[data-article-code]"),articleDescription=document.querySelector("[data-article-description]"),sites=document.querySelector("[data-sites]");const enterBlur=(field)=>field.addEventListener("keydown",event=>{if(event.key==="Enter"){event.preventDefault();field.blur()}});clientCode.addEventListener("input",()=>clientCode.value=clientCode.value.replace(/\D/g,""));clientCode.addEventListener("change",async()=>{const row=customers.find(x=>Number(x.code)===Number(clientCode.value));if(!row){clientId.value="";clientName.value="";sites.replaceChildren(new Option("",""));return}clientCode.value=String(row.code).padStart(5,"0");clientId.value=row.code;clientName.value=row.name;try{const response=await fetch(`?handler=CustomerData&customerId=${encodeURIComponent(row.code)}`),data=await response.json();sites.replaceChildren(...data.sites.map(site=>new Option(site.label,site.id||"")))}catch{sites.replaceChildren(new Option("",""))}});articleCode.addEventListener("change",()=>{const value=articleCode.value.trim(),row=articles.find(x=>String(x.code).toLocaleLowerCase("it")===value.toLocaleLowerCase("it"));articleDescription.value=row?.description||"";if(row)articleCode.value=row.code});enterBlur(clientCode);enterBlur(articleCode)});</script>
<script>document.addEventListener("DOMContentLoaded",()=>{const form=document.querySelector("#new-work-form");form.addEventListener("submit",event=>{const checks=[{valid:()=>document.querySelector("[data-client-id]").value!=="",message:"Selezionare un cliente valido.",field:document.querySelector("[data-client-code]")},{valid:()=>document.querySelector("[data-article-code]").value.trim()!==""&&document.querySelector("[data-article-description]").value.trim()!=="",message:"Selezionare un articolo valido.",field:document.querySelector("[data-article-code]")},{valid:()=>document.querySelector("[data-new-work-description]").value.trim()!=="",message:"Inserire la prestazione o il lavoro richiesto.",field:document.querySelector("[data-new-work-description]")},{valid:()=>document.querySelector("[data-filter-date-hidden]").value!=="",message:"Inserire la data concordata.",field:document.querySelector("[data-filter-date-display]")}],failed=checks.find(check=>!check.valid());if(!failed)return;event.preventDefault();window.SkyLabMessageBox.show({title:"SkyLab - attenzione",message:failed.message,variant:"error",okText:"OK",onConfirm:()=>failed.field.focus()})})});</script>
<script>document.addEventListener("DOMContentLoaded",()=>{const clientCode=document.querySelector("[data-client-code]"),articleCode=document.querySelector("[data-article-code]"),show=(message,field)=>window.SkyLabMessageBox.show({title:"SkyLab - attenzione",message,variant:"error",okText:"OK",onConfirm:()=>{field.focus();field.select()}});clientCode.addEventListener("change",()=>{if(clientCode.value.trim()&&!document.querySelector("[data-client-id]").value)show("Il codice cliente inserito non è presente in anagrafica.",clientCode)});articleCode.addEventListener("change",()=>{if(articleCode.value.trim()&&!document.querySelector("[data-article-description]").value.trim())show("Il codice articolo inserito non è presente in magazzino.",articleCode)})});</script>
<script>
document.addEventListener("DOMContentLoaded",()=>{
 const source=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Clienti.Select(x=>new{code=x.Code,label=x.Name,city=x.City,category=x.Province})));
 const overlay=document.createElement("div");overlay.className="fish-lookup-overlay";overlay.innerHTML=`<div class="fish-lookup-dialog" role="dialog" aria-modal="true"><div class="fish-lookup-titlebar"><h2>Seleziona cliente</h2><button class="fish-lookup-close" type="button" aria-label="Chiudi"></button></div><div class="fish-lookup-toolbar"><label for="fish-customer-search">Cerca</label><input id="fish-customer-search" class="fish-lookup-search" type="text" autocomplete="off"></div><div class="fish-lookup-table-wrap" tabindex="0"><table class="fish-lookup-table"><colgroup><col style="width:90px"><col><col style="width:220px"><col style="width:200px"></colgroup><thead><tr><th><button type="button" data-fish-sort="code">Codice</button></th><th><button type="button" data-fish-sort="label">Cliente</button></th><th><button type="button" data-fish-sort="city">Città</button></th><th><button type="button" data-fish-sort="category">Provincia</button></th></tr></thead><tbody></tbody></table></div><div class="fish-lookup-actions"><button class="btn btn-primary" type="button" data-fish-confirm>Conferma</button><button class="btn customer-menu-button" type="button" data-fish-cancel>Annulla</button></div></div>`;document.body.append(overlay);
 const wrap=overlay.querySelector(".fish-lookup-table-wrap"),body=overlay.querySelector("tbody"),search=overlay.querySelector(".fish-lookup-search");let rows=[],selected=-1,sortKey="label",sortDirection=1,lastScroll=0,timer=0;
 const esc=v=>String(v??"").replace(/[&<>\"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'\"':"&quot;","'":"&#39;"}[c]));
 const visible=row=>{const rr=row.getBoundingClientRect(),wr=wrap.getBoundingClientRect(),head=wrap.querySelector("thead")?.offsetHeight||0;return rr.top>=wr.top+head+1&&rr.bottom<=wr.bottom-1};
 const ensure=(direction=0)=>{const row=body.querySelector("tr.selected");if(!row)return;const head=wrap.querySelector("thead")?.offsetHeight||0,top=wrap.scrollTop+head,bottom=wrap.scrollTop+wrap.clientHeight,rowTop=row.offsetTop,rowBottom=rowTop+row.offsetHeight;if(direction>=0&&rowBottom>bottom)wrap.scrollTop=rowBottom-wrap.clientHeight+1;else if(direction<=0&&rowTop<top)wrap.scrollTop=Math.max(rowTop-head-1,0)};
 const select=(index,direction=0)=>{if(!rows.length){selected=-1;return}selected=Math.max(0,Math.min(rows.length-1,index));body.querySelectorAll("tr").forEach((row,i)=>row.classList.toggle("selected",i===selected));ensure(direction)};
 const sortRows=()=>rows.sort((a,b)=>(sortKey==="code"?(Number(a.code)-Number(b.code)):String(a[sortKey]||"").localeCompare(String(b[sortKey]||""),"it",{numeric:true,sensitivity:"base"}))*sortDirection);
 const render=()=>{overlay.querySelectorAll("[data-fish-sort]").forEach(button=>{const active=button.dataset.fishSort===sortKey;button.classList.toggle("is-active",active);button.dataset.direction=active?(sortDirection===1?"asc":"desc"):""});body.innerHTML=rows.map((x,i)=>`<tr data-index="${i}" class="${i===selected?"selected":""}"><td>${String(x.code).padStart(5,"0")}</td><td>${esc(x.label)}</td><td>${esc(x.city)}</td><td>${esc(x.category)}</td></tr>`).join("");ensure()};
 const refresh=()=>{const q=search.value.trim().toLocaleLowerCase("it");rows=source.filter(x=>!q||String(x.code).includes(q)||x.label.toLocaleLowerCase("it").includes(q)||x.city.toLocaleLowerCase("it").includes(q));sortRows();selected=rows.length?0:-1;render()};
 const loadSites=async code=>{const sites=document.querySelector("[data-sites]");sites.replaceChildren(new Option("Caricamento…",""));try{const response=await fetch(`?handler=CustomerData&customerId=${encodeURIComponent(code)}`),data=await response.json();sites.replaceChildren(...data.sites.map(site=>new Option(site.label,site.id||"")))}catch{sites.replaceChildren(new Option("",""))}};
 const confirm=()=>{const row=rows[selected];if(!row)return;document.querySelector("[data-client-id]").value=row.code;document.querySelector("[data-client-code]").value=String(row.code).padStart(5,"0");document.querySelector("[data-client-name]").value=row.label;close();loadSites(row.code)};
 const open=()=>{search.value="";refresh();overlay.classList.add("is-open");setTimeout(()=>search.focus(),0)},close=()=>overlay.classList.remove("is-open");
 const key=event=>{if(event.key==="ArrowDown"){event.preventDefault();select(selected+1,1)}else if(event.key==="ArrowUp"){event.preventDefault();select(selected-1,-1)}else if(event.key==="Home"){event.preventDefault();select(0,-1)}else if(event.key==="End"){event.preventDefault();select(rows.length-1,1)}else if(event.key==="Enter"){event.preventDefault();confirm()}else if(event.key==="Escape"){event.preventDefault();close()}else if(event.target!==search&&!event.ctrlKey&&!event.altKey&&!event.metaKey&&event.key.length===1){event.preventDefault();search.value+=event.key;search.dispatchEvent(new Event("input"))}};
 document.addEventListener("click",event=>{if(event.target.closest("[data-open-clients]")){event.preventDefault();event.stopImmediatePropagation();open()}},true);search.addEventListener("input",()=>{clearTimeout(timer);timer=setTimeout(refresh,160)});search.addEventListener("keydown",key);wrap.addEventListener("keydown",key);body.addEventListener("click",event=>{const row=event.target.closest("tr[data-index]");if(row){select(Number(row.dataset.index));wrap.focus({preventScroll:true})}});body.addEventListener("dblclick",confirm);overlay.querySelector("[data-fish-confirm]").onclick=confirm;overlay.querySelector("[data-fish-cancel]").onclick=close;overlay.querySelector(".fish-lookup-close").onclick=close;overlay.querySelector("thead").addEventListener("click",event=>{const button=event.target.closest("[data-fish-sort]");if(!button)return;const next=button.dataset.fishSort;sortDirection=sortKey===next&&sortDirection===1?-1:1;sortKey=next;sortRows();selected=rows.length?0:-1;render()});wrap.addEventListener("scroll",()=>requestAnimationFrame(()=>{const delta=wrap.scrollTop-lastScroll;lastScroll=wrap.scrollTop;if(!delta)return;const current=body.querySelector("tr.selected");if(!current||visible(current))return;const shown=[...body.querySelectorAll("tr")].filter(visible);if(shown.length)select(Number((delta>0?shown[0]:shown.at(-1)).dataset.index),delta>0?1:-1)}),{passive:true});
});
</script>
