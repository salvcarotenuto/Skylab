<style>.planning-work-page{margin-left:50%;padding-top:10px;transform:translateX(-50%);user-select:none;width:min(1380px,calc(100vw - 32px))}.planning-work-heading{box-sizing:border-box;height:96px;margin-bottom:10px;padding:10px 18px}.planning-work-heading h1{font-size:1.65rem;line-height:1.05}.planning-work-heading p{margin:2px 0 0}.planning-heading-actions{align-items:center;display:flex;gap:8px}.planning-heading-actions .btn{width:160px}.planning-work-count{align-items:center;background:#edf4fd;border:1px solid #9db9dc;border-radius:7px;color:#1c477b;display:flex;gap:5px;justify-content:center;min-height:40px;width:150px}.planning-work-filters{align-items:center;background:#fff;border:1px solid #c8d6e6;border-radius:10px;box-shadow:0 4px 10px #22456c14;display:grid;gap:8px;grid-template-columns:240px 185px 185px 290px 175px minmax(210px,1fr);margin-bottom:8px;padding:7px 10px}.planning-work-filters label{align-items:center;color:#263a55;display:grid;font-size:13px;font-weight:400;gap:3px;grid-template-columns:42px 1fr;margin:0}.planning-work-filters label:nth-of-type(3),.planning-work-filters label:nth-of-type(4){grid-template-columns:78px 1fr}.planning-work-filters label>span:first-child{align-items:center;align-self:stretch;background:#b8cbe0;border:1px solid #8a8f98;border-radius:6px;color:#0e1824;display:flex;font-size:13px;font-weight:400;height:34px;padding:0 7px;white-space:nowrap}.planning-work-filters .form-control,.planning-work-filters .form-select{background-color:#fff;border:1px solid #8a8f98;border-radius:6px;color:#000;font-size:13px;font-weight:420;height:34px;min-height:34px;padding-block:3px}.planning-work-filters .micronote-date-control{width:100%}.planning-period-actions{display:grid;gap:6px;grid-template-columns:repeat(3,1fr)}.planning-period-actions .btn{font-size:13px;font-weight:420;height:34px;min-width:0;padding:3px 5px;width:100%}.planning-work-page .planning-list{background:#ffffffc7;border:1px solid #c8d6e6;border-radius:10px;height:calc(100vh - 188px);min-height:260px;overflow-y:auto;padding:10px;scrollbar-gutter:stable}@@media(max-width:1150px){.planning-work-filters{grid-template-columns:repeat(2,minmax(180px,1fr))}.planning-work-search,.planning-period-actions{grid-column:1/-1}}</style>

<style>.planning-work-filters{grid-template-columns:240px 170px 170px 290px 190px minmax(200px,1fr)}.planning-work-filters label{min-width:0}.planning-work-filters label:nth-of-type(1),.planning-work-filters label:nth-of-type(2){grid-template-columns:52px 1fr}.planning-date-readonly{background:#edf2f8!important;box-sizing:border-box;color:#000!important;cursor:default;min-width:0;text-align:center;width:100%}.planning-work-page .btn,.commitment-dialog .btn{align-items:center;display:inline-flex;justify-content:center;text-align:center}.planning-work-page .planning-list{align-content:start;gap:8px;grid-auto-rows:max-content}.planning-work-page .planning-customer>header{align-items:center;display:grid;gap:12px;grid-template-columns:90px minmax(0,1fr) 330px;padding:6px 16px}.planning-customer-code{color:#164f9f;font-variant-numeric:tabular-nums}.planning-work-page .planning-customer h2{font-size:1rem;margin:0}.planning-customer-site{color:#4f6178;white-space:nowrap}.planning-work-page .due-asset{padding:8px 16px}</style>
<section class="planning-work-page">
<header class="planning-heading customer-form-header planning-work-heading">
    <div class="module-title-identity"><div class="skylab-header-brand" aria-hidden="true"><img src="~/images/skylab-logo.png" alt="" /></div><div><p class="eyebrow">Lavorazione · Pianificazione</p><h1>Interventi in scadenza</h1><p>Manutenzioni e revisioni da trasformare in lavori programmati.</p></div></div>
    <div class="planning-heading-actions"><span class="planning-work-count"><strong>@Model.TotaleMacchine</strong> scadenze</span><a class="btn customer-menu-button" asp-page="/Index">← Menu principale</a></div>
</header>

@{
    var dal = Model.Dal!.Value.Date;
    var al = Model.Al!.Value.Date;
    var precedenteDal = dal.AddDays(-30);
    var successivoAl = al.AddDays(30);
}
<form method="get" class="planning-work-filters" data-planning-filters>
    <input asp-for="Cerca" type="search" class="form-control planning-work-search" placeholder="Cerca cliente" autocomplete="off" />
    <label><span>Dal</span><span><input name="Dal" type="hidden" value="@dal.ToString("yyyy-MM-dd")"/><input class="form-control planning-date-readonly" type="text" value="@dal.ToString("dd/MM/yyyy")" readonly tabindex="-1"/></span></label>
    <label><span>Al</span><span><input name="Al" type="hidden" value="@al.ToString("yyyy-MM-dd")"/><input class="form-control planning-date-readonly" type="text" value="@al.ToString("dd/MM/yyyy")" readonly tabindex="-1"/></span></label>
    <div class="planning-period-actions"><a class="btn customer-menu-button" asp-route-dal="@precedenteDal.ToString("yyyy-MM-dd")" asp-route-al="@al.ToString("yyyy-MM-dd")" asp-route-cerca="@Model.Cerca" asp-route-tipologia="@Model.Tipologia" asp-route-distretto="@Model.Distretto">← 30 gg.</a><a class="btn customer-menu-button" asp-route-dal="@DateTime.Today.AddDays(-60).ToString("yyyy-MM-dd")" asp-route-al="@DateTime.Today.AddDays(60).ToString("yyyy-MM-dd")" asp-route-cerca="@Model.Cerca" asp-route-tipologia="@Model.Tipologia" asp-route-distretto="@Model.Distretto">Oggi</a><a class="btn customer-menu-button" asp-route-dal="@dal.ToString("yyyy-MM-dd")" asp-route-al="@successivoAl.ToString("yyyy-MM-dd")" asp-route-cerca="@Model.Cerca" asp-route-tipologia="@Model.Tipologia" asp-route-distretto="@Model.Distretto">+ 30 gg. →</a></div>
    <label><span>Tipologia</span><select asp-for="Tipologia" class="form-select"><option value="0">Tutte</option><option value="1">Azienda</option><option value="2">Privato</option></select></label>
    <label><span>Distretto</span><select asp-for="Distretto" class="form-select"><option value="0">Tutti</option>@foreach(var d in Model.Distretti){<option value="@d.Code">@d.Description</option>}</select></label>
</form>

<div class="planning-list">
@if (Model.Clienti.Count == 0 && Model.Straordinari.Count == 0)
{
    <div class="empty-panel"><h2>Nessuna scadenza</h2><p>Non risultano macchine da pianificare nell’intervallo selezionato.</p></div>
}
@foreach (var cliente in Model.Clienti)
{
    <article class="planning-customer">
        <header><strong class="planning-customer-code">@cliente.CustomerId.ToString("00000")</strong><h2>@cliente.CustomerName</h2><span class="planning-customer-site">@cliente.City@if(!string.IsNullOrWhiteSpace(cliente.District)){<text> · @cliente.District</text>}</span></header>
        <div class="due-assets">
        @foreach (var item in cliente.Items)
        {
            <div class="due-asset">
                <div><strong>@(string.IsNullOrWhiteSpace(item.ArticleDescription) ? item.ArticleCode : item.ArticleDescription)</strong><span>@item.ArticleCode · @item.Category</span></div>
                <div><span>Ultimo intervento</span><strong>@(item.LastServiceDate?.ToString("dd/MM/yyyy") ?? "—")</strong></div>
                <div><span>Scadenza prevista</span><strong>@item.DueDate.ToString("dd/MM/yyyy")</strong></div>
                <div><span>Data prenotata</span><strong>@(item.AgreedOn?.ToString("dd/MM/yyyy") ?? "—")</strong>@if(item.AgreedAt is not null){<span>ore @item.AgreedAt.Value.ToString(@"hh\:mm")</span>}</div>
                <div class="due-asset-action">
                    @if(item.CommitmentId is null)
                    {
                        <button class="btn customer-menu-button" type="button" data-acquire-open data-machine="@item.MachineId" data-customer="@item.CustomerId" data-due="@item.DueDate.ToString("yyyy-MM-dd")" data-description="@item.ArticleDescription">Prenota</button>
                    }
                    else if(item.WorkId is null)
                    {
                        <div class="due-asset-buttons">
                            <button class="btn customer-menu-button" type="button" data-acquire-open data-machine="@item.MachineId" data-customer="@item.CustomerId" data-due="@item.DueDate.ToString("yyyy-MM-dd")" data-agreed="@item.AgreedOn?.ToString("yyyy-MM-dd")" data-time="@item.AgreedAt?.ToString(@"hh\:mm")" data-description="@item.CommitmentDescription" data-notes="@item.CommitmentNotes">Modifica</button>
                            <form method="post" asp-page-handler="PrepareWork"><input type="hidden" name="impegnoId" value="@item.CommitmentId"/><button class="btn btn-primary" type="submit">Prepara scheda</button></form>
                        </div>
                    }
                    else
                    {
                        <a class="btn customer-menu-button" asp-page="/Lavori/Scheda" asp-route-id="@item.WorkId">Apri scheda</a>
                    }
                </div>
            </div>
        }
        </div>
    </article>
}
@foreach (var cliente in Model.Straordinari)
{
    <article class="planning-customer">
        <header><strong class="planning-customer-code">@cliente.CustomerId.ToString("00000")</strong><h2>@cliente.CustomerName</h2><span class="planning-customer-site">@cliente.City@if(!string.IsNullOrWhiteSpace(cliente.District)){<text> · @cliente.District</text>}</span></header>
        <div class="due-assets">
        @foreach(var item in cliente.Items)
        {
            <div class="due-asset">
                <div><strong>@item.Description</strong><span>@(item.Origin=="N" ? $"{item.ArticleCode} · Nuovo lavoro" : "Straordinario") · @item.Site</span></div>
                <div><span>Ultimo intervento</span><strong>@(item.LastServiceDate?.ToString("dd/MM/yyyy") ?? "—")</strong></div>
                <div><span>Scadenza prevista</span><strong>@(item.Origin=="N" ? "Nuovo lavoro" : "Straordinaria")</strong></div>
                <div><span>Data prenotata</span><strong>@item.AgreedOn.ToString("dd/MM/yyyy")</strong>@if(item.AgreedAt is not null){<span>ore @item.AgreedAt.Value.ToString(@"hh\:mm")</span>}</div>
                <div class="due-asset-action">
                    @if(item.WorkId is null)
                    {
                        <form method="post" asp-page-handler="PrepareWork"><input type="hidden" name="impegnoId" value="@item.CommitmentId"/><button class="btn btn-primary" type="submit">Prepara scheda</button></form>
                    }
                    else
                    {
                        <a class="btn customer-menu-button" asp-page="/Lavori/Scheda" asp-route-id="@item.WorkId">Apri scheda</a>
                    }
                </div>
            </div>
        }
        </div>
    </article>
}
</div>
</section>

<dialog class="commitment-dialog" data-acquire-dialog><form method="post" asp-page-handler="Acquire"><input type="hidden" asp-for="Dal"/><input type="hidden" asp-for="Al"/><input type="hidden" asp-for="Cerca"/><input type="hidden" asp-for="Tipologia"/><input type="hidden" asp-for="Distretto"/><input type="hidden" name="macchinaId" data-acquire-machine/><input type="hidden" name="clienteId" data-acquire-customer/><input type="hidden" name="scadenza" data-acquire-due/><h2>Prenotazione</h2><div asp-validation-summary="ModelOnly" class="validation-summary text-danger"></div><div class="commitment-fields"><label><span>Intervento</span><input name="descrizione" maxlength="255" data-acquire-description/></label><label class="commitment-compact"><span>Data concordata</span><span class="micronote-date-control" data-date-control><input name="dataIntervento" type="hidden" data-filter-date-hidden data-acquire-date-hidden/><input class="micronote-date-input" type="text" inputmode="numeric" maxlength="10" autocomplete="off" placeholder="gg/mm/aaaa" required aria-required="true" data-filter-date-display data-acquire-date-display/><button class="micronote-date-button" type="button" tabindex="-1" aria-label="Seleziona data concordata" data-date-picker-button></button></span></label><label class="commitment-compact"><span>Ora concordata</span><input name="oraIntervento" type="time" data-acquire-time/></label><label><span>Note</span><input name="note" maxlength="500" data-acquire-notes/></label></div><section class="commitment-availability" data-availability><div class="availability-heading"><strong data-availability-title>Disponibilità per il giorno</strong><div class="availability-heading-actions"><span class="availability-calendar" data-availability-calendar>Selezionare una data</span><button class="availability-agenda-button" type="button" data-agenda-open>⌕ Vedi agenda</button></div></div><div class="availability-metrics"><div class="availability-metric"><span>Operatori operativi</span><strong data-active-operators>—</strong></div><div class="availability-metric"><span>Operatori assegnati</span><strong data-assigned-operators>—</strong></div><div class="availability-metric"><span>Prenotazioni</span><strong data-reservations>—</strong></div><div class="availability-metric"><span>Schede pianificate</span><strong data-planned-works>—</strong></div></div><p class="availability-note">Calendario attuale: sabato, domenica e festività nazionali.</p><div class="availability-list" data-availability-list><div class="availability-empty">Nessun dato caricato.</div></div></section><div class="commitment-actions"><button class="btn customer-menu-button" type="submit">Conferma</button><button class="btn customer-menu-button" type="button" data-acquire-cancel>Annulla</button></div></form></dialog>

<dialog class="planning-agenda-dialog" data-agenda-dialog><header class="agenda-header"><h2>Agenda lavori</h2></header><div class="agenda-filters"><span>Lavori prenotati fino al</span><input type="hidden" data-agenda-to/><input class="agenda-date-readonly" type="text" readonly tabindex="-1" data-agenda-to-display/><button class="btn customer-menu-button" type="button" data-agenda-load>+ 30 gg.</button><span class="agenda-from-today">(Impegni da oggi)</span></div><div class="agenda-grid"><div class="agenda-grid-head"><span>Data</span><span>Ora</span><span>Cliente</span><span>Sede</span><span>Intervento</span><span>Operatore</span><span>Origine</span></div><div data-agenda-rows><div class="agenda-empty">Caricamento…</div></div></div><footer class="agenda-footer"><button class="btn customer-menu-button" type="button" data-agenda-close>Esci</button></footer></dialog>

<script>document.addEventListener("DOMContentLoaded",()=>{const agenda=document.querySelector("[data-agenda-dialog]"),booking=document.querySelector("[data-acquire-dialog]"),toHidden=agenda.querySelector("[data-agenda-to]"),toDisplay=agenda.querySelector("[data-agenda-to-display]"),escape=value=>String(value??"").replace(/[&<>\"']/g,char=>({"&":"&amp;","<":"&lt;",">":"&gt;",'\"':"&quot;","'":"&#39;"}[char])),formatDate=value=>{const part=String(value).slice(0,10).split("-");return part.length===3?`${part[2]}/${part[1]}/${part[0]}`:""},addDays=(value,days)=>{const date=new Date(`${value}T12:00:00`);date.setDate(date.getDate()+days);return `${date.getFullYear()}-${String(date.getMonth()+1).padStart(2,"0")}-${String(date.getDate()).padStart(2,"0")}`};const loadAgenda=async()=>{const to=toHidden.value;agenda.querySelector("[data-agenda-range]").textContent=`Impegni da oggi fino al ${formatDate(to)}`;agenda.querySelector("[data-agenda-rows]").innerHTML='<div class="agenda-empty">Caricamento…</div>';try{const response=await fetch(`@Url.Page("/Lavori/Pianificazione", "Agenda")&to=${encodeURIComponent(to)}`);if(!response.ok)throw new Error();const rows=await response.json();agenda.querySelector("[data-agenda-rows]").innerHTML=rows.length?rows.map(x=>`<div class="agenda-grid-row"><strong>${formatDate(x.date)}</strong><span>${escape(x.time)}</span><span>${escape(x.customer)}</span><span>${escape(x.description)}</span><span>${escape(x.operator||"Da assegnare")}</span><span class="agenda-kind">${escape(x.kind)}</span></div>`).join(""):'<div class="agenda-empty">Nessun impegno nel periodo esaminato.</div>';}catch{agenda.querySelector("[data-agenda-rows]").innerHTML='<div class="agenda-empty">Agenda non disponibile.</div>';}};document.addEventListener("click",event=>{const open=event.target.closest?.("[data-agenda-open]");if(!open)return;event.preventDefault();event.stopImmediatePropagation();const reference=booking.querySelector("[data-acquire-date-hidden]").value||new Date().toISOString().slice(0,10),to=addDays(reference,60);toHidden.value=to;toDisplay.value=formatDate(to);agenda.showModal();loadAgenda()},true);agenda.querySelector("[data-agenda-load]").addEventListener("click",loadAgenda);agenda.querySelector("[data-agenda-close]").addEventListener("click",()=>agenda.close())});</script>
<script>document.addEventListener("DOMContentLoaded",()=>{const booking=document.querySelector("[data-acquire-dialog]"),date=booking.querySelector("[data-acquire-date-hidden]"),display=booking.querySelector("[data-acquire-date-display]"),title=booking.querySelector("[data-availability-title]");const easter=year=>{const a=year%19,b=Math.floor(year/100),c=year%100,d=Math.floor(b/4),e=b%4,f=Math.floor((b+8)/25),g=Math.floor((b-f+1)/3),h=(19*a+b-d-g+15)%30,i=Math.floor(c/4),k=c%4,l=(32+2*e+2*i-h-k)%7,m=Math.floor((a+11*h+22*l)/451),month=Math.floor((h+l-7*m+114)/31),day=(h+l-7*m+114)%31+1;return new Date(year,month-1,day,12)};const isHoliday=value=>{if(value.getDay()===0||value.getDay()===6)return true;const key=`${value.getMonth()+1}-${value.getDate()}`,fixed=["1-1","1-6","4-25","5-1","6-2","8-15","11-1","12-8","12-25","12-26"];if(fixed.includes(key))return true;const monday=easter(value.getFullYear());monday.setDate(monday.getDate()+1);return value.toDateString()===monday.toDateString()};const update=()=>{if(!date.value){title.textContent="Disponibilità per il giorno";title.classList.remove("availability-nonworking");display.classList.remove("availability-nonworking");return}const value=new Date(`${date.value}T12:00:00`),weekday=value.toLocaleDateString("it-IT",{weekday:"long"}),label=weekday.charAt(0).toUpperCase()+weekday.slice(1),closed=isHoliday(value);title.textContent=`Disponibilità per il giorno ${label} ${value.toLocaleDateString("it-IT")}`;title.classList.toggle("availability-nonworking",closed);display.classList.toggle("availability-nonworking",closed)};date.addEventListener("change",update);document.addEventListener("click",event=>{if(event.target.closest?.("[data-acquire-open]"))setTimeout(update,0)});update()});</script>

@section Scripts {<script>document.addEventListener("DOMContentLoaded",()=>{const filters=document.querySelector("[data-planning-filters]"),search=filters?.querySelector("input[type=search]");let timer;filters?.querySelectorAll("select").forEach(control=>control.addEventListener("change",()=>filters.requestSubmit()));search?.addEventListener("input",()=>{clearTimeout(timer);timer=setTimeout(()=>filters.requestSubmit(),300)});const dialog=document.querySelector("[data-acquire-dialog]"),dateHidden=dialog.querySelector("[data-acquire-date-hidden]"),escape=value=>String(value??"").replace(/[&<>\"']/g,char=>({"&":"&amp;","<":"&lt;",">":"&gt;",'\"':"&quot;","'":"&#39;"}[char]));const loadAvailability=async date=>{if(!date)return;const box=dialog.querySelector("[data-availability]"),calendar=box.querySelector("[data-availability-calendar]");calendar.textContent="Caricamento…";calendar.className="availability-calendar";try{const response=await fetch(`@Url.Page("/Lavori/Pianificazione", "Availability")&date=${encodeURIComponent(date)}`);if(!response.ok)throw new Error();const info=await response.json();calendar.textContent=info.calendarStatus;calendar.classList.add(info.isWorkingDay?"is-working":"is-closed");box.querySelector("[data-active-operators]").textContent=info.activeOperators??"Da configurare";box.querySelector("[data-assigned-operators]").textContent=info.assignedOperators;box.querySelector("[data-reservations]").textContent=info.reservations;box.querySelector("[data-planned-works]").textContent=info.plannedWorks;box.querySelector("[data-availability-list]").innerHTML=info.commitments.length?info.commitments.map(x=>`<div class="availability-row"><strong>${escape(x.time)}</strong><span>${escape(x.customer)}</span><span>${escape(x.description)}</span><span>${escape(x.operator||"Da assegnare")}</span></div>`).join(""):'<div class="availability-empty">Nessun impegno per la data selezionata.</div>';}catch{calendar.textContent="Dati non disponibili";calendar.classList.add("is-closed");}};dateHidden.addEventListener("change",()=>loadAvailability(dateHidden.value));document.querySelectorAll("[data-acquire-open]").forEach(button=>button.addEventListener("click",()=>{const due=button.dataset.due||"",agreed=button.dataset.agreed||due,parts=agreed.split("-");dialog.querySelector("[data-acquire-machine]").value=button.dataset.machine;dialog.querySelector("[data-acquire-customer]").value=button.dataset.customer;dialog.querySelector("[data-acquire-due]").value=due;dialog.querySelector("[data-acquire-description]").value=button.dataset.description||"";dialog.querySelector("[data-acquire-notes]").value=button.dataset.notes||"";dialog.querySelector("[data-acquire-time]").value=button.dataset.time||"";dateHidden.value=agreed;dialog.querySelector("[data-acquire-date-display]").value=parts.length===3?`${parts[2]}/${parts[1]}/${parts[0]}`:"";dialog.showModal();loadAvailability(agreed)}));dialog?.querySelector("[data-acquire-cancel]")?.addEventListener("click",()=>dialog.close())});</script><script>document.addEventListener("DOMContentLoaded",()=>{const agenda=document.querySelector("[data-agenda-dialog]"),booking=document.querySelector("[data-acquire-dialog]"),escape=value=>String(value??"").replace(/[&<>\"']/g,char=>({"&":"&amp;","<":"&lt;",">":"&gt;",'\"':"&quot;","'":"&#39;"}[char])),formatDate=value=>{const part=String(value).slice(0,10).split("-");return part.length===3?`${part[2]}/${part[1]}/${part[0]}`:""};booking.querySelector("[data-agenda-open]").addEventListener("click",async()=>{const date=booking.querySelector("[data-acquire-date-hidden]").value;agenda.querySelector("[data-agenda-range]").textContent=`Agenda dal periodo precedente ai 60 giorni successivi al ${formatDate(date)}`;agenda.querySelector("[data-agenda-rows]").innerHTML='<div class="agenda-empty">Caricamento…</div>';agenda.showModal();try{const response=await fetch(`@Url.Page("/Lavori/Pianificazione", "Agenda")&date=${encodeURIComponent(date)}`);if(!response.ok)throw new Error();const rows=await response.json();agenda.querySelector("[data-agenda-rows]").innerHTML=rows.length?rows.map(x=>`<div class="agenda-grid-row"><strong>${formatDate(x.date)}</strong><span>${escape(x.time)}</span><span>${escape(x.customer)}</span><span>${escape(x.description)}</span><span>${escape(x.operator||"Da assegnare")}</span><span class="agenda-kind">${escape(x.kind)}</span></div>`).join(""):'<div class="agenda-empty">Nessun impegno nel periodo esaminato.</div>';}catch{agenda.querySelector("[data-agenda-rows]").innerHTML='<div class="agenda-empty">Agenda non disponibile.</div>';}});agenda.querySelector("[data-agenda-close]").addEventListener("click",()=>agenda.close())});</script>}
