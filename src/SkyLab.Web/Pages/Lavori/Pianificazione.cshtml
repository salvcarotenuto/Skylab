<style>.availability-heading-actions{align-items:center;display:flex;gap:7px}.availability-agenda-button{align-items:center;background:#eef2fb;border:1px solid var(--BlueButton);border-radius:5px;color:#334d8c;display:inline-flex;font-size:12px;height:28px;justify-content:center;padding:0 10px}.availability-agenda-button:hover{background:var(--BlueButton);color:#fff}.planning-agenda-dialog{background:#fff;border:1px solid #6f7784;padding:14px;width:min(980px,calc(100vw - 40px))}.planning-agenda-dialog::backdrop{background:#1e385d66}.agenda-header{align-items:center;background:#6aa4dc;display:flex;height:42px;justify-content:space-between;padding:0 12px}.agenda-header h2{background:transparent;height:auto;line-height:1;margin:0;padding:0}.agenda-header .btn{height:31px;width:110px}.agenda-range{color:#53657c;font-size:12px;margin:8px 2px}.agenda-grid{border:1px solid #8a8f98;max-height:480px;overflow:auto}.agenda-grid-head,.agenda-grid-row{display:grid;gap:8px;grid-template-columns:95px 55px 190px minmax(220px,1fr) 150px 100px}.agenda-grid-head{background:#b8cbe0;font-size:12px;font-weight:600;padding:7px 9px;position:sticky;top:0}.agenda-grid-row{align-items:center;font-size:12px;padding:7px 9px}.agenda-grid-row+.agenda-grid-row{border-top:1px solid #dce4ee}.agenda-grid-row .agenda-kind{color:#53657c;font-size:11px}.agenda-empty{color:#647084;padding:24px;text-align:center}</style>
<style>.agenda-filters{align-items:center;background:#edf2f8;border:1px solid #b8c5d6;display:grid;gap:8px;grid-template-columns:65px 150px 110px;margin:8px 0;padding:7px 9px}.agenda-filters>span:first-child{align-items:center;background:#b8cbe0;border:1px solid #8a8f98;border-radius:5px;display:flex;height:32px;padding:0 8px}.agenda-filters .micronote-date-control{width:150px}.agenda-filters .micronote-date-input{border:1px solid #8a8f98;border-radius:5px;box-sizing:border-box;height:32px;padding-right:30px;text-align:center;width:150px}.agenda-filters .btn{height:32px;width:110px}</style>
