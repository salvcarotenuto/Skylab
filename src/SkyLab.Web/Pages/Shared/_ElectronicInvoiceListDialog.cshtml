@model string
<link rel="stylesheet" href="~/css/electronic-invoice-dialog.css" asp-append-version="true" />

<div class="purchase-invoice-fe-overlay" data-electronic-invoice-dialog hidden>
    <section class="purchase-invoice-fe-dialog" role="dialog" aria-modal="true" aria-label="Lista fatture elettroniche" data-electronic-invoice-path data-electronic-invoice-path-value="@Model" data-mode="server">
        <div class="purchase-invoice-fe-titlebar">
            <span>Lista fatture elettroniche</span>
        </div>
        <div class="purchase-invoice-fe-grid-frame">
            <table class="purchase-invoice-fe-grid">
                <thead>
                    <tr>
                        <th>Nome file</th>
                        <th>Tipo</th>
                        <th>Ultima modifica</th>
                        <th>Dimensione</th>
                    </tr>
                </thead>
                <tbody data-electronic-invoice-files>
                </tbody>
            </table>
        </div>
        <div class="purchase-invoice-fe-preview" data-electronic-invoice-preview-box hidden></div>
        <div class="purchase-invoice-fe-actions">
            <div class="purchase-invoice-fe-search-inline">
                <label>Cerca</label>
                <input type="text" autocomplete="off" data-electronic-invoice-search />
                <button type="button" class="purchase-invoice-fe-clear" data-electronic-invoice-search-clear>X</button>
                <input class="purchase-invoice-fe-count" value="0 file" readonly tabindex="-1" data-electronic-invoice-count />
            </div>
            <button class="button button-primary primary" type="button" data-electronic-invoice-accept>Apri</button>
            <button class="button button-primary primary" type="button" data-electronic-invoice-preview>Visualizza</button>
            <button class="button button-primary primary" type="button" data-electronic-invoice-delete>Elimina</button>
            <button class="button button-secondary secondary" type="button" data-electronic-invoice-close>Annulla</button>
        </div>
    </section>
</div>

<div class="purchase-invoice-xml-overlay" data-electronic-invoice-viewer hidden>
    <section class="purchase-invoice-xml-dialog" role="dialog" aria-modal="true" aria-labelledby="electronicInvoiceXmlTitle" tabindex="-1" data-electronic-invoice-viewer-panel>
        <div class="purchase-invoice-fe-titlebar">
            <span id="electronicInvoiceXmlTitle" data-electronic-invoice-viewer-title>Visualizzazione fattura elettronica</span>
        </div>
        <iframe class="purchase-invoice-xml-frame"
                title="Visualizzazione fattura elettronica"
                data-electronic-invoice-viewer-frame></iframe>
        <div class="purchase-invoice-xml-actions">
            <button class="button button-secondary secondary" type="button" data-electronic-invoice-viewer-close>Chiudi</button>
        </div>
    </section>
</div>
<script src="~/js/electronic-invoice-dialog-preview.js" asp-append-version="true"></script>
