@model IReadOnlyList<SkyLab.Web.Models.CustomerListItem>
<style>.customer-lookup-dialog{background:#e7edf5;border:1px solid #7d8794;box-shadow:0 18px 42px #14202d3d;display:grid;gap:8px;grid-template-rows:38px 34px minmax(0,1fr) 40px;height:485px;padding:10px;width:min(900px,calc(100vw - 80px))}.customer-lookup-dialog:not([open]){display:none}.customer-lookup-dialog::backdrop{background:#0f172a3d}.customer-lookup-title{align-items:center;background:#6aa4dc;display:flex;padding:0 10px}.customer-lookup-title h2{font-size:16px;font-weight:500;margin:0}.customer-lookup-toolbar{align-items:center;display:grid;gap:6px;grid-template-columns:82px minmax(0,1fr)}.customer-lookup-toolbar label{align-items:center;background:#b8cbe0;border:1px solid #8a8f98;display:flex;font-size:12px;height:30px;padding:0 8px}.customer-lookup-toolbar input{border:1px solid #8a8f98;border-radius:5px;height:30px;padding:0 8px}.customer-lookup-grid{background:#fff;border:1px solid #8a8f98;outline:none;overflow:auto}.customer-lookup-grid table{border-collapse:collapse;font-size:13px;width:100%}.customer-lookup-grid thead{position:sticky;top:0;z-index:1}.customer-lookup-grid th{background:#b8cbe0;padding:0;text-align:left}.customer-lookup-grid th button{background:transparent;border:0;font-weight:600;height:32px;padding:0 9px;text-align:left;width:100%}.customer-lookup-grid td{border-bottom:1px solid #d7e0ea;padding:7px 9px}.customer-lookup-grid th:first-child,.customer-lookup-grid td:first-child{width:100px}.customer-lookup-grid th:last-child,.customer-lookup-grid td:last-child{width:210px}.customer-lookup-grid tbody tr.selected{background:#d9e8fb;box-shadow:inset 3px 0 var(--BlueButton)}.customer-lookup-actions{display:flex;gap:8px;justify-content:flex-end}.customer-lookup-actions .btn{height:34px;width:120px}</style>
<style>
.customer-lookup-dialog{background:#e7edf5;border:1px solid #7d8794;box-shadow:0 18px 42px #141e2d3d;cursor:default;display:grid;gap:8px;grid-template-rows:30px 34px minmax(0,1fr) 38px;height:512px;padding:10px;user-select:none;width:min(970px,calc(100vw - 80px))}.customer-lookup-dialog:not([open]){display:none}.customer-lookup-dialog::backdrop{background:#0f172a3d}.customer-lookup-title{align-items:center;background:#a9c0d8;color:#0f2236;display:flex;padding:0 10px}.customer-lookup-title h2{font-size:14px;font-weight:600;margin:0}.customer-lookup-toolbar{align-items:center;display:grid;gap:6px;grid-template-columns:82px minmax(0,1fr)}.customer-lookup-toolbar label{align-items:center;background:#b8cbe0;color:#253447;display:flex;font-size:12px;font-weight:600;height:28px;padding:0 8px}.customer-lookup-toolbar input{border:1px solid #aeb7c4;border-radius:0;box-sizing:border-box;cursor:text;height:28px;padding:0 8px;user-select:text}.customer-lookup-grid{background:#fff;border:1px solid #9aa5b3;min-height:0;outline:none;overflow:auto}.customer-lookup-grid table{border-collapse:collapse;color:#000;font-family:"Microsoft Sans Serif","Segoe UI",Arial,sans-serif;font-size:14px;font-weight:400;table-layout:fixed;user-select:none;width:100%}.customer-lookup-grid thead{position:sticky;top:0;z-index:1}.customer-lookup-grid th{background:#b8cbe0;border-bottom:1px solid #8aa8c5;color:#17395c;font-size:12px;font-weight:400;height:31px;padding:0;text-align:left}.customer-lookup-grid th button{align-items:center;background:transparent;border:0;color:inherit;cursor:pointer;display:inline-flex;font:inherit;gap:5px;height:100%;padding:0 8px;text-align:left;width:100%}.customer-lookup-grid th button:after{color:var(--BlueNote);content:"";font-size:10px;min-width:10px}.customer-lookup-grid th button.is-active[data-direction=asc]:after{content:"^"}.customer-lookup-grid th button.is-active[data-direction=desc]:after{content:"v"}.customer-lookup-grid th,.customer-lookup-grid td{border-right:1px solid #c8d1dc;box-sizing:border-box;padding:0 8px;white-space:nowrap}.customer-lookup-grid tbody tr,.customer-lookup-grid tbody td{height:30px}.customer-lookup-grid td{border-bottom:1px solid #dbe2ea;overflow:hidden;text-overflow:ellipsis}.customer-lookup-grid th:first-child,.customer-lookup-grid td:first-child{text-align:center;width:100px}.customer-lookup-grid th:last-child,.customer-lookup-grid td:last-child{width:250px}.customer-lookup-grid tbody tr.selected td{background:#b8d2ee;color:#102b49}.customer-lookup-actions{align-items:center;display:flex;gap:8px;justify-content:flex-end}.customer-lookup-actions .btn{height:34px;width:120px}
</style>
<style>.customer-lookup-dialog{height:min(537px,calc(100vh - 80px))}</style>
<dialog class="customer-lookup-dialog" data-customer-lookup>
    <div class="customer-lookup-title"><h2>Clienti</h2></div>
    <div class="customer-lookup-toolbar"><label for="customer-lookup-search">Cerca</label><input id="customer-lookup-search" type="search" autocomplete="off" data-customer-search/></div>
    <div class="customer-lookup-grid" tabindex="0" data-customer-grid><table><thead><tr><th><button type="button" data-sort="code">Codice</button></th><th><button type="button" data-sort="name">Nome</button></th><th><button type="button" data-sort="site">Sede</button></th></tr></thead><tbody data-customer-rows></tbody></table></div>
    <div class="customer-lookup-actions"><button class="btn btn-primary" type="button" data-customer-select>Conferma</button><button class="btn customer-menu-button" type="button" data-customer-cancel>Annulla</button></div>
    <script type="application/json" data-customer-source>@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(x=>new{code=x.Code,name=x.Name,site=string.Join(" · ",new[]{x.City,x.Province}.Where(v=>!string.IsNullOrWhiteSpace(v)))})))</script>
</dialog>
<script>
document.addEventListener("DOMContentLoaded",()=>{
 const dialog=document.querySelector("[data-customer-lookup]");
 if(!dialog||dialog.dataset.initialized)return;
 dialog.dataset.initialized="true";
 const grid=dialog.querySelector("[data-customer-grid]"),body=dialog.querySelector("[data-customer-rows]"),search=dialog.querySelector("[data-customer-search]"),source=JSON.parse(dialog.querySelector("[data-customer-source]").textContent);
 let rows=[],selected=0,sortKey="name",sortDirection=1,lastScroll=0,scrollFrame=0,wheelFrame=0;
 const esc=value=>String(value??"").replace(/[&<>\"']/g,char=>({"&":"&amp;","<":"&lt;",">":"&gt;",'\"':"&quot;","'":"&#39;"}[char]));
 const rowVisible=row=>{const table=grid.querySelector("table"),g=grid.getBoundingClientRect(),h=table?.querySelector("thead")?.offsetHeight||0,r=row.getBoundingClientRect();return r.top>=g.top+h+1&&r.bottom<=g.bottom-1};
 const fullyVisible=()=>[...body.querySelectorAll("tr[data-index]")].filter(rowVisible);
 const ensure=(direction=0)=>{const row=body.querySelector("tr.selected"),table=grid.querySelector("table");if(!row||!table)return;const h=table.querySelector("thead")?.offsetHeight||0,top=grid.scrollTop+h,bottom=grid.scrollTop+grid.clientHeight,rowTop=row.offsetTop,rowBottom=rowTop+row.offsetHeight;if(rowTop>=top&&rowBottom<=bottom)return;if(direction>=0&&rowBottom>bottom){grid.scrollTop=rowBottom-grid.clientHeight+1;return}if(direction<=0&&rowTop<top)grid.scrollTop=Math.max(rowTop-h-1,0)};
 const select=(index,direction=0)=>{if(!rows.length)return;selected=Math.max(0,Math.min(index,rows.length-1));body.querySelectorAll("tr").forEach((row,i)=>row.classList.toggle("selected",i===selected));ensure(direction)};
 const selectFromScroll=delta=>{if(!delta)return;const current=body.querySelector("tr.selected");if(!current||rowVisible(current))return;const shown=fullyVisible();if(shown.length)select(Number((delta>0?shown[0]:shown.at(-1)).dataset.index),delta>0?1:-1)};
 const render=()=>body.innerHTML=rows.map((row,index)=>`<tr data-index="${index}" class="${index===selected?"selected":""}"><td>${String(row.code).padStart(5,"0")}</td><td>${esc(row.name)}</td><td>${esc(row.site)}</td></tr>`).join("");
 const refresh=()=>{const term=search.value.trim().toLocaleLowerCase("it");rows=source.filter(row=>!term||String(row.code).includes(term)||row.name.toLocaleLowerCase("it").includes(term)||row.site.toLocaleLowerCase("it").includes(term));rows.sort((a,b)=>(sortKey==="code"?Number(a.code)-Number(b.code):String(a[sortKey]||"").localeCompare(String(b[sortKey]||""),"it",{numeric:true,sensitivity:"base"}))*sortDirection);dialog.querySelectorAll("[data-sort]").forEach(button=>{const active=button.dataset.sort===sortKey;button.classList.toggle("is-active",active);button.dataset.direction=active?(sortDirection===1?"asc":"desc"):""});selected=0;render()};
 const confirm=()=>{const customer=rows[selected];if(!customer)return;dialog.close();dialog.dispatchEvent(new CustomEvent("skylab:customer-selected",{bubbles:true,detail:customer}))};
 const key=event=>{if(event.key==="ArrowDown"){event.preventDefault();select(selected+1,1)}else if(event.key==="ArrowUp"){event.preventDefault();select(selected-1,-1)}else if(event.key==="Home"){event.preventDefault();select(0,-1)}else if(event.key==="End"){event.preventDefault();select(rows.length-1,1)}else if(event.key==="Enter"){event.preventDefault();confirm()}else if(event.key==="Escape"){event.preventDefault();dialog.close()}};
 document.querySelectorAll("[data-customer-lookup-open]").forEach(button=>button.addEventListener("click",()=>{search.value="";grid.scrollTop=0;lastScroll=0;refresh();dialog.showModal();requestAnimationFrame(()=>{grid.scrollTop=0;lastScroll=0;select(0)});setTimeout(()=>search.focus(),0)}));
 search.addEventListener("input",refresh);search.addEventListener("keydown",key);grid.addEventListener("keydown",key);
 body.addEventListener("click",event=>{const row=event.target.closest("tr[data-index]");if(row){select(Number(row.dataset.index));grid.focus({preventScroll:true})}});body.addEventListener("dblclick",confirm);
 dialog.querySelector("[data-customer-select]").addEventListener("click",confirm);dialog.querySelector("[data-customer-cancel]").addEventListener("click",()=>dialog.close());
 dialog.querySelectorAll("[data-sort]").forEach(button=>button.addEventListener("click",()=>{const next=button.dataset.sort;sortDirection=sortKey===next?-sortDirection:1;sortKey=next;refresh()}));
 grid.addEventListener("scroll",()=>{if(scrollFrame)cancelAnimationFrame(scrollFrame);scrollFrame=requestAnimationFrame(()=>{scrollFrame=0;const current=grid.scrollTop,delta=current-lastScroll;lastScroll=current;selectFromScroll(delta)})},{passive:true});
 grid.addEventListener("wheel",event=>{if(wheelFrame)cancelAnimationFrame(wheelFrame);const delta=event.deltaY;wheelFrame=requestAnimationFrame(()=>{wheelFrame=requestAnimationFrame(()=>{wheelFrame=0;selectFromScroll(delta)})})},{passive:true});
});
</script>
