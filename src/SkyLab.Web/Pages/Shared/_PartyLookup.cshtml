@model SkyLab.Web.Models.PartyLookupModel
@{var kind=Model.Kind.ToUpperInvariant();var title=kind switch{"F"=>"Fornitori","A"=>"Agenti","B"=>"Banche",_=>"Clienti"};var searchId=$"party-lookup-search-{kind.ToLowerInvariant()}";}
<style>
.customer-lookup-dialog{background:#fff;border:1px solid #6f7784;box-shadow:0 14px 32px rgba(20,34,54,.32);box-sizing:border-box;color:#0f1724;cursor:default;display:grid;font-family:"Microsoft Sans Serif","Segoe UI",Arial,sans-serif;grid-template-rows:15px 30px 15px 395px 15px 34px 15px;height:521px;margin:auto;max-height:calc(100vh - 32px);overflow:hidden;padding:0;user-select:none;width:min(1100px,calc(100vw - 32px))}.customer-lookup-dialog:not([open]){display:none}.customer-lookup-dialog::backdrop{background:#0f172a3d}.customer-lookup-title{align-items:center;background:#6aa4dc;color:#0b1420;display:flex;grid-row:2;height:30px;margin:0 15px}.customer-lookup-title h2{font-size:14px;font-weight:600;line-height:30px;margin:0;text-indent:28px}.customer-lookup-grid{background:#fff;border:1px solid #8a8f98;box-sizing:border-box;grid-row:4;height:395px;margin:0 15px;min-height:0;outline:none;overflow:auto}.customer-lookup-grid table{border-collapse:collapse;border-spacing:0;color:#000;font-family:"Microsoft Sans Serif","Segoe UI",Arial,sans-serif;font-size:13px;font-weight:520;table-layout:fixed;user-select:none;width:100%}.customer-lookup-grid thead{position:sticky;top:0;z-index:1}.customer-lookup-grid th{background:linear-gradient(#c7d7e8,#b8cbe0 52%,#a9bed6);border:1px solid #c8ced8;box-shadow:inset 0 1px rgba(255,255,255,.85),inset 0 -1px rgba(100,118,140,.35);color:#17395c;font-size:12px;font-weight:400;height:28px;padding:0;text-align:left;vertical-align:middle}.customer-lookup-grid th button{align-items:center;background:transparent;border:0;color:inherit;cursor:pointer;display:inline-flex;font:inherit;gap:5px;height:100%;justify-content:flex-start;text-align:left;text-indent:6px;width:100%}.customer-lookup-grid th button:after{color:#164f9f;content:"";font-size:10px;min-width:10px}.customer-lookup-grid th button.is-active[data-direction=asc]:after{content:"▲"}.customer-lookup-grid th button.is-active[data-direction=desc]:after{content:"▼"}.customer-lookup-grid th,.customer-lookup-grid td{box-sizing:border-box;white-space:nowrap}.customer-lookup-grid tbody tr,.customer-lookup-grid tbody td{height:27px}.customer-lookup-grid td{border:1px solid #c8ced8;cursor:default;line-height:27px;overflow:hidden;padding:0;text-indent:6px;text-overflow:ellipsis;vertical-align:middle}.customer-lookup-grid th:first-child,.customer-lookup-grid td:first-child{text-align:center;text-indent:0;width:104px}.customer-lookup-grid th:last-child,.customer-lookup-grid td:last-child{box-sizing:border-box;padding-right:22px;width:330px}.customer-lookup-grid tbody tr:hover td{background:#e3edf8}.customer-lookup-grid tbody tr.selected td,.customer-lookup-grid tbody tr.selected:hover td{background:#b8cbe0;color:#0b2f55}.customer-lookup-footer{align-items:center;display:grid;gap:8px;grid-row:6;grid-template-columns:62px minmax(260px,1fr) 72px 90px minmax(0,1fr) 120px 120px;height:34px;margin:0 15px}.customer-lookup-footer label,.customer-lookup-records-label{align-items:center;background:#b8cbe0;border:1px solid #8a8f98;border-radius:5px;box-sizing:border-box;color:#0e1824;display:flex;font-size:13px;font-weight:500;height:30px;text-indent:8px}.customer-lookup-footer input{background:#fff;border:1px solid #8a8f98;box-sizing:border-box;color:#000;cursor:text;font-family:"Microsoft Sans Serif","Segoe UI",Arial,sans-serif;font-size:13px;font-weight:520;height:30px;text-indent:8px;user-select:text}.customer-lookup-footer input:focus{border-color:#164f9f;box-shadow:none;outline:none}.customer-lookup-records-count{align-items:center;background:rgb(230,230,240);border:1px solid #8a8f98;box-sizing:border-box;display:flex;font-size:13px;font-weight:700;height:30px;justify-content:center}.customer-lookup-actions{display:flex;gap:8px;grid-column:6/8;justify-content:flex-end}.customer-lookup-actions .btn{font-size:12px;font-weight:500;height:34px;min-height:34px;width:120px}.customer-lookup-actions .btn-primary{background:#4b64a5;border:1px solid #4b64a5;color:#fff}.customer-lookup-actions .customer-menu-button{background:#fff;border:1px solid #4b64a5;color:#173b65}.customer-lookup-actions .btn:hover{background:#244f8d;color:#fff}
</style>
<dialog class="customer-lookup-dialog" data-party-lookup="@kind">
 <div class="customer-lookup-title"><h2>@title</h2></div>
 <div class="customer-lookup-grid" tabindex="0" data-party-grid><table><thead><tr><th><button type="button" data-sort="code">Codice</button></th><th><button type="button" data-sort="name">Nome</button></th><th><button type="button" data-sort="site">Sede</button></th></tr></thead><tbody data-party-rows></tbody></table></div>
 <div class="customer-lookup-footer"><label for="@searchId">Cerca</label><input id="@searchId" type="search" autocomplete="off" data-party-search/><div class="customer-lookup-records-label">Records</div><div class="customer-lookup-records-count" data-party-count>0</div><div></div><div class="customer-lookup-actions"><button class="btn btn-primary" type="button" data-party-select>OK</button><button class="btn customer-menu-button" type="button" data-party-cancel>Annulla</button></div></div>
 <script type="application/json" data-party-source>@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Items.Select(x=>new{code=x.Code,name=x.Name,site=string.Join(" · ",new[]{x.City,x.Province}.Where(v=>!string.IsNullOrWhiteSpace(v)))})))</script>
</dialog>
<script>
document.addEventListener("DOMContentLoaded",()=>{
 const kind="@kind",dialog=document.querySelector(`[data-party-lookup="${kind}"]`);if(!dialog||dialog.dataset.initialized)return;dialog.dataset.initialized="true";
 const grid=dialog.querySelector("[data-party-grid]"),body=dialog.querySelector("[data-party-rows]"),search=dialog.querySelector("[data-party-search]"),count=dialog.querySelector("[data-party-count]"),source=JSON.parse(dialog.querySelector("[data-party-source]").textContent);let rows=[],selected=0,sortKey="name",sortDirection=1,lastScroll=0,scrollFrame=0,wheelFrame=0,selectionTarget="";
 const esc=value=>String(value??"").replace(/[&<>"']/g,char=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[char]));
 const rowVisible=row=>{const table=grid.querySelector("table"),g=grid.getBoundingClientRect(),h=table?.querySelector("thead")?.offsetHeight||0,r=row.getBoundingClientRect();return r.top>=g.top+h+1&&r.bottom<=g.bottom-1},fullyVisible=()=>[...body.querySelectorAll("tr[data-index]")].filter(rowVisible);
 const ensure=(direction=0)=>{const row=body.querySelector("tr.selected"),table=grid.querySelector("table");if(!row||!table)return;const h=table.querySelector("thead")?.offsetHeight||0,top=grid.scrollTop+h,bottom=grid.scrollTop+grid.clientHeight,rowTop=row.offsetTop,rowBottom=rowTop+row.offsetHeight;if(rowTop>=top&&rowBottom<=bottom)return;if(direction>=0&&rowBottom>bottom)grid.scrollTop=rowBottom-grid.clientHeight+1;else if(direction<=0&&rowTop<top)grid.scrollTop=Math.max(rowTop-h-1,0)};
 const select=(index,direction=0)=>{if(!rows.length)return;selected=Math.max(0,Math.min(index,rows.length-1));body.querySelectorAll("tr").forEach((row,i)=>row.classList.toggle("selected",i===selected));ensure(direction)},selectFromScroll=delta=>{if(!delta)return;const current=body.querySelector("tr.selected");if(!current||rowVisible(current))return;const shown=fullyVisible();if(shown.length)select(Number((delta>0?shown[0]:shown.at(-1)).dataset.index),delta>0?1:-1)};
 const render=()=>body.innerHTML=rows.map((row,index)=>`<tr data-index="${index}" class="${index===selected?"selected":""}"><td>${String(row.code).padStart(5,"0")}</td><td>${esc(row.name)}</td><td>${esc(row.site)}</td></tr>`).join("");
 const refresh=()=>{const term=search.value.trim().toLocaleLowerCase("it");rows=source.filter(row=>!term||String(row.code).includes(term)||row.name.toLocaleLowerCase("it").includes(term)||row.site.toLocaleLowerCase("it").includes(term));rows.sort((a,b)=>(sortKey==="code"?Number(a.code)-Number(b.code):String(a[sortKey]||"").localeCompare(String(b[sortKey]||""),"it",{numeric:true,sensitivity:"base"}))*sortDirection);dialog.querySelectorAll("[data-sort]").forEach(button=>{const active=button.dataset.sort===sortKey;button.classList.toggle("is-active",active);button.dataset.direction=active?(sortDirection===1?"asc":"desc"):""});selected=0;if(count)count.textContent=rows.length;render()};
 const confirm=()=>{const party=rows[selected];if(!party)return;dialog.close();dialog.dispatchEvent(new CustomEvent("skylab:party-selected",{bubbles:true,detail:{...party,kind,target:selectionTarget}}))},key=event=>{if(event.key==="ArrowDown"){event.preventDefault();select(selected+1,1)}else if(event.key==="ArrowUp"){event.preventDefault();select(selected-1,-1)}else if(event.key==="Home"){event.preventDefault();select(0,-1)}else if(event.key==="End"){event.preventDefault();select(rows.length-1,1)}else if(event.key==="Enter"){event.preventDefault();confirm()}else if(event.key==="Escape"){event.preventDefault();dialog.close()}};
 document.querySelectorAll(`[data-party-lookup-open="${kind}"]`).forEach(button=>button.addEventListener("click",()=>{selectionTarget=button.dataset.partyLookupTarget||"";search.value="";grid.scrollTop=0;lastScroll=0;refresh();dialog.showModal();requestAnimationFrame(()=>{grid.scrollTop=0;lastScroll=0;select(0)});setTimeout(()=>search.focus(),0)}));search.addEventListener("input",refresh);search.addEventListener("keydown",key);grid.addEventListener("keydown",key);body.addEventListener("click",event=>{const row=event.target.closest("tr[data-index]");if(row){select(Number(row.dataset.index));grid.focus({preventScroll:true})}});body.addEventListener("dblclick",confirm);dialog.querySelector("[data-party-select]").addEventListener("click",confirm);dialog.querySelector("[data-party-cancel]").addEventListener("click",()=>dialog.close());dialog.querySelectorAll("[data-sort]").forEach(button=>button.addEventListener("click",()=>{const next=button.dataset.sort;sortDirection=sortKey===next?-sortDirection:1;sortKey=next;refresh()}));grid.addEventListener("scroll",()=>{if(scrollFrame)cancelAnimationFrame(scrollFrame);scrollFrame=requestAnimationFrame(()=>{scrollFrame=0;const current=grid.scrollTop,delta=current-lastScroll;lastScroll=current;selectFromScroll(delta)})},{passive:true});grid.addEventListener("wheel",event=>{if(wheelFrame)cancelAnimationFrame(wheelFrame);const delta=event.deltaY;wheelFrame=requestAnimationFrame(()=>{wheelFrame=requestAnimationFrame(()=>{wheelFrame=0;selectFromScroll(delta)})})},{passive:true});
});
</script>
