@page
@model SkyLab.Web.Pages.FattureVendita.IndexModel
@{
    ViewData["Title"] = "Lista fatture di vendita";
    ViewData["BodyClass"] = "sales-invoices-module";
    ViewData["HideFooter"] = true;
    var customerLookup = new SkyLab.Web.Models.PartyLookupModel("C", Model.Customers);
}
<link rel="stylesheet" href="~/css/sales-invoice-list.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/electronic-invoice-dialog.css" asp-append-version="true" />

<section class="list-page purchase-invoices-page sales-invoices-page" data-sales-invoices>
    <header class="list-titlebar">
        <a class="list-title-identity" asp-page="/Index"><span class="list-title-layout"><span class="skylab-header-brand" aria-hidden="true"><img src="~/images/skylab-logo.png" alt="" /></span><span><strong>Fatture di vendita</strong><small>SkyLab · Lista fatture di vendita</small></span></span></a>
        <div class="list-title-actions purchase-invoices-actions"><span class="list-records-box purchase-invoices-records"><strong>@Model.Invoices.Count</strong><span>record</span></span><a class="btn btn-primary" asp-page="Edit" asp-route-azione="2">Nuova</a><button class="btn customer-menu-button" type="button">Modifica</button><button class="btn customer-menu-button" type="button">Cancella</button><button class="btn customer-menu-button" type="button">Stampa</button><button class="btn customer-menu-button" type="button" data-sales-invoice-send-fe>Invia FE</button><button class="btn customer-menu-button" type="button" data-sales-invoice-mark-rejected>Rifiuto SDI</button><button class="btn customer-menu-button purchase-invoices-print-button" type="button">Stampa lista</button><a class="btn customer-menu-button" asp-page="/Index">Esci</a></div>
    </header>
    <section class="list-panel purchase-invoices-filter-panel">
        <form class="list-toolbar purchase-invoices-filters" method="get" data-sales-invoice-filters><div class="purchase-invoices-filter-row">
            <div class="list-filter-field purchase-invoices-year-filter"><label for="sales-invoice-year">Anno</label><div><select id="sales-invoice-year" name="year" onchange="this.form.submit()"><option value=""></option>@foreach (var year in Model.Years) { <option value="@year" selected="@(year == Model.SelectedYear)">@year</option> }</select></div></div>
            <div class="list-filter-field purchase-invoices-month-filter"><label for="sales-invoice-month">Mese</label><div><select id="sales-invoice-month" name="month" onchange="this.form.submit()"><option value=""></option><option value="1" selected="@(Model.SelectedMonth == 1)">Gennaio</option><option value="2" selected="@(Model.SelectedMonth == 2)">Febbraio</option><option value="3" selected="@(Model.SelectedMonth == 3)">Marzo</option><option value="4" selected="@(Model.SelectedMonth == 4)">Aprile</option><option value="5" selected="@(Model.SelectedMonth == 5)">Maggio</option><option value="6" selected="@(Model.SelectedMonth == 6)">Giugno</option><option value="7" selected="@(Model.SelectedMonth == 7)">Luglio</option><option value="8" selected="@(Model.SelectedMonth == 8)">Agosto</option><option value="9" selected="@(Model.SelectedMonth == 9)">Settembre</option><option value="10" selected="@(Model.SelectedMonth == 10)">Ottobre</option><option value="11" selected="@(Model.SelectedMonth == 11)">Novembre</option><option value="12" selected="@(Model.SelectedMonth == 12)">Dicembre</option></select></div></div>
            <div class="list-filter-field purchase-invoices-type-filter"><label for="sales-invoice-type">Tipo</label><div><select id="sales-invoice-type" name="causeCode" onchange="this.form.submit()"><option value=""></option><option value="30" selected="@(Model.SelectedCauseCode == 30)">Fatture di vendita</option><option value="31" selected="@(Model.SelectedCauseCode == 31)">Note di addebito</option><option value="32" selected="@(Model.SelectedCauseCode == 32)">Note di accredito</option></select></div></div>
            <div class="list-filter-field purchase-invoices-supplier-filter"><label for="sales-invoice-customer">Cliente</label><div class="purchase-invoices-supplier-controls"><input id="sales-invoice-customer" name="customerCode" value="@(Model.SelectedCustomerCode?.ToString("00000") ?? "")" inputmode="numeric" maxlength="5" autocomplete="off" /><input id="sales-invoice-customer-name" class="sales-invoice-customer-name" value="@Model.SelectedCustomerName" aria-label="Nome cliente" readonly tabindex="-1" onmousedown="event.preventDefault()" /><button class="lookup-button" type="button" title="Seleziona cliente" aria-label="Seleziona cliente" data-party-lookup-open="C" data-party-lookup-target="sales-invoices"></button></div></div>
            <div class="list-filter-field purchase-invoices-store-filter"><label for="sales-invoice-store">Un. locale</label><div><select id="sales-invoice-store" name="storeCode" onchange="this.form.submit()"><option value=""></option>@foreach (var store in Model.Stores) { <option value="@store.Code" selected="@(store.Code == Model.SelectedStoreCode)">@store.Description</option> }</select></div></div>
        </div></form>
    </section>
    <section class="list-panel purchase-invoices-list-panel"><div class="list-grid-frame purchase-invoices-grid-frame"><table class="list-grid purchase-invoices-grid sales-invoices-grid"><thead><tr><th>Partita</th><th>Numero</th><th>Data</th><th>Tipo</th><th>Cliente</th><th>Nome</th><th>Imponibile</th><th>IVA</th><th>Totale</th><th>Stato</th><th>F.E.</th></tr></thead><tbody>@foreach (var invoice in Model.Invoices) { <tr data-invoice-id="@invoice.Id" data-invoice-status="@invoice.ElectronicInvoiceStatus"><td>@invoice.Code.ToString("000000")</td><td>@invoice.DocumentNumber</td><td>@invoice.DocumentDate?.ToString("dd/MM/yyyy")</td><td>@invoice.CauseDescription</td><td>@invoice.CustomerCode.ToString("00000")</td><td>@invoice.CustomerName</td><td>@invoice.Taxable.ToString("N2")</td><td>@invoice.Vat.ToString("N2")</td><td>@invoice.Total.ToString("N2")</td><td>@invoice.ElectronicInvoiceStatus</td><td class="sales-invoice-fe-cell">@if (!string.IsNullOrWhiteSpace(invoice.ElectronicInvoiceName)) { <span class="sales-invoice-fe-name" title="@invoice.ElectronicInvoiceName">@invoice.ElectronicInvoiceName</span><button class="btn customer-menu-button sales-invoice-fe-view" type="button" data-sales-invoice-fe-view="/api/sales-invoices/@invoice.Id/electronic-view" title="Vedi file XML">Vedi</button> }</td></tr> }</tbody></table><div class="sales-history-empty" hidden="@(Model.Invoices.Count > 0)">Nessuna fattura trovata.</div></div></section>
</section>
<partial name="_PartyLookup" model="customerLookup" />
<partial name="_ElectronicInvoiceListDialog" model="string.Empty" />

@section Scripts {
    <script src="~/js/sales-invoice-customer-filter.js" asp-append-version="true"></script>
    <script src="~/js/sales-invoices-list.js" asp-append-version="true"></script>
    <script src="~/js/sales-invoice-rejection.js" asp-append-version="true"></script>
    <script src="~/js/sales-invoice-fe-view.js" asp-append-version="true"></script>
}
