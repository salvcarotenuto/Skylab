@page "{code:int?}"
@model SkyLab.Web.Pages.Utenti.EditModel
@{ ViewData["Title"]=Model.IsNew?"Nuovo utente":"Scheda utente"; ViewData["HideFooter"]=true; }
<section class="customer-form-page user-form-page">
 <header class="customer-form-header"><div class="module-title-identity"><div class="skylab-header-brand"><img src="~/images/skylab-logo.png" alt=""/></div><div><h1>@(Model.IsNew?"Nuovo utente":"Scheda utente")</h1><p>@(Model.IsNew?"Inserimento di una nuova anagrafica.":$"Codice {Model.AppUser.Code:000}")</p></div></div><div class="customer-form-toolbar"><button class="btn btn-primary" type="button" data-user-save>Salva</button><a class="btn btn-outline-primary" asp-page="./Index">Annulla</a></div></header>
 <form id="user-form" method="post" class="customer-entity-form user-form-panel" data-enter-navigation><input asp-for="AppUser.Code" type="hidden"/><input asp-for="Azione" type="hidden"/><div asp-validation-summary="ModelOnly" class="validation-summary"></div>
  <fieldset class="form-frame"><legend>Anagrafica</legend><div class="form-grid form-grid-4">
   <div class="field field-code"><label>Codice</label><input class="code-display" readonly value="@(Model.IsNew?Model.DisplayCode.ToString("000"):Model.AppUser.Code.ToString("000"))"/></div>
   <div class="field"><label asp-for="AppUser.LastName"></label><input asp-for="AppUser.LastName" autofocus/><span asp-validation-for="AppUser.LastName"></span></div><div class="field"><label asp-for="AppUser.FirstName"></label><input asp-for="AppUser.FirstName"/><span asp-validation-for="AppUser.FirstName"></span></div><div class="field"><label asp-for="AppUser.Gender"></label><select asp-for="AppUser.Gender"><option value=""></option><option value="M">Maschile</option><option value="F">Femminile</option></select></div>
   <div class="field field-span-2"><label asp-for="AppUser.City"></label><input asp-for="AppUser.City"/></div><div class="field field-span-2"><label asp-for="AppUser.Address"></label><input asp-for="AppUser.Address"/></div><div class="field field-span-2"><label asp-for="AppUser.TaxCode"></label><input asp-for="AppUser.TaxCode" class="text-uppercase"/></div><div class="field field-check"><div class="check-button-field"><input asp-for="AppUser.IsActive"/><label class="check-text" asp-for="AppUser.IsActive">Utente attivo</label><label class="check-button-wrap" for="AppUser_IsActive"></label></div></div>
  </div></fieldset>
  <fieldset class="form-frame"><legend>Accesso</legend><div class="form-grid form-grid-4">
   <div class="field field-span-2"><label asp-for="AppUser.UserName"></label><input asp-for="AppUser.UserName" autocomplete="off"/><span asp-validation-for="AppUser.UserName"></span></div><div class="field field-span-2"><label asp-for="AppUser.Password"></label><div class="password-control"><input asp-for="AppUser.Password" type="password" value="@Model.AppUser.Password" autocomplete="off" data-password-input/><button type="button" data-password-view>Vedi</button></div><span asp-validation-for="AppUser.Password"></span></div>
   <div class="field field-span-2"><label asp-for="AppUser.TypeCode"></label><select asp-for="AppUser.TypeCode" asp-items="Model.Types"><option value=""></option></select><span asp-validation-for="AppUser.TypeCode"></span></div><div class="field field-span-2"><label asp-for="AppUser.QualificationCode"></label><select asp-for="AppUser.QualificationCode" asp-items="Model.Qualifications"><option value=""></option></select></div><div class="field field-span-2"><label asp-for="AppUser.LocationCode"></label><select asp-for="AppUser.LocationCode" asp-items="Model.Locations"><option value=""></option></select></div><div class="field field-check"><div class="check-button-field"><input asp-for="AppUser.IsLocked"/><label class="check-text" asp-for="AppUser.IsLocked">Utente bloccato</label><label class="check-button-wrap" for="AppUser_IsLocked"></label></div></div>
  </div></fieldset>
  <fieldset class="form-frame"><legend>Recapiti</legend><div class="form-grid form-grid-4"><div class="field field-span-2"><label asp-for="AppUser.Phone"></label><input asp-for="AppUser.Phone"/></div><div class="field field-span-2"><label asp-for="AppUser.Email"></label><input asp-for="AppUser.Email" type="email"/><span asp-validation-for="AppUser.Email"></span></div></div></fieldset>
 </form>
</section>
@section Scripts{<partial name="_ValidationScriptsPartial"/><script src="~/js/form-enter-navigation.js" asp-append-version="true"></script><script src="~/js/user-edit.js" asp-append-version="true"></script>}
