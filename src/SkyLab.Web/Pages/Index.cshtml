@page
@model IndexModel
@{ ViewData["Title"]="Menu principale"; }
@if(ViewContext.HttpContext.Session.GetInt32(SkyLab.Web.Services.ApplicationAuthService.UserCodeKey) is > 0){<form method="post" asp-page="/Login" asp-page-handler="Logout" style="display:flex;justify-content:flex-end;margin-bottom:6px"><button class="btn btn-outline-primary" type="submit">Cambia utente</button></form>}
<section class="app-heading"><div class="app-identity"><span class="app-logo"><img src="~/images/skylab-logo.png" alt="" /></span><div><p class="eyebrow">Gestione assistenza tecnica integrata</p><h1>SkyLab</h1><p class="app-subtitle">Impianti, interventi, magazzino e amministrazione</p></div></div><div class="session-panel"><p class="app-version">Versione 0.1 · ASP.NET Core 10</p><dl class="session-summary"><div><dt>Ambiente</dt><dd>Sviluppo</dd></div><div><dt>Esercizio</dt><dd>@Model.Esercizio</dd></div><div><dt>Stato</dt><dd>Migrazione</dd></div></dl></div></section>
<nav class="quick-links" aria-label="Accessi rapidi">@foreach(var link in Model.QuickLinks){if(link.Page is not null){<a class="quick-link" asp-page="@link.Page"><span class="quick-icon">@link.Icon</span><span>@link.Label</span></a>}else{<button class="quick-link is-pending" disabled title="Funzione in preparazione"><span class="quick-icon">@link.Icon</span><span>@link.Label</span></button>}}</nav>
<section class="menu-shell"><div class="menu-intro"><div><p class="eyebrow">Area di lavoro</p><h2>Menu principale</h2></div><p>Le voci attenuate saranno attivate durante la migrazione.</p></div><div class="main-menu">@foreach(var menuArea in Model.Sections){<details class="menu-section @menuArea.AccentClass" id="menu-@menuArea.Id"><summary><span class="section-icon">@menuArea.Icon</span><span class="section-title">@menuArea.Title</span><span class="section-toggle"></span></summary><div class="section-content">@foreach(var group in menuArea.Groups){<section class="menu-group @(menuArea.Id=="tabelle"&&group.Title=="Altre"?"menu-group-one-row":"")"><h3>@group.Title</h3><div class="menu-items">@foreach(var item in group.Items){if(item.Page is not null){<a class="menu-link" asp-page="@item.Page">@item.Label</a>}else{<span class="menu-link is-pending" title="Funzione in preparazione">@item.Label</span>}}</div></section>}</div></details>}</div></section>
<style>
 .menu-group-one-row{grid-column:1/-1}
 .menu-group-one-row .menu-items{grid-template-columns:repeat(4,minmax(0,1fr))}
 @@media(max-width:760px){.menu-group-one-row .menu-items{grid-template-columns:1fr}}
</style>
@section Scripts { <script src="~/js/menu-pairs.js" asp-append-version="true"></script> }
