@page
@model SkyLab.Web.Pages.Fornitori.IndexModel
@{ViewData["Title"]="Fornitori";ViewData["HideFooter"]=true;}
<section class="supplier-list-page" data-supplier-page>
 <header class="planning-heading supplier-heading customer-form-header"><div class="module-title-identity"><div class="skylab-header-brand"><img src="~/images/skylab-logo.png" alt="" /></div><div><p class="eyebrow">Anagrafiche · Fornitori</p><h1>Fornitori</h1><p>Ricerca e gestione dei fornitori.</p></div></div><div class="supplier-title-actions"><span class="supplier-count-box"><strong data-count>@Model.Items.Count</strong> record</span><a class="btn btn-primary" asp-page="Edit">Nuovo</a><button class="btn customer-menu-button" type="button" data-action="edit">Modifica</button><button class="btn customer-menu-button" type="button" data-action="delete">Elimina</button><button class="btn customer-menu-button" type="button" data-action="print">Stampa lista</button><a class="btn customer-menu-button" asp-page="/Index">Esci</a></div></header>
 <div class="supplier-toolbar"><label>Cerca</label><div class="supplier-search-wrap"><input class="form-control" value="@Model.Cerca" placeholder="Nome, codice o partita IVA" autofocus data-search/><button type="button" data-clear hidden>×</button></div></div>
 <div class="supplier-grid-frame"><table class="supplier-grid"><thead><tr><th data-key="code">Codice</th><th data-key="name">Nome</th><th data-key="city">Sede</th><th data-key="province">Prov.</th><th data-key="vat">Partita IVA</th><th data-key="phone">Telefono</th><th data-key="email">E-mail</th><th data-key="unit">Unità locale</th></tr></thead><tbody>@foreach(var x in Model.Items){<tr tabindex="0" data-row data-code="@x.Code" data-label="@x.Name" data-edit="@Url.Page("Edit",new{id=x.Code})" data-code-sort="@x.Code" data-name="@x.Name" data-city="@x.City" data-province="@x.Province" data-vat="@x.VatNumber" data-phone="@x.Phone" data-email="@x.Email" data-unit="@x.LocalUnit"><td class="code-cell">@x.Code.ToString("00000")</td><td>@x.Name</td><td>@x.City</td><td>@x.Province</td><td>@x.VatNumber</td><td>@x.Phone</td><td>@x.Email</td><td>@x.LocalUnit</td></tr>}</tbody></table><div class="supplier-empty" data-empty hidden>Nessun fornitore trovato.</div></div>
 <form method="post" asp-page-handler="Delete" data-delete-form hidden><input name="code" data-delete-code/></form>
 <div class="supplier-preview" data-preview hidden><section role="dialog" aria-modal="true"><header><strong>Anteprima lista fornitori</strong><span data-print-summary></span><div><button type="button" data-zoom-out>−</button><span data-zoom-label>100%</span><button type="button" data-zoom-in>+</button><button type="button" data-print-now>Stampa</button><button type="button" data-pdf>File PDF</button><button type="button" data-close>Chiudi</button></div></header><div class="supplier-preview-viewport"><div data-document></div></div></section></div>
</section>
@section Scripts{<script src="~/js/suppliers-list.js" asp-append-version="true"></script>}
