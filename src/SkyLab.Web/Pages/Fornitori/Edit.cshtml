@page "{id:int?}"
@model SkyLab.Web.Pages.Fornitori.EditModel
@{var isNew=Model.Fornitore.Code==0;ViewData["Title"]=isNew?"Nuovo fornitore":"Scheda fornitore";}
<section class="module-page form-module-page supplier-form-page data-form-skin">
 <header class="module-header"><div class="module-title-identity"><a class="module-title-logo" asp-page="Index" style="display:flex;flex:0 0 72px;width:72px;height:72px;overflow:hidden"><img src="~/images/skylab-logo.png" width="72" height="72" style="display:block;width:72px!important;height:72px!important;max-width:72px!important;max-height:72px!important;object-fit:contain" alt=""/></a><div><h1>@(isNew?"Nuovo fornitore":"Scheda fornitore")</h1><p>@(isNew?"Inserimento di una nuova anagrafica.":$"Codice {Model.Fornitore.Code:00000}")</p></div></div><div class="top-actions"><button class="button primary" type="submit" form="supplier-form" data-supplier-save>Salva</button><a class="button secondary" asp-page="Index">Annulla</a></div></header>
 <div class="supplier-form-panel"><form id="supplier-form" method="post" class="entity-form" autocomplete="off"><input asp-for="Fornitore.Code" type="hidden"/><div asp-validation-summary="ModelOnly" class="validation-summary"></div>
  <fieldset class="form-frame compact-frame"><legend>Anagrafica</legend><div class="form-grid form-grid-4 form-frame-grid">
   <div class="field field-code"><label>Codice</label><input class="readonly-field code-display" value="@(isNew?"Automatico":Model.Fornitore.Code.ToString("00000"))" readonly tabindex="-1"/></div><div class="field field-span-2"><label asp-for="Fornitore.Name">Denominazione</label><input asp-for="Fornitore.Name" autofocus/><span asp-validation-for="Fornitore.Name"></span></div><div class="field"><label asp-for="Fornitore.TaxCode">Codice fiscale</label><input asp-for="Fornitore.TaxCode" class="text-uppercase"/></div>
   <div class="supplier-location-row"><div class="field"><label asp-for="Fornitore.City">Città</label><input asp-for="Fornitore.City"/></div><div class="field field-small"><label asp-for="Fornitore.Province">Provincia</label><input asp-for="Fornitore.Province" class="text-uppercase" maxlength="2"/></div><div class="field"><label asp-for="Fornitore.PostalCode">CAP</label><input asp-for="Fornitore.PostalCode"/></div><div class="field"><label asp-for="Fornitore.VatNumber">Partita IVA</label><input asp-for="Fornitore.VatNumber"/></div></div>
   <div class="field field-span-2 field-address"><label asp-for="Fornitore.Street">Indirizzo</label><div class="address-pair"><input asp-for="Fornitore.Street"/><input asp-for="Fornitore.StreetNumber" placeholder="Civico"/></div></div><div class="field field-country"><label asp-for="Fornitore.CountryCode">Nazione</label><select asp-for="Fornitore.CountryCode" asp-items="Model.Countries"><option value=""></option></select></div>
  </div></fieldset>
  <fieldset class="form-frame compact-frame"><legend>Recapiti</legend><div class="form-grid form-grid-4 form-frame-grid"><div class="field field-span-2"><label asp-for="Fornitore.Phone1">Telefono</label><input asp-for="Fornitore.Phone1" type="tel"/></div><div class="field field-span-2"><label asp-for="Fornitore.Phone2">Cellulare</label><input asp-for="Fornitore.Phone2" type="tel"/></div><div class="supplier-email-row"><div class="field"><label asp-for="Fornitore.Email">E-mail</label><input asp-for="Fornitore.Email" type="email"/></div><div class="field"><label asp-for="Fornitore.CertifiedEmail">PEC</label><input asp-for="Fornitore.CertifiedEmail" type="email"/></div></div><div class="field field-span-2"><label asp-for="Fornitore.Contact">Contatto</label><input asp-for="Fornitore.Contact"/></div><div class="field field-span-2"><label asp-for="Fornitore.Website">Sito web</label><input asp-for="Fornitore.Website"/></div></div></fieldset>
  <fieldset class="form-frame compact-frame"><legend>Dati gestionali</legend><div class="form-grid form-grid-4 form-frame-grid"><div class="field field-span-2"><label asp-for="Fornitore.LocalUnitCode">Unità locale</label><select asp-for="Fornitore.LocalUnitCode" asp-items="Model.LocalUnits"><option value=""></option></select></div><div class="field field-span-2"><label asp-for="Fornitore.AccountCode">Contropartita</label><input asp-for="Fornitore.AccountCode"/></div><div class="field"><label asp-for="Fornitore.PaymentCode">Pagamento</label><select asp-for="Fornitore.PaymentCode" asp-items="Model.Payments"><option value=""></option></select></div><div class="field"><label asp-for="Fornitore.BankCode">Banca</label><select asp-for="Fornitore.BankCode" asp-items="Model.Banks"><option value=""></option></select></div><div class="field field-span-2"><label asp-for="Fornitore.Iban">IBAN</label><input asp-for="Fornitore.Iban" class="text-uppercase"/></div><div class="field field-span-4"><label asp-for="Fornitore.Notes">Annotazioni</label><input asp-for="Fornitore.Notes"/></div></div></fieldset>
 </form></div>
</section>
@section Scripts{<partial name="_ValidationScriptsPartial"/><script src="~/js/supplier-save-progress.js" asp-append-version="true"></script>}
