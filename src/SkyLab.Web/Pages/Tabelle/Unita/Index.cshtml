@page
@model SkyLab.Web.Pages.Tabelle.Unita.IndexModel
@{ViewData["Title"]="Unità di misura";ViewData["HideFooter"]=true;}
<link rel="stylesheet" href="~/css/units.css" asp-append-version="true" />
<section class="unit-list-page" data-unit-page data-open-editor="@(!ViewData.ModelState.IsValid?"true":"false")">
 <header class="planning-heading unit-heading customer-form-header"><div class="module-title-identity"><div class="skylab-header-brand"><img src="~/images/skylab-logo.png" alt="" /></div><div><p class="eyebrow">Tabelle · Magazzino</p><h1>Unità di misura</h1><p>Gestione delle unità di misura articolo.</p></div></div><div class="unit-title-actions"><span class="unit-count-box"><strong data-unit-count>@Model.Items.Count</strong> record</span><button class="btn btn-primary" type="button" data-unit-new>Nuovo</button><button class="btn customer-menu-button" type="button" data-unit-edit disabled>Modifica</button><button class="btn customer-menu-button" type="button" data-unit-delete disabled>Elimina</button><a class="btn customer-menu-button" asp-page="/Index">Esci</a></div></header>
 <div class="unit-toolbar"><label for="unit-search">Cerca</label><div class="unit-search-wrap"><input id="unit-search" placeholder="Codice o descrizione" autocomplete="off" autofocus data-unit-search/><button type="button" aria-label="Pulisci filtro" data-unit-clear hidden>×</button></div></div>
 <div class="unit-grid-frame"><table class="unit-grid"><thead><tr><th data-unit-sort="code">Codice</th><th data-unit-sort="description">Descrizione</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr tabindex="0" data-unit-row data-code="@item.Code" data-description="@item.Label"><td>@item.Code</td><td>@item.Label</td></tr>}</tbody></table><div class="unit-empty" data-unit-empty hidden>Nessuna unità di misura corrisponde al filtro impostato.</div></div>
 <dialog class="unit-editor" data-unit-dialog><form method="post" asp-page-handler="Save" data-unit-form><div class="unit-editor-title"><h2>Unità di misura</h2></div><div class="unit-editor-body"><div class="field"><label asp-for="Unita.Code">Codice</label><input asp-for="Unita.Code" maxlength="4" autocomplete="off" data-unit-code/><span asp-validation-for="Unita.Code"></span></div><div class="field"><label asp-for="Unita.Description">Descrizione</label><input asp-for="Unita.Description" autocomplete="off" data-unit-description/><span asp-validation-for="Unita.Description"></span></div><input asp-for="IsNew" type="hidden" data-unit-is-new/></div><footer><button class="btn btn-primary" type="submit" data-unit-save>Salva</button><button class="btn customer-menu-button" type="button" data-unit-cancel>Annulla</button></footer></form></dialog>
 <form method="post" asp-page-handler="Delete" data-unit-delete-form hidden><input name="code" data-unit-delete-code/></form>
 @if(!string.IsNullOrWhiteSpace(Model.Message)){<span hidden data-page-message data-message-text="@Model.Message"></span>}
</section>
@section Scripts{<partial name="_ValidationScriptsPartial"/><script src="~/js/units-list.js" asp-append-version="true"></script>}
