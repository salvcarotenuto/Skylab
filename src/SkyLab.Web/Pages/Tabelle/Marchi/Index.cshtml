@page
@model SkyLab.Web.Pages.Tabelle.Marchi.IndexModel
@{ViewData["Title"]="Marchi";ViewData["HideFooter"]=true;}
<link rel="stylesheet" href="~/css/brands.css" asp-append-version="true" />
<section class="brand-list-page" data-brand-page data-open-editor="@(!ViewData.ModelState.IsValid?"true":"false")">
 <header class="planning-heading brand-heading customer-form-header"><div class="module-title-identity"><div class="skylab-header-brand"><img src="~/images/skylab-logo.png" alt="" /></div><div><p class="eyebrow">Tabelle · Magazzino</p><h1>Marchi</h1><p>Gestione dei marchi articolo.</p></div></div><div class="brand-title-actions"><span class="brand-count-box"><strong data-brand-count>@Model.Items.Count</strong> record</span><button class="btn btn-primary" type="button" data-brand-new>Nuovo</button><button class="btn customer-menu-button" type="button" data-brand-edit disabled>Modifica</button><button class="btn customer-menu-button" type="button" data-brand-delete disabled>Elimina</button><a class="btn customer-menu-button" asp-page="/Index">Esci</a></div></header>
 <div class="brand-toolbar"><label for="brand-search">Cerca</label><div class="brand-search-wrap"><input id="brand-search" placeholder="Codice o descrizione" autocomplete="off" autofocus data-brand-search/><button type="button" aria-label="Pulisci filtro" data-brand-clear hidden>×</button></div></div>
 <div class="brand-grid-frame"><table class="brand-grid"><thead><tr><th data-brand-sort="code">Codice</th><th data-brand-sort="description">Descrizione</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr tabindex="0" data-brand-row data-code="@item.Id" data-description="@item.Label"><td>@item.Id.ToString("000")</td><td>@item.Label</td></tr>}</tbody></table><div class="brand-empty" data-brand-empty hidden>Nessun marchio corrisponde al filtro impostato.</div></div>
 <dialog class="brand-editor" data-brand-dialog><form method="post" asp-page-handler="Save" data-brand-form><div class="brand-editor-title"><h2>Marchio di magazzino</h2></div><div class="brand-editor-body"><div class="field"><label for="brand-code">Codice</label><input id="brand-code" value="@(Model.IsNew?"Automatico":Model.Marchio.Code.ToString("000"))" readonly tabindex="-1" data-brand-code/><input asp-for="Marchio.Code" type="hidden" data-brand-code-value/></div><div class="field"><label asp-for="Marchio.Description">Descrizione</label><input asp-for="Marchio.Description" autocomplete="off" data-brand-description/><span asp-validation-for="Marchio.Description"></span></div><input asp-for="IsNew" type="hidden" data-brand-is-new/></div><footer><button class="btn btn-primary" type="submit" data-brand-save>Salva</button><button class="btn customer-menu-button" type="button" data-brand-cancel>Annulla</button></footer></form></dialog>
 <form method="post" asp-page-handler="Delete" data-brand-delete-form hidden><input name="code" data-brand-delete-code/></form>
 @if(!string.IsNullOrWhiteSpace(Model.Message)){<span hidden data-page-message data-message-text="@Model.Message"></span>}
</section>
@section Scripts{<partial name="_ValidationScriptsPartial"/><script src="~/js/brands-list.js" asp-append-version="true"></script>}
