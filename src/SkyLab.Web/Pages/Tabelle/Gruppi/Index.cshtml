@page
@model SkyLab.Web.Pages.Tabelle.Gruppi.IndexModel
@{ViewData["Title"]="Gruppi di magazzino";ViewData["HideFooter"]=true;}
<link rel="stylesheet" href="~/css/groups.css" asp-append-version="true" />
<section class="group-list-page" data-group-page data-open-editor="@(!ViewData.ModelState.IsValid?"true":"false")">
 <header class="planning-heading group-heading customer-form-header"><div class="module-title-identity"><div class="skylab-header-brand"><img src="~/images/skylab-logo.png" alt="" /></div><div><p class="eyebrow">Tabelle · Magazzino</p><h1>Gruppi di magazzino</h1><p>Gestione dei gruppi articolo.</p></div></div><div class="group-title-actions"><span class="group-count-box"><strong data-group-count>@Model.Items.Count</strong> record</span><button class="btn btn-primary" type="button" data-group-new>Nuovo</button><button class="btn customer-menu-button" type="button" data-group-edit disabled>Modifica</button><button class="btn customer-menu-button" type="button" data-group-delete disabled>Elimina</button><a class="btn customer-menu-button" asp-page="/Index">Esci</a></div></header>
 <div class="group-toolbar"><label for="group-search">Cerca</label><div class="group-search-wrap"><input id="group-search" placeholder="Codice o descrizione" autocomplete="off" autofocus data-group-search/><button type="button" aria-label="Pulisci filtro" data-group-clear hidden>×</button></div></div>
 <div class="group-grid-frame"><table class="group-grid"><thead><tr><th data-group-sort="code">Codice</th><th data-group-sort="description">Descrizione</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr tabindex="0" data-group-row data-code="@item.Id" data-description="@item.Label"><td>@item.Id.ToString("000")</td><td>@item.Label</td></tr>}</tbody></table><div class="group-empty" data-group-empty hidden>Nessun gruppo corrisponde al filtro impostato.</div></div>
 <dialog class="group-editor" data-group-dialog><form method="post" asp-page-handler="Save" data-group-form><div class="group-editor-title"><h2>Gruppo di magazzino</h2></div><div class="group-editor-body"><div class="field"><label for="group-code">Codice</label><input id="group-code" value="@(Model.IsNew?"Automatico":Model.Gruppo.Code.ToString("000"))" readonly tabindex="-1" data-group-code/><input asp-for="Gruppo.Code" type="hidden" data-group-code-value/></div><div class="field"><label asp-for="Gruppo.Description">Descrizione</label><input asp-for="Gruppo.Description" autocomplete="off" data-group-description/><span asp-validation-for="Gruppo.Description"></span></div><input asp-for="IsNew" type="hidden" data-group-is-new/></div><footer><button class="btn btn-primary" type="submit" data-group-save>Salva</button><button class="btn customer-menu-button" type="button" data-group-cancel>Annulla</button></footer></form></dialog>
 <form method="post" asp-page-handler="Delete" data-group-delete-form hidden><input name="code" data-group-delete-code/></form>
 @if(!string.IsNullOrWhiteSpace(Model.Message)){<span hidden data-page-message data-message-text="@Model.Message"></span>}
</section>
@section Scripts{<partial name="_ValidationScriptsPartial"/><script src="~/js/groups-list.js" asp-append-version="true"></script>}
