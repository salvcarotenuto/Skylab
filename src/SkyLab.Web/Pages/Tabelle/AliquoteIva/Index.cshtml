@page
@using System.Globalization
@model SkyLab.Web.Pages.Tabelle.AliquoteIva.IndexModel
@{ViewData["Title"]="Aliquote IVA";ViewData["HideFooter"]=true;static string ShortFe(string text)=>string.IsNullOrWhiteSpace(text)?"":text.Length<=58?text:text[..55]+"...";}
<link rel="stylesheet" href="~/css/vat-codes.css" asp-append-version="true" />
<section class="vat-list-page" data-vat-page data-open-editor="@(!ViewData.ModelState.IsValid?"true":"false")">
 <header class="planning-heading vat-heading customer-form-header"><div class="module-title-identity"><div class="skylab-header-brand"><img src="~/images/skylab-logo.png" alt="" /></div><div><p class="eyebrow">Tabelle · Contabili</p><h1>Aliquote IVA</h1><p>Gestione dei codici e delle aliquote IVA.</p></div></div><div class="vat-title-actions"><span class="vat-count-box"><strong data-vat-count>@Model.Items.Count</strong> record</span><button class="btn btn-primary" type="button" data-vat-new>Nuovo</button><button class="btn customer-menu-button" type="button" data-vat-edit disabled>Modifica</button><button class="btn customer-menu-button" type="button" data-vat-delete disabled>Elimina</button><a class="btn customer-menu-button" asp-page="/Index">Esci</a></div></header>
 <div class="vat-toolbar"><label for="vat-search">Cerca</label><div class="vat-search-wrap"><input id="vat-search" placeholder="Codice, descrizione o natura" autocomplete="off" autofocus data-vat-search/><button type="button" aria-label="Pulisci filtro" data-vat-clear hidden>×</button></div></div>
 <div class="vat-grid-frame"><table class="vat-grid"><thead><tr><th data-vat-sort="code">Codice</th><th data-vat-sort="description">Descrizione</th><th data-vat-sort="rate">Aliquota</th><th data-vat-sort="deduction">Detrazione</th><th data-vat-sort="nature">Codice FE</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr tabindex="0" data-vat-row data-code="@item.Code" data-description="@item.Description" data-rate="@item.Rate.ToString(CultureInfo.InvariantCulture)" data-deduction="@item.Deduction.ToString(CultureInfo.InvariantCulture)" data-nature="@item.Nature"><td>@item.Code</td><td>@item.Description</td><td>@item.Rate.ToString("N2")</td><td>@item.Deduction.ToString("N2")</td><td>@item.Nature</td></tr>}</tbody></table><div class="vat-empty" data-vat-empty hidden>Nessun codice IVA corrisponde al filtro impostato.</div></div>
 <dialog class="vat-editor" data-vat-dialog><form method="post" asp-page-handler="Save" data-vat-form><div class="vat-editor-title"><h2>Aliquota IVA</h2></div><div class="vat-editor-body"><div class="field"><label asp-for="CodiceIva.Code">Codice</label><input asp-for="CodiceIva.Code" maxlength="12" autocomplete="off" data-vat-code/><span asp-validation-for="CodiceIva.Code"></span></div><div class="field"><label asp-for="CodiceIva.Description">Descrizione</label><textarea asp-for="CodiceIva.Description" autocomplete="off" data-vat-description></textarea><span asp-validation-for="CodiceIva.Description"></span></div><div class="field"><label asp-for="CodiceIva.Rate">Aliquota</label><input asp-for="CodiceIva.Rate" inputmode="decimal" data-decimal-field data-decimal-digits="2" data-decimal-integer-digits="3" data-decimal-zero="fixed" data-vat-rate/><span asp-validation-for="CodiceIva.Rate"></span></div><div class="field"><label asp-for="CodiceIva.Deduction">Detrazione</label><input asp-for="CodiceIva.Deduction" inputmode="decimal" data-decimal-field data-decimal-digits="2" data-decimal-integer-digits="3" data-decimal-zero="fixed" data-vat-deduction/><span asp-validation-for="CodiceIva.Deduction"></span></div><div class="field"><label asp-for="CodiceIva.Nature">Codice FE</label><select asp-for="CodiceIva.Nature" data-vat-nature><option value=""></option>@foreach(var natura in Model.NatureCodes){<option value="@natura.Code" title="@natura.Label">@natura.Code · @ShortFe(natura.Label)</option>}</select><span asp-validation-for="CodiceIva.Nature"></span></div><input asp-for="IsNew" type="hidden" data-vat-is-new/></div><footer><button class="btn btn-primary" type="submit" data-vat-save>Salva</button><button class="btn customer-menu-button" type="button" data-vat-cancel>Annulla</button></footer></form></dialog>
 <form method="post" asp-page-handler="Delete" data-vat-delete-form hidden><input name="code" data-vat-delete-code/></form>
 @if(!string.IsNullOrWhiteSpace(Model.Message)){<span hidden data-page-message data-message-text="@Model.Message"></span>}
</section>
@section Scripts{<partial name="_ValidationScriptsPartial"/><script src="~/js/vat-codes-list.js" asp-append-version="true"></script>}
