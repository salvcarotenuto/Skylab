@page
@model SkyLab.Web.Pages.Tabelle.PianoConti.IndexModel
@{ViewData["Title"]="Piano dei conti";ViewData["HideFooter"]=true;static string TypeLabel(string value)=>value switch{"P"=>"Patrimoniale","C"=>"Costo","R"=>"Ricavo",_=>value};static string PartyLabel(string value)=>value switch{"C"=>"Cliente","F"=>"Fornitore","D"=>"Dipendente","B"=>"Banca",_=>""};}
<link rel="stylesheet" href="~/css/accounts.css" asp-append-version="true" />
<section class="account-list-page" data-account-page data-next-code="@Model.NextCode" data-open-editor="@(!ViewData.ModelState.IsValid?"true":"false")">
 <header class="planning-heading account-heading customer-form-header"><div class="module-title-identity"><div class="skylab-header-brand"><img src="~/images/skylab-logo.png" alt="" /></div><div><p class="eyebrow">Tabelle · Contabili</p><h1>Piano dei conti</h1><p>Gestione dei conti collegati ai mastri.</p></div></div><div class="account-title-actions"><span class="account-count-box"><strong data-account-count>@Model.Items.Count</strong> record</span><button class="btn btn-primary" type="button" data-account-new>Nuovo</button><button class="btn customer-menu-button" type="button" data-account-edit disabled>Modifica</button><button class="btn customer-menu-button" type="button" data-account-delete disabled>Elimina</button><a class="btn customer-menu-button" asp-page="/Index">Esci</a></div></header>
 <div class="account-toolbar"><label for="account-search">Cerca</label><div class="account-search-wrap"><input id="account-search" placeholder="Codice, descrizione, mastro o tipo" autocomplete="off" autofocus data-account-search/><button type="button" aria-label="Pulisci filtro" data-account-clear hidden>×</button></div></div>
 <div class="account-grid-frame"><table class="account-grid"><thead><tr><th data-account-sort="code">Codice</th><th data-account-sort="description">Descrizione</th><th data-account-sort="type">Tipo</th><th data-account-sort="master">Mastro</th><th data-account-sort="party">Soggetto</th><th data-account-sort="load">Carico</th><th data-account-sort="locked">Bloccato</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr tabindex="0" data-account-row data-code="@item.Code" data-description="@item.Description" data-type="@item.Type" data-type-label="@TypeLabel(item.Type)" data-master="@item.Master" data-master-description="@item.MasterDescription" data-party="@item.PartyKind" data-party-label="@PartyLabel(item.PartyKind)" data-load="@(item.Load?"1":"0")" data-locked="@(item.Locked?"1":"0")"><td>@item.Code.ToString("000")</td><td>@item.Description</td><td>@TypeLabel(item.Type)</td><td>@item.Master.ToString("000") · @item.MasterDescription</td><td>@PartyLabel(item.PartyKind)</td><td>@(item.Load?"Sì":"")</td><td>@(item.Locked?"Sì":"")</td></tr>}</tbody></table><div class="account-empty" data-account-empty hidden>Nessun conto corrisponde al filtro impostato.</div></div>
 <dialog class="account-editor" data-account-dialog><form method="post" asp-page-handler="Save" data-account-form><div class="account-editor-title"><h2>Conto</h2></div><div class="account-editor-body"><div class="field"><label for="account-code-view">Codice</label><input id="account-code-view" readonly tabindex="-1" data-account-code/><input asp-for="Conto.Code" type="hidden" data-account-code-value/><span asp-validation-for="Conto.Code"></span></div><div class="field"><label asp-for="Conto.Description">Descrizione</label><input asp-for="Conto.Description" autocomplete="off" data-account-description/><span asp-validation-for="Conto.Description"></span></div><div class="field"><label asp-for="Conto.Master">Mastro</label><select asp-for="Conto.Master" required data-account-master><option value="">Seleziona...</option>@foreach(var mastro in Model.Masters){<option value="@mastro.Code" data-type="@mastro.Type">@mastro.Code.ToString("000") · @mastro.Description</option>}</select><span asp-validation-for="Conto.Master"></span></div><div class="field"><label asp-for="Conto.Type">Tipo</label><input readonly tabindex="-1" data-account-type-view/><input asp-for="Conto.Type" type="hidden" data-account-type/><span asp-validation-for="Conto.Type"></span></div><div class="field"><label asp-for="Conto.PartyKind">Soggetto</label><select asp-for="Conto.PartyKind" data-account-party><option value=""></option><option value="C">Cliente</option><option value="F">Fornitore</option><option value="D">Dipendente</option><option value="B">Banca</option></select><span asp-validation-for="Conto.PartyKind"></span></div><div class="field check-field"><label asp-for="Conto.Load">Carico</label><div class="account-check-button-field"><input asp-for="Conto.Load" type="checkbox" data-account-load/><label class="account-check-button-wrap" for="Conto_Load" aria-label="Carico"></label></div><span asp-validation-for="Conto.Load"></span></div><input asp-for="IsNew" type="hidden" data-account-is-new/></div><footer><button class="btn btn-primary" type="submit" data-account-save>Salva</button><button class="btn customer-menu-button" type="button" data-account-cancel>Annulla</button></footer></form></dialog>
 <form method="post" asp-page-handler="Delete" data-account-delete-form hidden><input name="code" data-account-delete-code/></form>
 @if(!string.IsNullOrWhiteSpace(Model.Message)){<span hidden data-page-message data-message-text="@Model.Message"></span>}
</section>
@section Scripts{<partial name="_ValidationScriptsPartial"/><script src="~/js/accounts-list.js" asp-append-version="true"></script>}
