@page
@model SkyLab.Web.Pages.Tabelle.Aspetto.IndexModel
@{ViewData["Title"]="Aspetto beni";ViewData["HideFooter"]=true;}
<link rel="stylesheet" href="~/css/appearances.css" asp-append-version="true" />
<section class="appearance-list-page" data-appearance-page data-open-editor="@(!ViewData.ModelState.IsValid?"true":"false")">
 <header class="planning-heading appearance-heading customer-form-header"><div class="module-title-identity"><div class="skylab-header-brand"><img src="~/images/skylab-logo.png" alt="" /></div><div><p class="eyebrow">Tabelle · Magazzino</p><h1>Aspetto beni</h1><p>Gestione degli aspetti dei beni.</p></div></div><div class="appearance-title-actions"><span class="appearance-count-box"><strong data-appearance-count>@Model.Items.Count</strong> record</span><button class="btn btn-primary" type="button" data-appearance-new>Nuovo</button><button class="btn customer-menu-button" type="button" data-appearance-edit disabled>Modifica</button><button class="btn customer-menu-button" type="button" data-appearance-delete disabled>Elimina</button><a class="btn customer-menu-button" asp-page="/Index">Esci</a></div></header>
 <div class="appearance-toolbar"><label for="appearance-search">Cerca</label><div class="appearance-search-wrap"><input id="appearance-search" placeholder="Codice o descrizione" autocomplete="off" autofocus data-appearance-search/><button type="button" aria-label="Pulisci filtro" data-appearance-clear hidden>×</button></div></div>
 <div class="appearance-grid-frame"><table class="appearance-grid"><thead><tr><th data-appearance-sort="code">Codice</th><th data-appearance-sort="description">Descrizione</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr tabindex="0" data-appearance-row data-code="@item.Id" data-description="@item.Label"><td>@item.Id.ToString("000")</td><td>@item.Label</td></tr>}</tbody></table><div class="appearance-empty" data-appearance-empty hidden>Nessun aspetto beni corrisponde al filtro impostato.</div></div>
 <dialog class="appearance-editor" data-appearance-dialog><form method="post" asp-page-handler="Save" data-appearance-form><div class="appearance-editor-title"><h2>Aspetto beni</h2></div><div class="appearance-editor-body"><div class="field"><label for="appearance-code">Codice</label><input id="appearance-code" value="@(Model.IsNew?"Automatico":Model.Aspetto.Code.ToString("000"))" readonly tabindex="-1" data-appearance-code/><input asp-for="Aspetto.Code" type="hidden" data-appearance-code-value/></div><div class="field"><label asp-for="Aspetto.Description">Descrizione</label><input asp-for="Aspetto.Description" autocomplete="off" data-appearance-description/><span asp-validation-for="Aspetto.Description"></span></div><input asp-for="IsNew" type="hidden" data-appearance-is-new/></div><footer><button class="btn btn-primary" type="submit" data-appearance-save>Salva</button><button class="btn customer-menu-button" type="button" data-appearance-cancel>Annulla</button></footer></form></dialog>
 <form method="post" asp-page-handler="Delete" data-appearance-delete-form hidden><input name="code" data-appearance-delete-code/></form>
 @if(!string.IsNullOrWhiteSpace(Model.Message)){<span hidden data-page-message data-message-text="@Model.Message"></span>}
</section>
@section Scripts{<partial name="_ValidationScriptsPartial"/><script src="~/js/appearances-list.js" asp-append-version="true"></script>}
