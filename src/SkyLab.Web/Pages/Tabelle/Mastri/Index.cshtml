@page
@model SkyLab.Web.Pages.Tabelle.Mastri.IndexModel
@{ViewData["Title"]="Mastri di conto";ViewData["HideFooter"]=true;static string TypeLabel(string value)=>value switch{"P"=>"Patrimoniale","C"=>"Costo","R"=>"Ricavo",_=>value};}
<link rel="stylesheet" href="~/css/account-masters.css" asp-append-version="true" />
<section class="master-list-page" data-master-page data-next-code="@Model.NextCode" data-open-editor="@(!ViewData.ModelState.IsValid?"true":"false")">
 <header class="planning-heading master-heading customer-form-header"><div class="module-title-identity"><div class="skylab-header-brand"><img src="~/images/skylab-logo.png" alt="" /></div><div><p class="eyebrow">Tabelle · Contabili</p><h1>Mastri di conto</h1><p>Gestione dei mastri del piano dei conti.</p></div></div><div class="master-title-actions"><span class="master-count-box"><strong data-master-count>@Model.Items.Count</strong> record</span><button class="btn btn-primary" type="button" data-master-new>Nuovo</button><button class="btn customer-menu-button" type="button" data-master-edit disabled>Modifica</button><button class="btn customer-menu-button" type="button" data-master-delete disabled>Elimina</button><a class="btn customer-menu-button" asp-page="/Index">Esci</a></div></header>
 <div class="master-toolbar"><label for="master-search">Cerca</label><div class="master-search-wrap"><input id="master-search" placeholder="Codice, descrizione o tipo" autocomplete="off" autofocus data-master-search/><button type="button" aria-label="Pulisci filtro" data-master-clear hidden>×</button></div></div>
 <div class="master-grid-frame"><table class="master-grid"><thead><tr><th data-master-sort="code">Codice</th><th data-master-sort="description">Descrizione</th><th data-master-sort="type">Tipo</th><th data-master-sort="locked">Bloccato</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr tabindex="0" data-master-row data-code="@item.Code" data-description="@item.Description" data-type="@item.Type" data-type-label="@TypeLabel(item.Type)" data-locked="@(item.Locked?"1":"0")"><td>@item.Code.ToString("000")</td><td>@item.Description</td><td>@TypeLabel(item.Type)</td><td>@(item.Locked?"Sì":"")</td></tr>}</tbody></table><div class="master-empty" data-master-empty hidden>Nessun mastro corrisponde al filtro impostato.</div></div>
 <dialog class="master-editor" data-master-dialog><form method="post" asp-page-handler="Save" data-master-form><div class="master-editor-title"><h2>Mastro di conto</h2></div><div class="master-editor-body"><div class="field"><label for="master-code-view">Codice</label><input id="master-code-view" readonly tabindex="-1" data-master-code/><input asp-for="Mastro.Code" type="hidden" data-master-code-value/><span asp-validation-for="Mastro.Code"></span></div><div class="field"><label asp-for="Mastro.Description">Descrizione</label><input asp-for="Mastro.Description" autocomplete="off" data-master-description/><span asp-validation-for="Mastro.Description"></span></div><div class="field"><label asp-for="Mastro.Type">Tipo</label><select asp-for="Mastro.Type" required data-master-type><option value="">Seleziona...</option><option value="P">Patrimoniale</option><option value="C">Costo</option><option value="R">Ricavo</option></select><span asp-validation-for="Mastro.Type"></span></div><input asp-for="IsNew" type="hidden" data-master-is-new/></div><footer><button class="btn btn-primary" type="submit" data-master-save>Salva</button><button class="btn customer-menu-button" type="button" data-master-cancel>Annulla</button></footer></form></dialog>
 <form method="post" asp-page-handler="Delete" data-master-delete-form hidden><input name="code" data-master-delete-code/></form>
 @if(!string.IsNullOrWhiteSpace(Model.Message)){<span hidden data-page-message data-message-text="@Model.Message"></span>}
</section>
@section Scripts{<partial name="_ValidationScriptsPartial"/><script src="~/js/account-masters-list.js" asp-append-version="true"></script>}
