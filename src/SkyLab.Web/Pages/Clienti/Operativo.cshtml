@page
@model SkyLab.Web.Pages.Clienti.OperativoModel
@{ViewData["Title"]="Fascicolo operativo · "+Model.Cliente;ViewData["HideFooter"]=true;}
<section class="operational-record-page">
<header class="module-header customer-form-header operational-record-header">
    <div class="module-title-identity">
        <a class="skylab-header-brand" asp-page="Index" aria-label="Torna all'elenco clienti"><img src="~/images/skylab-logo.png" alt="SkyLab" /></a>
        <div><p class="eyebrow">Fascicolo cliente</p><h1>@Model.Cliente</h1><p>Codice cliente @Model.ClienteId.ToString("00000")</p></div>
    </div>
    <div class="customer-form-toolbar"><a class="btn btn-primary new-installation-button" asp-page="/Lavori/Macchina" asp-route-clienteId="@Model.ClienteId" asp-route-origine="operativo">Nuova installazione</a><a class="btn customer-menu-button" asp-page="Index">Esci</a></div>
</header>
<section class="operational-metrics"><div><span>Installato</span><strong>@Model.Totale</strong><small>macchine e impianti</small></div><div class="metric-alert"><span>Scadute</span><strong>@Model.Scadute</strong><small>da pianificare</small></div><div><span>Senza scadenza</span><strong>@Model.SenzaScadenza</strong><small>da verificare</small></div><div><span>Valore installato</span><strong>@Model.Valore.ToString("N2")</strong><small>valore storico</small></div></section>
<div class="operational-sites">@if(Model.Totale==0){<div class="empty-panel"><h2>Nessuna macchina installata</h2><p>Il fascicolo operativo è pronto per la prima installazione.</p></div>}@foreach(var sede in Model.Sedi){<section class="operational-site"><header><div class="operational-site-heading"><span class="eyebrow">@(sede.SiteId is null?"Sede principale":"Sede aggiuntiva")</span>@if(!string.IsNullOrWhiteSpace(sede.Name)){<h2>@sede.Name</h2>}@if(!string.IsNullOrWhiteSpace(sede.Address)){<p>@sede.Address</p>}</div><span class="status">@sede.Machines.Count installazioni</span></header><div class="operational-machines">@foreach(var m in sede.Machines){var overdue=m.NextServiceOn<DateTime.Today;<article><div><span>@m.Category</span><h3>@(string.IsNullOrWhiteSpace(m.Description)?m.ArticleCode:m.Description)</h3><small>@m.ArticleCode</small></div><div><span>Installazione</span><strong>@(m.InstalledOn?.ToString("dd/MM/yyyy")??"—")</strong></div><div><span>Prossimo intervento</span><strong class="@(overdue?"text-danger":"")">@(m.NextServiceOn?.ToString("dd/MM/yyyy")??"Da definire")</strong></div><div class="operational-row-actions"><a class="btn customer-menu-button" asp-page="/Lavori/Macchina" asp-route-id="@m.Id" asp-route-origine="operativo">Apri</a><a class="btn customer-menu-button" asp-page="/Magazzino/Articolo" asp-route-codice="@m.ArticleCode" asp-route-clienteId="@Model.ClienteId" asp-route-azione="101">Scheda articolo</a></div></article>}</div></section>}</div>
</section>
