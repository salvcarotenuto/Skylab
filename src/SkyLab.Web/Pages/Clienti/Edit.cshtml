@page
@model SkyLab.Web.Pages.Clienti.EditModel
@{ViewData["Title"]=Model.Cliente.Code==0?"Nuovo cliente":Model.Cliente.Name;}
<nav class="module-nav mb-3"><a class="module-home" asp-page="Index">← Elenco clienti</a><span>Anagrafica cliente</span></nav>
<header class="planning-heading"><div><p class="eyebrow">Dati stabili</p><h1>@(Model.Cliente.Code==0?"Nuovo cliente":Model.Cliente.Name)</h1></div>@if(Model.Cliente.Code>0){<div class="header-actions"><a class="btn btn-outline-primary" asp-page="Sedi/Index" asp-route-clienteId="@Model.Cliente.Code">Sedi aggiuntive</a><a class="btn btn-primary" asp-page="Operativo" asp-route-id="@Model.Cliente.Code">Fascicolo operativo</a></div>}</header>
@if(TempData["Message"] is string msg){<div class="alert alert-success">@msg</div>}
<form method="post" class="edit-form"><input asp-for="Cliente.Code" type="hidden"/><section><h2>Identificazione</h2><div class="form-grid"><label class="span-2">Denominazione<input asp-for="Cliente.Name" class="form-control"/><span asp-validation-for="Cliente.Name"></span></label><label>Codice fiscale<input asp-for="Cliente.TaxCode" class="form-control"/></label><label>Partita IVA<input asp-for="Cliente.VatNumber" class="form-control"/></label><label>Codice SDI<input asp-for="Cliente.SdiCode" class="form-control"/></label><label class="check-field"><input asp-for="Cliente.Active"/> Cliente attivo</label></div></section><section><h2>Indirizzo principale</h2><div class="form-grid"><label class="span-2">Via<input asp-for="Cliente.Street" class="form-control"/></label><label>Civico<input asp-for="Cliente.StreetNumber" class="form-control"/></label><label>CAP<input asp-for="Cliente.PostalCode" class="form-control"/></label><label>Città<input asp-for="Cliente.City" class="form-control"/></label><label>Provincia<input asp-for="Cliente.Province" class="form-control"/></label></div></section><section><h2>Contatti</h2><div class="form-grid"><label>Referente<input asp-for="Cliente.Contact" class="form-control"/></label><label>Telefono<input asp-for="Cliente.Phone1" class="form-control"/></label><label>Altro telefono<input asp-for="Cliente.Phone2" class="form-control"/></label><label>Email<input asp-for="Cliente.Email" class="form-control"/></label><label>PEC<input asp-for="Cliente.CertifiedEmail" class="form-control"/></label><label class="span-2">Note anagrafiche<textarea asp-for="Cliente.Notes" class="form-control"></textarea></label></div></section><div class="form-actions"><a class="btn btn-light" asp-page="Index">Annulla</a><button class="btn btn-primary">Salva anagrafica</button></div></form>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
