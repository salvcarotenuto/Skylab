@page
@model SkyLab.Web.Pages.Clienti.EditModel
@{
    var isNew = Model.Cliente.Code == 0;
    ViewData["Title"] = isNew ? "Nuovo cliente" : Model.Cliente.Name;
    if(Model.Modal){ViewData["BodyClass"]="customer-modal-body";ViewData["HideFooter"]=true;}
    var validationMessage = ViewData.ModelState.Values
        .SelectMany(value => value.Errors)
        .Select(error => error.ErrorMessage)
        .FirstOrDefault(message => !string.IsNullOrWhiteSpace(message));
}
@if(Model.Modal){<style>html,body.customer-modal-body{min-height:0!important}body.customer-modal-body{overflow:auto}body.customer-modal-body>.page-container{margin:0!important;max-width:none!important;padding:10px!important}body.customer-modal-body main{padding:0!important}body.customer-modal-body .customer-form-page{gap:10px;padding:0!important}</style>}

<section class="module-page customer-form-page data-form-skin">
    <header class="module-header customer-form-header">
        <div class="module-title-identity">
            <a class="skylab-header-brand" asp-page="Index" aria-label="Torna all'elenco clienti">
                <img src="~/images/skylab-logo.png" alt="SkyLab" />
            </a>
            <div>
                <p class="eyebrow">Anagrafica cliente</p>
                <h1>@(isNew ? "Nuovo cliente" : Model.Cliente.Name)</h1>
                <p>@(isNew ? "Inserimento di una nuova anagrafica" : $"Codice cliente {Model.Cliente.Code:00000}")</p>
            </div>
        </div>
        <div class="customer-form-toolbar">
            <button class="btn btn-primary" type="submit" form="customer-form">Salva</button>
            @if(Model.Modal){<button class="btn customer-menu-button" type="button" onclick="parent.postMessage({type:'skylab-customer-cancel'},location.origin)">Esci</button>}else{<a class="btn customer-menu-button" asp-page="Index">Esci</a>}
        </div>
    </header>

    <form id="customer-form" method="post" class="entity-form customer-entity-form" autocomplete="off" data-form-type="other">
        <input asp-for="Modal" type="hidden" />
        <input asp-for="Cliente.Code" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="validation-summary text-danger"></div>

        <fieldset class="form-frame compact-frame">
            <legend>Identificazione</legend>
            <div class="form-grid form-grid-4 form-frame-grid">
                <div class="field field-code">
                    <label>Codice</label>
                    <input class="code-display readonly-field" value="@(isNew ? "Automatico" : Model.Cliente.Code.ToString("00000"))" readonly tabindex="-1" />
                </div>
                <div class="field field-span-2">
                    <label asp-for="Cliente.Name">Denominazione</label>
                    <input asp-for="Cliente.Name" autocomplete="off" autofocus />
                    <span asp-validation-for="Cliente.Name"></span>
                </div>
                <div class="field field-check">
                    <div class="check-button-field">
                        <input asp-for="Cliente.Active" />
                        <label class="check-text" asp-for="Cliente.Active">Cliente attivo</label>
                        <label class="check-button-wrap" for="Cliente_Active" aria-label="Attiva o disattiva il cliente"></label>
                    </div>
                </div>
                <div class="field">
                    <label asp-for="Cliente.TaxCode">Codice fiscale</label>
                    <input asp-for="Cliente.TaxCode" class="text-uppercase" autocomplete="off" />
                </div>
                <div class="field">
                    <label asp-for="Cliente.VatNumber">Partita IVA</label>
                    <input asp-for="Cliente.VatNumber" inputmode="numeric" autocomplete="off" />
                </div>
                <div class="field">
                    <label asp-for="Cliente.SdiCode">Codice SDI</label>
                    <input asp-for="Cliente.SdiCode" class="text-uppercase" autocomplete="off" />
                </div>
            </div>
        </fieldset>

        <fieldset class="form-frame compact-frame">
            <legend>Indirizzo principale</legend>
            <div class="form-grid form-grid-4 form-frame-grid">
                <div class="field field-span-2">
                    <label asp-for="Cliente.Street">Via / Piazza</label>
                    <input asp-for="Cliente.Street" autocomplete="off" />
                </div>
                <div class="field"><label asp-for="Cliente.StreetNumber">Civico</label><input asp-for="Cliente.StreetNumber" autocomplete="off" /></div>
                <div class="field"><label asp-for="Cliente.PostalCode">CAP</label><input asp-for="Cliente.PostalCode" inputmode="numeric" autocomplete="off" /></div>
                <div class="field field-span-2"><label asp-for="Cliente.City">Città</label><input asp-for="Cliente.City" autocomplete="off" /></div>
                <div class="field"><label asp-for="Cliente.Province">Provincia</label><input asp-for="Cliente.Province" class="province-field text-uppercase" maxlength="2" autocomplete="off" /></div>
            </div>
        </fieldset>

        <fieldset class="form-frame compact-frame">
            <legend>Contatti</legend>
            <div class="form-grid form-grid-4 form-frame-grid">
                <div class="field field-span-2"><label asp-for="Cliente.Contact">Referente</label><input asp-for="Cliente.Contact" autocomplete="off" /></div>
                <div class="field"><label asp-for="Cliente.Phone1">Telefono</label><input asp-for="Cliente.Phone1" type="tel" inputmode="tel" autocomplete="off" /></div>
                <div class="field"><label asp-for="Cliente.Phone2">Altro telefono</label><input asp-for="Cliente.Phone2" type="tel" inputmode="tel" /></div>
                <div class="field field-span-2"><label asp-for="Cliente.Email">Email</label><input asp-for="Cliente.Email" type="email" inputmode="email" autocomplete="off" /></div>
                <div class="field field-span-2"><label asp-for="Cliente.CertifiedEmail">PEC</label><input asp-for="Cliente.CertifiedEmail" type="email" inputmode="email" autocomplete="off" /></div>
                <div class="field field-span-4"><label asp-for="Cliente.Notes">Note anagrafiche</label><textarea asp-for="Cliente.Notes" rows="3"></textarea></div>
            </div>
        </fieldset>

    </form>
</section>
@if(Model.Modal){<script>document.addEventListener("DOMContentLoaded",()=>{const report=()=>parent.postMessage({type:"skylab-customer-size",height:document.documentElement.scrollHeight},location.origin);new ResizeObserver(report).observe(document.querySelector(".customer-form-page"));report()});</script>}

@if (!string.IsNullOrWhiteSpace(validationMessage))
{
    <div class="messagebox-overlay messagebox-error active" data-skylab-messagebox aria-hidden="false">
        <div class="messagebox" role="alertdialog" aria-modal="true" aria-labelledby="messagebox-title" aria-describedby="messagebox-body">
            <div class="messagebox-title" id="messagebox-title">SkyLab - attenzione</div>
            <div class="messagebox-body" id="messagebox-body">
                <div class="messagebox-message">@validationMessage</div>
                <div class="messagebox-detail" hidden></div>
            </div>
            <div class="messagebox-actions">
                <button class="btn btn-primary messagebox-ok" type="button"
                        onclick="this.closest('.messagebox-overlay').classList.remove('active'); this.closest('.messagebox-overlay').setAttribute('aria-hidden','true'); document.getElementById('Cliente_Name')?.focus();">
                    OK
                </button>
                <button class="btn btn-outline-secondary messagebox-cancel" type="button" hidden>Annulla</button>
            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/customer-edit.js" asp-append-version="true"></script>
}
