@page
@model SkyLab.Web.Pages.Clienti.Sedi.IndexModel
@{ViewData["Title"]="Sedi di "+Model.Cliente;}
<header class="planning-heading customer-list-heading"><div><p class="eyebrow">Sedi aggiuntive · Cliente #@Model.ClienteId</p><h1>@Model.Cliente</h1><p>Sedi operative diverse dall’indirizzo principale.</p></div><div class="customer-list-heading-actions"><a class="btn btn-primary new-site-button" asp-page="Edit" asp-route-clienteId="@Model.ClienteId">Nuova sede</a><a class="btn customer-menu-button" asp-page="../Index">Esci</a></div></header><div class="site-list">@foreach(var s in Model.Items){<article class="site-card"><div><span class="status">Sede @s.Code</span><h2>@s.Name</h2><p>@s.Street · @s.City @s.Province</p></div><div><span>Referente</span><strong>@s.Contact</strong></div><a class="btn btn-outline-primary" asp-page="Edit" asp-route-id="@s.Id">Modifica</a></article>}</div>
