@page
@model SkyLab.Web.Pages.Clienti.Sedi.EditModel
@{ViewData["Title"]=Model.Sede.Id==0?"Nuova sede":"Modifica sede";}
<nav class="module-nav mb-3"><a class="module-home" asp-page="Index" asp-route-clienteId="@Model.Sede.CustomerId">← Sedi di @Model.Cliente</a><span>Sede aggiuntiva</span></nav><header class="planning-heading"><div><p class="eyebrow">@Model.Cliente</p><h1>@(Model.Sede.Id==0?"Nuova sede":"Modifica sede")</h1></div></header><form method="post" class="edit-form"><input asp-for="Sede.Id" type="hidden"/><input asp-for="Sede.CustomerId" type="hidden"/><input asp-for="Sede.Code" type="hidden"/><section><h2>Indirizzo e identificazione</h2><div class="form-grid"><label class="span-2">Nome della sede<input asp-for="Sede.Name" class="form-control"/></label><label class="span-2">Via<input asp-for="Sede.Street" class="form-control"/></label><label>Civico<input asp-for="Sede.StreetNumber" class="form-control"/></label><label>CAP<input asp-for="Sede.PostalCode" class="form-control"/></label><label>Città<input asp-for="Sede.City" class="form-control"/></label><label>Provincia<input asp-for="Sede.Province" class="form-control"/></label><label class="check-field"><input asp-for="Sede.Active"/> Sede attiva</label></div></section><section><h2>Referente operativo</h2><div class="form-grid"><label>Referente<input asp-for="Sede.Contact" class="form-control"/></label><label>Telefono<input asp-for="Sede.ContactPhone" class="form-control"/></label><label>Email<input asp-for="Sede.ContactEmail" class="form-control"/></label><label class="span-2">Note<textarea asp-for="Sede.Notes" class="form-control"></textarea></label></div></section><div class="form-actions"><a class="btn btn-light" asp-page="Index" asp-route-clienteId="@Model.Sede.CustomerId">Annulla</a><button class="btn btn-primary">Salva sede</button></div></form>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
