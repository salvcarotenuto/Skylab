@page
@model SkyLab.Web.Pages.Clienti.Sedi.EditModel
@{ViewData["Title"]=Model.Sede.Id==0?"Nuova sede":"Modifica sede";ViewData["HideFooter"]=true;}
<section class="module-page customer-form-page data-form-skin">
    <header class="module-header customer-form-header">
        <div class="module-title-identity"><a class="skylab-header-brand" asp-page="Index" asp-route-clienteId="@Model.Sede.CustomerId" aria-label="Torna alle sedi"><img src="~/images/skylab-logo.png" alt="SkyLab" /></a><div><p class="eyebrow">Sede aggiuntiva</p><h1>@(Model.Sede.Id==0?"Nuova sede":"Modifica sede")</h1><p>@Model.Cliente</p></div></div>
        <div class="customer-form-toolbar"><button class="btn btn-primary" type="submit" form="site-form">Salva</button><a class="btn customer-menu-button" asp-page="Index" asp-route-clienteId="@Model.Sede.CustomerId">Esci</a></div>
    </header>
    <form id="site-form" method="post" class="entity-form customer-entity-form" data-enter-navigation>
        <input asp-for="Sede.Id" type="hidden"/><input asp-for="Sede.CustomerId" type="hidden"/><input asp-for="Sede.Code" type="hidden"/>
        <div asp-validation-summary="All" class="text-danger"></div>
        <fieldset class="form-frame"><legend>Identificazione e indirizzo</legend><div class="form-grid form-grid-4">
            <div class="field field-span-2"><label asp-for="Sede.Name">Nome sede</label><input asp-for="Sede.Name"/></div>
            <div class="field field-check"><div class="check-button-field"><input asp-for="Sede.Active"/><label class="check-text" asp-for="Sede.Active">Sede attiva</label><label class="check-button-wrap" for="Sede_Active" aria-label="Attiva o disattiva la sede"></label></div></div>
            <div class="field field-span-2"><label asp-for="Sede.Street">Indirizzo</label><input asp-for="Sede.Street"/></div>
            <div class="field"><label asp-for="Sede.StreetNumber">Civico</label><input asp-for="Sede.StreetNumber"/></div>
            <div class="field field-span-2 customer-city-field"><label asp-for="Sede.City">Città</label><input asp-for="Sede.City" autocomplete="off" aria-autocomplete="list" aria-controls="site-city-suggestions"/><div id="site-city-suggestions" class="customer-city-suggestions" role="listbox" hidden></div></div>
            <div class="field"><label asp-for="Sede.PostalCode">CAP</label><input asp-for="Sede.PostalCode" inputmode="numeric"/></div>
            <div class="field"><label asp-for="Sede.Province">Provincia</label><input asp-for="Sede.Province" maxlength="2"/></div>
        </div></fieldset>
        <fieldset class="form-frame"><legend>Referente operativo</legend><div class="form-grid form-grid-4">
            <div class="field field-span-2"><label asp-for="Sede.Contact">Referente</label><input asp-for="Sede.Contact"/></div>
            <div class="field"><label asp-for="Sede.ContactPhone">Telefono</label><input asp-for="Sede.ContactPhone"/></div>
            <div class="field"><label asp-for="Sede.ContactEmail">Email</label><input asp-for="Sede.ContactEmail"/></div>
            <div class="field field-span-4 site-notes-field"><label asp-for="Sede.Notes">Note</label><textarea asp-for="Sede.Notes"></textarea></div>
        </div></fieldset>
    </form>
</section>
@section Scripts{<partial name="_ValidationScriptsPartial"/><script src="~/js/form-enter-navigation.js" asp-append-version="true"></script><script src="~/js/site-edit.js" asp-append-version="true"></script>}
